/// discharge free_list_locate_first_fit.inv_preserved.sable_allocatorview_storedchain_state_li by
///   obtain ⟨node, storedSize, storedNext, hstored, hfields,
///       hextent, hclear, hfit, horder, hbound, tail⟩ :=
///     Sable.AllocatorView.StoredChain.step
///       h_inv_sable_allocatorview_stor h_path_current_limit
///   have hnode : _header7 = node := by
///     rw [h_header7_step,
///       Sable.AllocatorView.storesHeader_headerAt hstored]
///   unfold Sable.FreeHeaderView.hasFields at hfields
///   rw [hnode, hfields.2] at h_value9_header_next
///   have hnext : storedNext = _value9 := by
///     injection h_value9_header_next
///   have hrestore : state_2 = _old_state := by
///     rw [h_state_put_header, h_state_step_header, h_header7_step]
///     exact Sable.AllocatorView.StoredChain.extract_restore
///       h_inv_sable_allocatorview_stor h_path_current_limit
///   rw [hrestore, ← hnext]
///   exact tail

/// discharge free_list_locate_first_fit.inv_preserved.sable_allocatorview_rejectedpath_old_sta by
///   obtain ⟨node, storedSize, storedNext, hstored, hfields,
///       hextent, hclear, hfit, horder, hbound, tail⟩ :=
///     Sable.AllocatorView.StoredChain.step
///       h_inv_sable_allocatorview_stor h_path_current_limit
///   have hnode : _header7 = node := by
///     rw [h_header7_step,
///       Sable.AllocatorView.storesHeader_headerAt hstored]
///   unfold Sable.FreeHeaderView.hasFields at hfields
///   rw [hnode, hfields.1] at h_value8_header_size
///   rw [hnode, hfields.2] at h_value9_header_next
///   have hsize : storedSize = _value8 := by
///     injection h_value8_header_size
///   have hnext : storedNext = _value9 := by
///     injection h_value9_header_next
///   rw [← hnext]
///   exact Sable.AllocatorView.RejectedPath.step
///     h_inv_sable_allocatorview_reje h_path_current_limit
///       hstored hfields (by omega)

/// discharge free_list_locate_first_fit.variant_decreases.limit_current by
///   obtain ⟨node, storedSize, storedNext, hstored, hfields,
///       hextent, hclear, hfit, horder, hbound, tail⟩ :=
///     Sable.AllocatorView.StoredChain.step
///       h_inv_sable_allocatorview_stor h_path_current_limit
///   have hnode : _header7 = node := by
///     rw [h_header7_step,
///       Sable.AllocatorView.storesHeader_headerAt hstored]
///   unfold Sable.FreeHeaderView.hasFields at hfields
///   rw [hnode, hfields.2] at h_value9_header_next
///   injection h_value9_header_next
///   simp [Sable.freeHeaderBytes, Sable.u64.layout] at hfit
///   rw [h_variant_limit_current]
///   omega

/// discharge free_list_locate_first_fit.post.location.2 by
///   have hcurrent : current = limit := by omega
///   rw [h_result,
///     h_FreeListLocation_make_post_self_previous_previous_s.1,
///     h_FreeListLocation_make_post_self_previous_previous_s.2.1,
///     h_FreeListLocation_make_post_self_previous_previous_s.2.2.1,
///     h_FreeListLocation_make_post_self_previous_previous_s.2.2.2]
///   exact Sable.AllocatorView.FirstFitLocation.notFound h_pre_chain
///     (by simpa [hcurrent] using h_inv_sable_allocatorview_reje)

/// discharge free_list_first_fit.post.first by
///   rw [h_result]
///   exact Sable.AllocatorView.FirstFitLocation.toFirstFit
///     h_free_list_locate_first_fit_post_location
