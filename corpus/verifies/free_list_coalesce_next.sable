///       Sable.FreeBlockView.toHeader,
///       Sable.FreeBlockView.join,
///       Sable.BlockLeaseView.toFree, h_pre_key]
///   have horiginal : state_2.canPutHeader _header12 := by
///     rw [h_state_take_header_2, h_header12_take]
///     exact Sable.AllocatorView.takeHeader_canPutHeader
///       state previous h_fact_sable_allocatorview_cant
///   have hne : previous ≠ merged.key := by
///     rw [hmergedKey]
///     omega
///   rw [h_state_put_header]
///   unfold Sable.AllocatorView.canPutHeader at horiginal ⊢
///   refine ⟨?_, h_predecessor_wf_2, ?_, ?_⟩
///   · simpa [h_predecessor_init, h_predecessor_clear,
