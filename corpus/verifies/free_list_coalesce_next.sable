// U8g3 successor-only coalescing inside a sorted free list. The returned
// extent ends exactly at the stored successor and is strictly separated from
// its predecessor. The successor is absorbed at the returned key, then the
// predecessor is rebuilt to point at that replacement header.

use free_list_insert_after;

/// pre  #[label(base)] base.alloc = state.root.alloc ∧ base.off = 0
/// pre  #[label(limit)] limit = state.root.len
/// pre  #[label(chain)]
///        Sable.AllocatorView.StoredChain state limit head
/// pre  #[label(returnable)] state.returnable lease
/// pre  #[label(key)] lease.key = key
/// pre  #[label(size)] lease.span.len = size
/// pre  #[label(header)] Sable.freeHeaderBytes ≤ size ∧
///        key % u64.layout.align = 0
/// pre  #[label(location)] Sable.AllocatorView.InsertionLocation
///        state limit head key size previous current
/// pre  #[label(interior)] current != head
/// pre  #[label(successor)] current != limit
/// pre  #[label(adjacent)] key + size = current
/// pre  #[label(separated)] ∃ predecessor previousSize,
///        state.storesHeader previous predecessor ∧
///        predecessor.hasFields previousSize current ∧
///        previous + previousSize < key
/// post #[label(chain)]
///        Sable.AllocatorView.StoredChain state limit head
pub fn free_list_coalesce_next(raw<u8> base,
                               resource &mut AllocatorState state,
                               u64 limit, u64 head,
                               u64 key, u64 size,
                               u64 previous, u64 current,
                               resource BlockLease lease) {
    resource FreeBlock left = block_lease_free(lease);

    mut resource FreeHeader successor =
        allocator_take_header(&mut state, current);
    mut u64 successor_size = 0;
    mut u64 next = 0;
    unsafe {
        raw<u8> successor_ptr = raw_offset(base, current);
        successor_size = raw_header_size(successor_ptr, &successor);
        next = raw_header_next(successor_ptr, &successor);
        raw_header_clear(successor_ptr, &mut successor);
        resource FreeBlock right =
            raw_from_free_header(successor_ptr, successor);
    }
    resource FreeBlock joined = free_block_join(left, right);
    u64 joined_size = size + successor_size;
    unsafe {
        raw<u8> joined_ptr = raw_offset(base, key);
        mut resource FreeHeader merged =
            raw_into_free_header(joined_ptr, joined);
        raw_header_init(joined_ptr, joined_size, next, &mut merged);
    }

    mut resource FreeHeader predecessor =
        allocator_take_header(&mut state, previous);
    mut u64 previous_size = 0;
    unsafe {
        raw<u8> predecessor_ptr = raw_offset(base, previous);
        previous_size = raw_header_size(predecessor_ptr, &predecessor);
        raw_header_clear(predecessor_ptr, &mut predecessor);
        raw_header_init(
            predecessor_ptr, previous_size, key, &mut predecessor);
    }

    allocator_put_header(&mut state, merged);
    allocator_put_header(&mut state, predecessor);
}

