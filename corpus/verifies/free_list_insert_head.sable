// U8g1 lease return at the front of a sorted free list. Allocation supplies a
// returnable exact extent; insertion materializes its in-band header and makes
// it the ordinary runtime head without coalescing yet.

use free_list_remove_head;

/// pre  #[label(base)] base.alloc = state.root.alloc ∧ base.off = 0
/// pre  #[label(limit)] list.limit = state.root.len
/// pre  #[label(chain)]
///        Sable.AllocatorView.StoredChain state list.limit list.head
/// pre  #[label(returnable)] state.returnable lease
/// pre  #[label(key)] lease.key = key
/// pre  #[label(size)] lease.span.len = size
/// pre  #[label(header)] Sable.freeHeaderBytes ≤ size ∧
///        key % u64.layout.align = 0
/// pre  #[label(before)] key + size ≤ list.head
/// post #[label(limit_frame)] list.limit = (old list).limit
/// post #[label(head)] list.head = key
/// post #[label(chain)]
///        Sable.AllocatorView.StoredChain state list.limit list.head
pub fn free_list_insert_head(raw<u8> base,
                             &mut FreeListState list,
                             resource &mut AllocatorState state,
                             u64 key, u64 size,
                             resource BlockLease lease) {
    resource FreeBlock block = block_lease_free(lease);
    unsafe {
        raw<u8> block_ptr = raw_offset(base, key);
        mut resource FreeHeader header =
            raw_into_free_header(block_ptr, block);
        raw_header_init(block_ptr, size, list.head, &mut header);
    }
    allocator_put_header(&mut state, header);
    list.advance(key);
}

/// discharge free_list_insert_head.block_lease_free by
///   exact ⟨h_pre_returnable.2.1,
///     h_pre_returnable.2.2.1⟩

/// discharge free_list_insert_head.free_header.from_block by
///   rw [h_free1_free]
///   constructor
///   · calc
///       (Sable.RawPtr.add base key).alloc = base.alloc := rfl
///       _ = _old_state.root.alloc := h_pre_base.1
///       _ = lease.span.alloc := h_pre_returnable.2.2.2.1.symm
///   constructor
///   · calc
///       (Sable.RawPtr.add base key).off = base.off + key := rfl
///       _ = key := by rw [h_pre_base.2]; omega
///       _ = lease.key := h_pre_key.symm
///       _ = lease.span.off := h_pre_returnable.2.1
///   constructor
///   · rw [Sable.RawPtr.add_off, h_pre_base.2]
///     omega
///   constructor
///   · simpa [Sable.RawPtr.add_off, h_pre_base.2] using
///       h_pre_header.2
///   · simpa [Sable.BlockLeaseView.toFree, h_pre_size] using
///       h_pre_header.1

/// discharge free_list_insert_head.free_header.init by
///   rw [h_header2_header]
///   simp [Sable.FreeBlockView.toHeader, Sable.PointsToView.names,
///     h_fact_sable_rawptr_add_base_ke, Sable.freeHeaderBytes,
///     Sable.u64.layout]
///   refine ⟨⟨h_fact_sable_rawptr_add_base_ke.1,
///       h_fact_sable_rawptr_add_base_ke.2.1⟩,
///     h_fact_sable_rawptr_add_base_ke.1.symm,
///     h_fact_sable_rawptr_add_base_ke.2.1.symm, ?_⟩
///   rw [h_free1_free]
///   simp [Sable.BlockLeaseView.toFree, Sable.freeHeaderBytes,
///     Sable.u64.layout] at h_fact_sable_rawptr_add_base_ke ⊢
///   rw [h_pre_size]
///   simp [Sable.freeHeaderBytes, Sable.u64.layout] at h_pre_header
///   omega

/// discharge free_list_insert_head.allocator_put_header by
///   apply Sable.AllocatorView.returnable_canPutHeader
///     h_pre_returnable
///   · simp [h_header_init, h_header2_header, h_free1_free,
///       Sable.FreeHeaderView.putFields,
///       Sable.FreeBlockView.toHeader,
///       Sable.BlockLeaseView.toFree]
///   · exact h_header_wf
///   · simp [h_header_init, h_header2_header, h_free1_free,
///       Sable.FreeHeaderView.putFields,
///       Sable.FreeBlockView.toHeader,
///       Sable.BlockLeaseView.toFree]

/// discharge free_list_insert_head.post.chain by
///   have hkey : header.key = key := by
///     simp [h_header_init, h_header2_header, h_free1_free,
///       Sable.FreeHeaderView.putFields,
///       Sable.FreeBlockView.toHeader,
///       Sable.BlockLeaseView.toFree, h_pre_key]
///   have hfields : header.hasFields size _old_list.head := by
///     simp [h_header_init, Sable.FreeHeaderView.hasFields,
///       Sable.FreeHeaderView.putFields]
///   have hextent : header.toFree.span.len = size := by
///     rw [h_header_init, h_header2_header,
///       Sable.FreeBlockView.toHeader_putFields_toFree_span_len,
///       h_free1_free]
///     exact h_pre_size
///   have hclear : _old_state.clearInterior header.key size := by
///     rw [hkey]
///     exact Sable.AllocatorView.returnable_clearInterior
///       h_pre_returnable h_pre_key h_pre_size
///   have hroot : header.sizeCell.alloc = _old_state.root.alloc := by
///     rw [h_header_init, h_header2_header, h_free1_free]
///     simpa [Sable.FreeHeaderView.putFields,
///       Sable.FreeBlockView.toHeader,
///       Sable.BlockLeaseView.toFree] using
///       h_pre_returnable.2.2.2.1
///   rw [h_state_put_header,
///     h_FreeListState_advance_post_self_head_next_self_limi.1,
///     h_FreeListState_advance_post_self_head_next_self_limi.2,
///     ← hkey]
///   apply Sable.AllocatorView.StoredChain.prependAfterPut
///     h_pre_chain h_fact_sable_allocatorview_canp hfields
///     hextent hclear hroot
///   · rw [hkey]
///     exact h_key_range.1
///   · exact h_pre_header.1
///   · rw [hkey]
///     exact h_pre_before
///   · exact h_cinv_head_limit
