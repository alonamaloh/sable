// U8f5 non-head removal. The selected header is consumed first; its runtime
// predecessor is then read, cleared, and rebuilt over the same exact extent
// with a link to the selected node's successor.

/// pre  #[label(base)] base.alloc = state.root.alloc ∧ base.off = 0
/// pre  #[label(limit)] limit = state.root.len
/// pre  #[label(location)] Sable.AllocatorView.FirstFitLocation
///        state limit head need previous current size next
/// pre  #[label(found)] current != limit
/// pre  #[label(interior)] current != head
/// post #[label(chain)]
///        Sable.AllocatorView.StoredChain state limit head
/// post #[label(removed)] result.key = current ∧ result.span.len = size
/// post #[label(owner)] result.allocator = state.allocator
/// post #[label(root)] result.span.alloc = state.root.alloc
pub fn free_list_remove_after(raw<u8> base,
                              resource &mut AllocatorState state,
                              u64 limit, u64 head, u64 need,
                              u64 previous, u64 current,
                              u64 size, u64 next)
                              -> resource FreeBlock {
    mut resource FreeHeader selected =
        allocator_take_header(&mut state, current);
    unsafe {
        raw<u8> selected_ptr = raw_offset(base, current);
        raw_header_clear(selected_ptr, &mut selected);
        resource FreeBlock block =
            raw_from_free_header(selected_ptr, selected);
    }

    mut resource FreeHeader predecessor =
        allocator_take_header(&mut state, previous);
    mut u64 previous_size = 0;
    unsafe {
        raw<u8> predecessor_ptr = raw_offset(base, previous);
        previous_size = raw_header_size(predecessor_ptr, &predecessor);
        raw_header_clear(predecessor_ptr, &mut predecessor);
        raw_header_init(
            predecessor_ptr, previous_size, next, &mut predecessor);
    }
    allocator_put_header(&mut state, predecessor);
    return block;
}

/// discharge free_list_remove_after.allocator_take_header.current by
///   obtain ⟨header, hstored, hfields, hfit⟩ :=
///     h_pre_location.foundData (by simpa using h_pre_found)
///   exact Sable.AllocatorView.storesHeader_canTake hstored

/// discharge free_list_remove_after.free_header.clear by
///   obtain ⟨header, hstored, hfields, hfit⟩ :=
///     h_pre_location.foundData (by simpa using h_pre_found)
///   have hnode : _header2 = header := by
///     rw [h_header2_take,
///       Sable.AllocatorView.storesHeader_headerAt hstored]
///   have hwf := hstored.2.2.2.1
///   unfold Sable.FreeHeaderView.wf at hwf
///   obtain ⟨hsizewf, _, hkeyoff, halloc, _, hoff, _, _⟩ := hwf
///   have hlayout : header.sizeCell.layout = Sable.u64.layout :=
///     hsizewf.1
///   rw [hnode]
///   constructor
///   · unfold Sable.PointsToView.names
///     constructor
///     · calc
///         (Sable.RawPtr.add base current).alloc = base.alloc := rfl
///         _ = _old_state.root.alloc := h_pre_base.1
///         _ = header.sizeCell.alloc := hstored.2.2.2.2.2.symm
///     · calc
///         (Sable.RawPtr.add base current).off = base.off + current := rfl
///         _ = current := by rw [h_pre_base.2]; omega
///         _ = header.key := hstored.2.2.1.symm
///         _ = header.sizeCell.off := hkeyoff
///   constructor
///   · rw [hfields.1]
///     simp
///   constructor
///   · calc
///       header.nextCell.alloc = header.sizeCell.alloc := halloc.symm
///       _ = _old_state.root.alloc := hstored.2.2.2.2.2
///       _ = base.alloc := h_pre_base.1.symm
///       _ = (Sable.RawPtr.add base current).alloc := rfl
///   constructor
///   · calc
///       header.nextCell.off =
///           header.sizeCell.off + header.sizeCell.layout.size := hoff.symm
///       _ = header.key + Sable.u64.layout.size := by
///         rw [← hkeyoff, hlayout]
///       _ = current + Sable.u64.layout.size := by
///         rw [hstored.2.2.1]
///       _ = (Sable.RawPtr.add base current).off +
///           Sable.u64.layout.size := by
///         rw [Sable.RawPtr.add_off, h_pre_base.2]
///         omega
///   · rw [hfields.2]
///     simp

/// discharge free_list_remove_after.free_header.init by
///   obtain ⟨header, previousSize, hstored, hfields, hrejected⟩ :=
///     h_pre_location.predecessor (by simpa using h_pre_interior)
///   have hbefore :=
///     h_pre_location.predecessorBefore (by simpa using h_pre_interior)
///   have hnode : _header6 = header := by
///     rw [h_header6_take, h_state_take_header,
///       Sable.AllocatorView.takeHeader_headerAt_ne _ (by omega),
///       Sable.AllocatorView.storesHeader_headerAt hstored]
///   have hvalue : previousSize = _value7 := by
///     rw [hnode, hfields.1] at h_value7_header_size
///     injection h_value7_header_size
///   have hmatch :=
///     (h_pre_location.predecessorChain
///       (by simpa using h_pre_interior)).takeMatchingHead
///       (h_pre_location.predecessorNotEnd
///         (by simpa using h_pre_interior)) hstored hfields
///   have hextent := hmatch.1
///   simp [Sable.FreeHeaderView.toFree,
///     Sable.FreeHeaderView.rawCell, Sable.SpanView.cat] at hextent
///   have hwf := hstored.2.2.2.1
///   unfold Sable.FreeHeaderView.wf at hwf
///   have hlayout : header.sizeCell.layout = Sable.u64.layout :=
///     hwf.1.1
///   obtain ⟨_, _, hkeyoff, halloc, _, hoff, _, _⟩ := hwf
///   rw [h_predecessor_clear, hnode]
///   constructor
///   · unfold Sable.PointsToView.names
///     constructor
///     · calc
///         (Sable.RawPtr.add base previous).alloc = base.alloc := rfl
///         _ = _old_state.root.alloc := h_pre_base.1
///         _ = header.sizeCell.alloc := hstored.2.2.2.2.2.symm
///     · calc
///         (Sable.RawPtr.add base previous).off =
///             base.off + previous := rfl
///         _ = previous := by rw [h_pre_base.2]; omega
///         _ = header.key := hstored.2.2.1.symm
///         _ = header.sizeCell.off := hkeyoff
///   constructor
///   · simp [Sable.FreeHeaderView.clearFields]
///   constructor
///   · calc
///       header.nextCell.alloc = header.sizeCell.alloc := halloc.symm
///       _ = _old_state.root.alloc := hstored.2.2.2.2.2
///       _ = base.alloc := h_pre_base.1.symm
///       _ = (Sable.RawPtr.add base previous).alloc := rfl
///   constructor
///   · calc
///       header.nextCell.off =
///           header.sizeCell.off + header.sizeCell.layout.size := hoff.symm
///       _ = header.key + header.sizeCell.layout.size := by
///         rw [← hkeyoff]
///       _ = previous + header.sizeCell.layout.size := by
///         rw [hstored.2.2.1]
///       _ = (Sable.RawPtr.add base previous).off +
///           Sable.u64.layout.size := by
///         rw [Sable.RawPtr.add_off, h_pre_base.2, hlayout]
///         omega
///   constructor
///   · simp [Sable.FreeHeaderView.clearFields]
///   · simp [Sable.FreeHeaderView.clearFields]
///     rw [← hvalue]
///     omega

/// discharge free_list_remove_after.allocator_put_header by
///   obtain ⟨header, previousSize, hstored, hfields, hrejected⟩ :=
///     h_pre_location.predecessor (by simpa using h_pre_interior)
///   have hbefore :=
///     h_pre_location.predecessorBefore (by simpa using h_pre_interior)
///   have htakeOld := Sable.AllocatorView.storesHeader_canTake hstored
///   have htakeState : state.canTakeHeader previous := by
///     rw [h_state_take_header]
///     exact Sable.AllocatorView.takeHeader_canTakeHeader_ne
///       _ htakeOld (by omega)
///   have horiginal : state_2.canPutHeader _header6 := by
///     rw [h_state_take_header_2, h_header6_take]
///     exact Sable.AllocatorView.takeHeader_canPutHeader
///       state previous htakeState
///   unfold Sable.AllocatorView.canPutHeader at horiginal ⊢
///   refine ⟨?_, h_predecessor_wf_2, ?_, ?_⟩
///   · simpa [h_predecessor_init, h_predecessor_clear,
///       Sable.FreeHeaderView.putFields,
///       Sable.FreeHeaderView.clearFields] using horiginal.1
///   · simpa [h_predecessor_init, h_predecessor_clear,
///       Sable.FreeHeaderView.putFields,
///       Sable.FreeHeaderView.clearFields] using horiginal.2.2.1
///   · simpa [h_predecessor_init, h_predecessor_clear,
///       Sable.FreeHeaderView.putFields,
///       Sable.FreeHeaderView.clearFields] using horiginal.2.2.2

/// discharge free_list_remove_after.post.chain by
///   obtain ⟨selectedHeader, hselectedStored, hselectedFields, hfit⟩ :=
///     h_pre_location.foundData (by simpa using h_pre_found)
///   obtain ⟨predecessorHeader, previousSize, hpredecessorStored,
///       hpredecessorFields, hrejected⟩ :=
///     h_pre_location.predecessor (by simpa using h_pre_interior)
///   have hbefore :=
///     h_pre_location.predecessorBefore (by simpa using h_pre_interior)
///   have hselected : _header2 = selectedHeader := by
///     rw [h_header2_take,
///       Sable.AllocatorView.storesHeader_headerAt hselectedStored]
///   have hpredecessor : _header6 = predecessorHeader := by
///     rw [h_header6_take, h_state_take_header,
///       Sable.AllocatorView.takeHeader_headerAt_ne _ (by omega),
///       Sable.AllocatorView.storesHeader_headerAt hpredecessorStored]
///   have hvalue : previousSize = _value7 := by
///     rw [hpredecessor, hpredecessorFields.1]
///       at h_value7_header_size
///     injection h_value7_header_size
///   have hrelinked : predecessor_2 =
///       predecessorHeader.clearFields.putFields previousSize next := by
///     rw [h_predecessor_init, h_predecessor_clear,
///       hpredecessor, ← hvalue]
///   have hput :
///       ((_old_state.takeHeader current).takeHeader previous).canPutHeader
///         predecessor_2 := by
///     rw [h_state_take_header_2, h_state_take_header]
///       at h_fact_sable_allocatorview_canp
///     exact h_fact_sable_allocatorview_canp
///   rw [h_state_put_header, h_state_take_header_2,
///     h_state_take_header]
///   exact h_pre_location.unlinkAfter
///     (by simpa using h_pre_found)
///     (by simpa using h_pre_interior)
///     hselectedStored hselectedFields hpredecessorStored
///     hpredecessorFields hrelinked hput

/// discharge free_list_remove_after.post.removed by
///   obtain ⟨header, hstored, hfields, hfit⟩ :=
///     h_pre_location.foundData (by simpa using h_pre_found)
///   have hnode : _header2 = header := by
///     rw [h_header2_take,
///       Sable.AllocatorView.storesHeader_headerAt hstored]
///   have hmatch := h_pre_location.resultChain.takeMatchingHead
///     (by simpa using h_pre_found) hstored hfields
///   rw [h_result, h_free4_block, h_selected_clear, hnode]
///   exact ⟨hstored.2.2.1, by simpa using hmatch.1⟩

/// discharge free_list_remove_after.post.owner by
///   rw [h_result, h_free4_block, h_selected_clear,
///     h_state_put_header, h_state_take_header_2]
///   exact h_header2_owner

/// discharge free_list_remove_after.post.root by
///   obtain ⟨header, hstored, hfields, hfit⟩ :=
