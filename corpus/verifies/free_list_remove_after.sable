///   rw [h_result, h_free4_block, h_selected_clear, hnode,
///     h_state_put_header, h_state_take_header_2, h_state_take_header]
///   exact hstored.2.2.2.2.2

/// discharge free_list_remove_after.free_header.to_block by
///   rw [h_selected_clear]
///   constructor
///   · simpa [Sable.FreeHeaderView.clearFields,
///       Sable.PointsToView.names] using
