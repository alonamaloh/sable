// The JSON tokenizer (RFC 8259 lexical grammar). The grammar
// lives in ghost predicates — `strTail` (string bodies, recursive with
// varying escape widths), `digits`/`jint`/`jfrac`/`jexp`/`jnumber`
// (numbers, an ∃-split over phase boundaries), `jtoken` (the kind
// disjunction), and `lexable` (whole-buffer tokenizability, recursion
// guarded so the ∃-bound token end needs no termination side
// condition). Scanners follow the phase-function pattern: every
// multi-path lexeme phase is a small contracted helper, so path splits
// stay contained and the ∃-witnesses in posts are stable call-result
// binders.

// The array-length ceiling (2^62): every buffer contract is
// stated against it.
const u64 MAX_BYTES = 4611686018427387904;

/// def isWs (c : int) : Prop := c = 32 ∨ c = 9 ∨ c = 10 ∨ c = 13

/// def digitc (c : int) : Prop := 48 ≤ c ∧ c ≤ 57

/// def hexd (c : int) : Prop := (48 ≤ c ∧ c ≤ 57) ∨ (65 ≤ c ∧ c ≤ 70) ∨ (97 ≤ c ∧ c ≤ 102)

/// def escc (c : int) : Prop := c = 34 ∨ c = 92 ∨ c = 47 ∨ c = 98 ∨ c = 102 ∨ c = 110 ∨ c = 114 ∨ c = 116

/// def strTail (b : Sable.Seq Int) (i j : int) : Prop :=
///   if j ≤ i then False
///   else if b.get i = 34 then j = i + 1
///   else if b.get i = 92 then
///     (escc (b.get (i + 1)) ∧ strTail b (i + 2) j) ∨
///     (b.get (i + 1) = 117 ∧ hexd (b.get (i + 2)) ∧ hexd (b.get (i + 3)) ∧
///       hexd (b.get (i + 4)) ∧ hexd (b.get (i + 5)) ∧ strTail b (i + 6) j)
///   else 32 ≤ b.get i ∧ strTail b (i + 1) j
/// termination_by (j - i).toNat
/// decreasing_by
///   all_goals omega

/// def jstring (b : Sable.Seq Int) (i j : int) : Prop := b.get i = 34 ∧ strTail b (i + 1) j

/// def digits (b : Sable.Seq Int) (i j : int) : Prop := i < j ∧ ∀ k, i ≤ k → k < j → digitc (b.get k)

/// def jint (b : Sable.Seq Int) (i j : int) : Prop := (b.get i = 48 ∧ j = i + 1) ∨ (49 ≤ b.get i ∧ b.get i ≤ 57 ∧ digits b i j)

/// def jfrac (b : Sable.Seq Int) (i j : int) : Prop := i = j ∨ (b.get i = 46 ∧ digits b (i + 1) j)

/// def jexp (b : Sable.Seq Int) (i j : int) : Prop := i = j ∨ ((b.get i = 101 ∨ b.get i = 69) ∧ (digits b (i + 1) j ∨ ((b.get (i + 1) = 43 ∨ b.get (i + 1) = 45) ∧ digits b (i + 2) j)))

/// def jnumber (b : Sable.Seq Int) (i j : int) : Prop := ∃ p q, ((b.get i = 45 ∧ jint b (i + 1) p) ∨ (b.get i ≠ 45 ∧ jint b i p)) ∧ jfrac b p q ∧ jexp b q j ∧ i < p ∧ p ≤ q ∧ q ≤ j

/// def jpunct (c : int) : Prop := c = 123 ∨ c = 125 ∨ c = 91 ∨ c = 93 ∨ c = 58 ∨ c = 44

/// def jtoken (b : Sable.Seq Int) (i j : int) : Prop :=
///   (jpunct (b.get i) ∧ j = i + 1) ∨
///   (b.get i = 116 ∧ b.get (i + 1) = 114 ∧ b.get (i + 2) = 117 ∧ b.get (i + 3) = 101 ∧ j = i + 4) ∨
///   (b.get i = 102 ∧ b.get (i + 1) = 97 ∧ b.get (i + 2) = 108 ∧ b.get (i + 3) = 115 ∧ b.get (i + 4) = 101 ∧ j = i + 5) ∨
///   (b.get i = 110 ∧ b.get (i + 1) = 117 ∧ b.get (i + 2) = 108 ∧ b.get (i + 3) = 108 ∧ j = i + 4) ∨
///   jstring b i j ∨
///   jnumber b i j

/// def lexable (b : Sable.Seq Int) (pos : int) : Prop :=
///   if b.len ≤ pos then True
///   else (isWs (b.get pos) ∧ lexable b (pos + 1)) ∨
///     (∃ e, jtoken b pos e ∧ pos < e ∧ e ≤ b.len ∧
///       lexable b (if pos < e then e else pos + 1))
/// termination_by (b.len - pos).toNat
/// decreasing_by
///   all_goals first | omega | (split <;> omega)

/// theorem #[fact] strTail_close (b : Sable.Seq Int) (i : int) (h : b.get i = 34) :
///     strTail b i (i + 1) := by
///   rw [strTail]
///   rw [if_neg (by omega), if_pos h]

/// theorem #[fact] strTail_char (b : Sable.Seq Int) (i j : int)
///     (hq : b.get i ≠ 34) (he : b.get i ≠ 92) (hlo : 32 ≤ b.get i)
///     (hj : i < j)
///     (hrest : strTail b (i + 1) j) : strTail b i j := by
///   rw [strTail]
///   rw [if_neg (by omega), if_neg hq, if_neg he]
///   exact ⟨hlo, hrest⟩

/// theorem #[fact] strTail_esc (b : Sable.Seq Int) (i j : int)
///     (hq : b.get i ≠ 34) (he : b.get i = 92) (hesc : escc (b.get (i + 1)))
///     (hj : i < j)
///     (hrest : strTail b (i + 2) j) : strTail b i j := by
///   rw [strTail]
///   rw [if_neg (by omega), if_neg hq, if_pos he]
///   exact Or.inl ⟨hesc, hrest⟩

/// theorem #[fact] strTail_hex (b : Sable.Seq Int) (i j : int)
///     (hq : b.get i ≠ 34) (he : b.get i = 92) (hu : b.get (i + 1) = 117)
///     (h2 : hexd (b.get (i + 2))) (h3 : hexd (b.get (i + 3)))
///     (h4 : hexd (b.get (i + 4))) (h5 : hexd (b.get (i + 5)))
///     (hj : i < j)
///     (hrest : strTail b (i + 6) j) : strTail b i j := by
///   rw [strTail]
///   rw [if_neg (by omega), if_neg hq, if_pos he]
///   exact Or.inr ⟨hu, h2, h3, h4, h5, hrest⟩

/// theorem #[fact] strTail_lt (b : Sable.Seq Int) (i j : int) (h : strTail b i j) : i < j := by
///   rw [strTail] at h
///   split at h
///   · exact h.elim
///   · omega

/// theorem #[fact] lexable_end (b : Sable.Seq Int) (pos : int) (h : b.len ≤ pos) :
///     lexable b pos := by
///   rw [lexable]
///   rw [if_pos h]
///   trivial

/// theorem #[fact] lexable_ws (b : Sable.Seq Int) (pos : int)
///     (hpos : pos < b.len) (hws : isWs (b.get pos))
///     (hrest : lexable b (pos + 1)) : lexable b pos := by
///   rw [lexable]
///   rw [if_neg (by omega)]
///   exact Or.inl ⟨hws, hrest⟩

/// theorem #[fact] lexable_tok (b : Sable.Seq Int) (pos e : int)
///     (hpos : pos < b.len) (ht : jtoken b pos e)
///     (hlt : pos < e) (hle : e ≤ b.len)
///     (hrest : lexable b e) : lexable b pos := by
///   rw [lexable]
///   rw [if_neg (by omega)]
///   refine Or.inr ⟨e, ht, hlt, hle, ?_⟩
///   rw [if_pos hlt]
///   exact hrest

// ------------------------------------------------------- phase helpers

/// pre  i ≤ b.len
/// pre  b.len ≤ MAX_BYTES
/// post i ≤ result ∧ result ≤ b.len
/// post ∀ k, i ≤ k → k < result → digitc (b.get k)
/// post result < b.len → ¬digitc (b.get result)
/// post i < b.len → digitc (b.get i) → i < result
fn digit_run(&[u8] b, u64 i) -> u64 {
    mut u64 j = i;
    u64 n = b.len;
    /// invariant i ≤ j ∧ j ≤ n
    /// invariant ∀ k, i ≤ k → k < j → digitc (b.get k)
    /// variant   n - j
    while (j < n) {
        u8 c = b[j];
        if (c < 48 || c > 57) {
            return j;
        }
        j = j + 1;
    }
    return j;
}

/// post result ↔ hexd c
fn hexd_ok(u8 c) -> bool {
    if (c >= 48 && c <= 57) {
        return true;
    }
    if (c >= 65 && c <= 70) {
        return true;
    }
    if (c >= 97 && c <= 102) {
        return true;
    }
    return false;
}

// `jint_scan` consumes `-? (0 | [1-9][0-9]*)` starting at `pos`;
// `jfrac_scan`/`jexp_scan` consume an OPTIONAL fraction/exponent
// (returning their start unchanged when absent). All return 0 on a
// malformed phase.

/// pre  pos < b.len
/// pre  b.len ≤ MAX_BYTES
/// post result ≠ 0 → pos < result ∧ result ≤ b.len ∧ ((b.get pos = 45 ∧ jint b (pos + 1) result) ∨ (b.get pos ≠ 45 ∧ jint b pos result))
fn jint_scan(&[u8] b, u64 pos) -> u64 {
    u64 n = b.len;
    mut u64 i = pos;
    if (b[i] == 45) {
        i = i + 1;
        if (i >= n) {
            return 0;
        }
    }
    u8 c0 = b[i];
    if (c0 == 48) {
        return i + 1;
    }
    if (c0 < 49 || c0 > 57) {
        return 0;
    }
    u64 e = digit_run(&b, i);
    return e;
}

/// pre  i ≤ b.len
/// pre  b.len ≤ MAX_BYTES
/// post result ≠ 0 → i ≤ result ∧ result ≤ b.len ∧ jfrac b i result
fn jfrac_scan(&[u8] b, u64 i) -> u64 {
    u64 n = b.len;
    if (i >= n) {
        return i;
    }
    if (b[i] != 46) {
        return i;
    }
    u64 d = i + 1;
    if (d >= n) {
        return 0;
    }
    if (b[d] < 48 || b[d] > 57) {
        return 0;
    }
    u64 e = digit_run(&b, d);
    return e;
}

/// pre  i ≤ b.len
/// pre  b.len ≤ MAX_BYTES
/// post result ≠ 0 → i ≤ result ∧ result ≤ b.len ∧ jexp b i result
fn jexp_scan(&[u8] b, u64 i) -> u64 {
    u64 n = b.len;
    if (i >= n) {
        return i;
    }
    if (b[i] != 101 && b[i] != 69) {
        return i;
    }
    u64 d = i + 1;
    if (d >= n) {
        return 0;
    }
    if (b[d] == 43 || b[d] == 45) {
        u64 d2 = d + 1;
        if (d2 >= n) {
            return 0;
        }
        if (b[d2] < 48 || b[d2] > 57) {
            return 0;
        }
        u64 e2 = digit_run(&b, d2);
        return e2;
    }
    if (b[d] < 48 || b[d] > 57) {
        return 0;
    }
    u64 e = digit_run(&b, d);
    return e;
}

// --------------------------------------------------------- the lexemes

/// pre  pos < b.len
/// pre  b.len ≤ MAX_BYTES
/// post result ≠ 0 → pos < result ∧ result ≤ b.len ∧ jnumber b pos result
fn json_number_end(&[u8] b, u64 pos) -> u64 {
    u64 a1 = jint_scan(&b, pos);
    if (a1 == 0) {
        return 0;
    }
    u64 a2 = jfrac_scan(&b, a1);
    if (a2 == 0) {
        return 0;
    }
    u64 a3 = jexp_scan(&b, a2);
    if (a3 == 0) {
        return 0;
    }
    return a3;
}

/// pre  pos < b.len
/// pre  b.len ≤ MAX_BYTES
/// pre  b.get pos = 34
/// post result ≠ 0 → pos < result ∧ result ≤ b.len ∧ jstring b pos result
fn json_string_end(&[u8] b, u64 pos) -> u64 {
    u64 n = b.len;
    mut u64 i = pos + 1;
    /// invariant pos < i ∧ i ≤ n
    /// invariant ∀ e2, strTail b i e2 → strTail b (pos + 1) e2
    /// variant   n - i
    while (i < n) {
        u8 c = b[i];
        if (c == 34) {
            return i + 1;
        }
        if (c == 92) {
            if (i + 1 >= n) {
                return 0;
            }
            u8 e = b[i + 1];
            if (e == 117) {
                if (i + 5 >= n) {
                    return 0;
                }
                bool h2 = hexd_ok(b[i + 2]);
                bool h3 = hexd_ok(b[i + 3]);
                bool h4 = hexd_ok(b[i + 4]);
                bool h5 = hexd_ok(b[i + 5]);
                if (!h2 || !h3 || !h4 || !h5) {
                    return 0;
                }
                i = i + 6;
            } else {
                if (e != 34 && e != 92 && e != 47 && e != 98 && e != 102 && e != 110 && e != 114 && e != 116) {
                    return 0;
                }
                i = i + 2;
            }
        } else {
            if (c < 32) {
                return 0;
            }
            i = i + 1;
        }
    }
    return 0;
}

/// pre  pos < b.len
/// pre  b.len ≤ MAX_BYTES
/// post result ≠ 0 → pos < result ∧ result ≤ b.len ∧ jtoken b pos result
fn json_token(&[u8] b, u64 pos) -> u64 {
    u64 n = b.len;
    u8 c = b[pos];
    if (c == 123 || c == 125 || c == 91 || c == 93 || c == 58 || c == 44) {
        return pos + 1;
    }
    if (c == 116) {
        if (pos + 3 >= n) {
            return 0;
        }
        if (b[pos + 1] == 114 && b[pos + 2] == 117 && b[pos + 3] == 101) {
            return pos + 4;
        }
        return 0;
    }
    if (c == 102) {
        if (pos + 4 >= n) {
            return 0;
        }
        if (b[pos + 1] == 97 && b[pos + 2] == 108 && b[pos + 3] == 115 && b[pos + 4] == 101) {
            return pos + 5;
        }
        return 0;
    }
    if (c == 110) {
        if (pos + 3 >= n) {
            return 0;
        }
        if (b[pos + 1] == 117 && b[pos + 2] == 108 && b[pos + 3] == 108) {
            return pos + 4;
        }
        return 0;
    }
    if (c == 34) {
        u64 es = json_string_end(&b, pos);
        return es;
    }
    if (c == 45 || (c >= 48 && c <= 57)) {
        u64 en = json_number_end(&b, pos);
        return en;
    }
    return 0;
}

// ---------------------------------------------------------- the capstone

/// pre  b.len ≤ MAX_BYTES
/// post result → lexable b 0
pub fn json_lex_ok(&[u8] b) -> bool {
    mut u64 pos = 0;
    u64 n = b.len;
    /// invariant pos ≤ n
    /// invariant lexable b pos → lexable b 0
    /// variant   n - pos
    while (pos < n) {
        u8 c = b[pos];
        if (c == 32 || c == 9 || c == 10 || c == 13) {
            pos = pos + 1;
        } else {
            u64 e = json_token(&b, pos);
            if (e == 0) {
                return false;
            }
            pos = e;
        }
    }
    return true;
}

