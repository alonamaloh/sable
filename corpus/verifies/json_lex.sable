/// discharge digit_run.inv_preserved.k_i_k_k_j_digitc_b_get_k by
///   intro k hk1 hk2
///   by_cases hkj : k = j
///   · subst hkj
///     simp only [digitc]
///     omega
///   · exact h_inv_k_i_k_k_j_digitc_b_get_k k hk1 (by omega)

