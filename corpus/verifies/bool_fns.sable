// Bool-valued functions: `result` is Prop-valued in the logic, so
// posts like `result → P` and `result ↔ P` splice naturally.

/// post result ↔ a % 2 = 0
fn is_even(u64 a) -> bool {
    return a % 2 == 0;
}

/// post result → a ≥ b
/// post ¬result → a < b
fn at_least(u64 a, u64 b) -> bool {
    if (a >= b) { return true; }
    return false;
}

/// post result = 1 ∨ result = 0
fn indicator(u64 x) -> u32 {
    if (is_even(x)) { return 1; }
    return 0;
}
