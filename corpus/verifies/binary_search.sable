// The design doc's §6 binary_search, with the
// all-Int spec style (explicit 0 ≤ k guards; see lean/Sable/Seq.lean).
// Two invariant-preservation obligations genuinely need the sortedness
// hypothesis instantiated and are discharged by hand below — exactly the
// two-tier workflow the design intends.

/// pre  sorted a
/// post match result with
///      | some i => 0 ≤ i ∧ i < a.len ∧ a.get i = key
///      | none   => ∀ k, 0 ≤ k → k < a.len → a.get k ≠ key
fn binary_search(&[i32] a, i32 key) -> option<u64> {
    mut u64 lo = 0;
    mut u64 hi = a.len;
    /// invariant hi ≤ a.len
    /// invariant ∀ k, 0 ≤ k → k < lo → a.get k < key
    /// invariant ∀ k, hi ≤ k → k < a.len → key < a.get k
    /// variant   hi - lo
    while (lo < hi) {
        u64 m = lo + (hi - lo) / 2;
        if (a[m] < key) {
            lo = m + 1;
        } else if (a[m] > key) {
            hi = m;
        } else {
            return some(m);
        }
    }
    return none;
}

// The two obligations automation cannot reach: shrinking the interval
// keeps the "everything outside is ≠ key" invariants only because the
// array is sorted, and instantiating the sortedness quantifier is beyond
// the portfolio. Hypothesis names come from the failure output.

/// discharge binary_search.inv_preserved.k_0_k_k_lo_a_get_k_key by
///   intro k hk0 hk
///   by_cases hklo : k < lo
///   · exact h_inv_k_0_k_k_lo_a_get_k_key k hk0 hklo
///   · by_cases hkm : k = lo + ((hi - lo) / 2)
///     · rw [hkm]; exact h_path_a_get_lo_hi_lo_2_key
///     · calc a.get k ≤ a.get (lo + ((hi - lo) / 2)) :=
///             h_pre_sorted_a k _ hk0 (by omega) (by omega)
///         _ < key := h_path_a_get_lo_hi_lo_2_key

/// discharge binary_search.inv_preserved.k_hi_k_k_a_len_key_a_get_k.2 by
///   intro k hk hka
///   by_cases hkm : k = lo + ((hi - lo) / 2)
///   · rw [hkm]; omega
///   · have h1 : a.get (lo + ((hi - lo) / 2)) ≤ a.get k :=
///       h_pre_sorted_a _ k (by omega) (by omega) hka
///     omega
