// Design §7's BoundedStack, near-verbatim.
// The class invariant is an interface block: an obligation at the exit
// of every init and &mut-self method, an assumption at every entry.

pub class BoundedStack {
    [i32] buf;
    u64  len;

    /// invariant len ≤ buf.len
    /// invariant buf.len > 0

    /// pre cap > 0
    init with_capacity(u64 cap) {
        self.buf = alloc_array<i32>(cap, 0);
        self.len = 0;
    }

    /// post result  → self.len = old self.len + 1 ∧ self.buf.get (old self.len) = x
    /// post ¬result → self = old self
    fn push(&mut self, i32 x) -> bool {
        if (self.len == self.buf.len) { return false; }
        self.buf[self.len] = x;
        self.len = self.len + 1;
        return true;
    }

    /// post old self.len = 0 → result = none
    /// post old self.len > 0 → result = some (self.buf.get (old self.len - 1))
    fn pop(&mut self) -> option<i32> {
        if (self.len == 0) { return none; }
        self.len = self.len - 1;
        return some(self.buf[self.len]);
    }

    deinit {
    }
}

fn demo() {
    var mut s = BoundedStack::with_capacity(4);
    s.push(7);
    s.pop();
}

// A `&mut self` method inside a loop: the receiver is havocked at the
// loop head, so what the caller knows about it afterwards is exactly
// what the loop invariant says — and the invariant is carried by the
// method's own post, one iteration at a time. The call sits in a
// declaration initializer, which mutates just as much as the same call
// in statement position.
pub class Counter {
    u64 n;

    /// invariant n ≤ 100

    /// post self.n = 0
    init zero() {
        self.n = 0;
    }

    /// pre  self.n < 100
    /// post self.n = old self.n + 1
    /// post result = self.n
    fn bump(&mut self) -> u64 {
        self.n = self.n + 1;
        return self.n;
    }

    /// post result = self.n
    fn get(&self) -> u64 {
        return self.n;
    }
}

/// post result = 3
pub fn count_to_three() -> u64 {
    var mut c = Counter::zero();
    mut u64 i = 0;
    /// invariant i ≤ 3
    /// invariant c.n = i
    /// variant 3 - i
    while (i < 3) {
        u64 seen = c.bump();
        i = i + 1;
    }
    u64 r = c.get();
    return r;
}
