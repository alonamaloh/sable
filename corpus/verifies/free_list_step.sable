// U8f vertical slice: initialized headers may be parked inside the erased
// allocator aggregate, then temporarily extracted at an ordinary runtime
// offset for one checked traversal step.

/// post result = 64
pub fn free_list_one_step() -> u64 {
    unsafe system_alloc(32) as (base, resource mem, resource release);
    mut resource AllocatorState state = allocator_create(mem);
    resource FreeBlock block = allocator_take_free(&mut state, 0);

    unsafe {
        mut resource FreeHeader header = raw_into_free_header(base, block);
        raw_header_init(base, 32, 32, &mut header);
    }
    allocator_put_header(&mut state, header);

    u64 limit = 32;
    mut u64 current = 0;
    resource FreeHeader found = allocator_step_header(&mut state, limit, current);
    mut u64 size = 0;
    mut u64 next = 0;
    unsafe {
        raw<u8> node = raw_offset(base, current);
        size = raw_header_size(node, &found);
        next = raw_header_next(node, &found);
    }
    /// assert #[label(header)] 16 <= size
    /// assert #[label(order)] current + size <= next
    /// assert #[label(bound)] next <= limit
    current = next;
    allocator_put_header(&mut state, found);

    mut resource FreeHeader cleanup = allocator_take_header(&mut state, 0);
    unsafe {
        raw_header_clear(base, &mut cleanup);
        resource FreeBlock restored = raw_from_free_header(base, cleanup);
    }
    allocator_put_free(&mut state, restored);
    resource RawSpan whole = allocator_destroy(state);
    unsafe system_dealloc(base, whole, release);
    return size + current;
}

