// First-class class values (ADR 0010): shared class borrows
// as parameters, class returns, and field reads on borrowed values.
// Contracts speak about class values as structures — `a.lo`,
// `result.hi` — with no new spec surface at all; borrowed arguments
// carry their invariant in (borrow_inv, caller-side obligation) and
// returned values carry it out (ret_inv, callee-side obligation).

class Range {
    i32 lo;
    i32 hi;

    /// invariant 0 ≤ lo
    /// invariant lo ≤ hi

    /// pre  0 ≤ a
    /// pre  a ≤ b
    /// post self.lo = a ∧ self.hi = b
    init make(i32 a, i32 b) {
        self.lo = a;
        self.hi = b;
    }
}

/// post #[label(width)] result = r.hi - r.lo
fn width(&Range r) -> i32 {
    return r.hi - r.lo;
}

/// post #[label(lo_min)] (result.lo = a.lo ∨ result.lo = b.lo) ∧ result.lo ≤ a.lo ∧ result.lo ≤ b.lo
/// post #[label(hi_max)] (result.hi = a.hi ∨ result.hi = b.hi) ∧ result.hi ≥ a.hi ∧ result.hi ≥ b.hi
fn union_of(&Range a, &Range b) -> Range {
    mut i32 mn = a.lo;
    if (b.lo < mn) {
        mn = b.lo;
    }
    mut i32 mx = a.hi;
    if (b.hi > mx) {
        mx = b.hi;
    }
    var u = Range::make(mn, mx);
    return u;
}

/// post result = 9
fn demo() -> i32 {
    var x = Range::make(1, 5);
    var y = Range::make(3, 10);
    var u = union_of(&x, &y);
    return width(&u);
}
