// In-place insertion sort with the full
// specification — the output is sorted AND a permutation of the input.
// The permutation half rides on the prelude's counting library
// (lean/Sable/Perm.lean); `Seq.perm_swap` matches the three-statement
// swap idiom below exactly.

/// post sorted a
/// post perm a (old a)
fn insertion_sort(&mut [i32] a) {
    u64 n = a.len;
    /// invariant ∀ p q, 0 ≤ p → p < q → q < i → a.get p ≤ a.get q
    /// invariant perm a (old a)
    for (u64 i : range(n)) {
        mut u64 j = i;
        /// invariant j ≤ i
        /// invariant ∀ p q, 0 ≤ p → p < q → q ≤ i → q ≠ j → a.get p ≤ a.get q
        /// invariant perm a (old a)
        /// variant   j
        while (j > 0 && a[j - 1] > a[j]) {
            i32 t = a[j - 1];
            a[j - 1] = a[j];
            a[j] = t;
            j = j - 1;
        }
    }
}

// The three obligations automation cannot reach; hypothesis names come
// from the failure output.

// Swapping neighbours keeps "sorted except at the moving element":
// case on where p and q fall relative to the swapped pair (j-1, j).
/// discharge insertion_sort.inv_preserved.p_q_0_p_p_q_q_i_q_j_a_get_p_a_get_q by
///   intro p q hp hpq hqi hqj1
///   have hj0 : 0 < j := h_path_j_0_a_get_j_1_a_get_j.1
///   have hgt : a.get (j - 1) > a.get j := h_path_j_0_a_get_j_1_a_get_j.2
///   have hne : j - 1 ≠ j := by omega
///   by_cases hqj : q = j
///   · by_cases hpj1 : p = j - 1
///     · simp [Sable.Seq.get_set, hqj, hpj1, hne]
///       omega
///     · have h1 : p ≠ j := by omega
///       have h2 : a.get p ≤ a.get (j - 1) :=
///         h_inv_p_q_0_p_p_q_q_i_q_j_a_ge p (j - 1) hp (by omega) (by omega) (by omega)
///       simp [Sable.Seq.get_set, hqj, h1, hpj1]
///       omega
///   · by_cases hpj : p = j
///     · have h2 : a.get (j - 1) ≤ a.get q :=
///         h_inv_p_q_0_p_p_q_q_i_q_j_a_ge (j - 1) q (by omega) (by omega) hqi hqj
///       simp [Sable.Seq.get_set, hpj, hqj, hqj1]
///       omega
///     · by_cases hpj1 : p = j - 1
///       · have h2 : a.get j ≤ a.get q :=
///           h_inv_p_q_0_p_p_q_q_i_q_j_a_ge j q (by omega) (by omega) hqi hqj
///         simp [Sable.Seq.get_set, hpj1, hne, hqj, hqj1]
///         omega
///       · have h2 : a.get p ≤ a.get q := h_inv_p_q_0_p_p_q_q_i_q_j_a_ge p q hp hpq hqi hqj
///         simp [Sable.Seq.get_set, hpj, hpj1, hqj, hqj1]
///         omega

// Each swap is a permutation (prelude lemma), chained transitively:
/// discharge insertion_sort.inv_preserved.perm_a_old_a by
///   exact Sable.Seq.perm_trans
///     (Sable.Seq.perm_swap a (j - 1) j (by omega) (by omega) (by omega) (by omega))
///     h_inv_perm_a_old_a

// When the inner loop stops (j = 0 or a[j-1] ≤ a[j]), the moving element
// is in place, so the whole prefix [0, i+1) is sorted:
/// discharge insertion_sort.inv_preserved.p_q_0_p_p_q_q_i_a_get_p_a_get_q by
///   intro p q hp hpq hqi
///   by_cases hqj : q = j
///   · by_cases hj0 : 0 < j
///     · have hle : a.get (j - 1) ≤ a.get j := by
///         by_cases hgt : a.get (j - 1) > a.get j
///         · exact absurd ⟨hj0, hgt⟩ h_path_not_j_0_a_get_j_1_a_get_j
///         · omega
///       by_cases hp1 : p = j - 1
///       · rw [hqj, hp1]; exact hle
///       · have h2 : a.get p ≤ a.get (j - 1) :=
///           h_inv_p_q_0_p_p_q_q_i_q_j_a_ge p (j - 1) hp (by omega) (by omega) (by omega)
///         rw [hqj]
///         omega
///     · omega
///   · exact h_inv_p_q_0_p_p_q_q_i_q_j_a_ge p q hp hpq (by omega) hqj
