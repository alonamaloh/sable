// In-place quicksort over index ranges: Lomuto partition with a
// full functional contract, recursive quicksort_range with a frame
// ("unchanged outside [lo,hi)") and bound-preservation posts that make
// the sortedness glue compose, and the top-level `sorted + perm` spec.

/// pre  lo < hi
/// pre  hi ≤ a.len
/// post lo ≤ result ∧ result < hi
/// post ∀ k, lo ≤ k → k < result → a.get k ≤ a.get result
/// post ∀ k, result < k → k < hi → a.get result ≤ a.get k
/// post perm a (old a)
/// post ∀ k, 0 ≤ k → k < a.len → (k < lo ∨ hi ≤ k) → a.get k = (old a).get k
/// post ∀ b, (∀ k, lo ≤ k → k < hi → b ≤ (old a).get k) → (∀ k, lo ≤ k → k < hi → b ≤ a.get k)
/// post ∀ b, (∀ k, lo ≤ k → k < hi → (old a).get k ≤ b) → (∀ k, lo ≤ k → k < hi → a.get k ≤ b)
fn partition(&mut [i32] a, u64 lo, u64 hi) -> u64 {
    u64 h = hi - 1;
    i32 pivot = a[h];
    mut u64 i = lo;
    /// invariant lo ≤ i ∧ i ≤ j
    /// invariant a.get h = pivot
    /// invariant ∀ k, lo ≤ k → k < i → a.get k < pivot
    /// invariant ∀ k, i ≤ k → k < j → pivot ≤ a.get k
    /// invariant perm a (old a)
    /// invariant ∀ k, 0 ≤ k → k < a.len → (k < lo ∨ hi ≤ k) → a.get k = (old a).get k
    /// invariant ∀ b, (∀ k, lo ≤ k → k < hi → b ≤ (old a).get k) → (∀ k, lo ≤ k → k < hi → b ≤ a.get k)
    /// invariant ∀ b, (∀ k, lo ≤ k → k < hi → (old a).get k ≤ b) → (∀ k, lo ≤ k → k < hi → a.get k ≤ b)
    for (u64 j : range(lo, h)) {
        if (a[j] < pivot) {
            i32 t = a[i];
            a[i] = a[j];
            a[j] = t;
            i = i + 1;
        }
    }
    i32 t2 = a[i];
    a[i] = a[h];
    a[h] = t2;
    return i;
}

/// pre  lo ≤ hi
/// pre  hi ≤ a.len
/// post sortedRange a lo hi
/// post perm a (old a)
/// post ∀ k, 0 ≤ k → k < a.len → (k < lo ∨ hi ≤ k) → a.get k = (old a).get k
/// post ∀ b, (∀ k, lo ≤ k → k < hi → b ≤ (old a).get k) → (∀ k, lo ≤ k → k < hi → b ≤ a.get k)
/// post ∀ b, (∀ k, lo ≤ k → k < hi → (old a).get k ≤ b) → (∀ k, lo ≤ k → k < hi → a.get k ≤ b)
fn quicksort_range(&mut [i32] a, u64 lo, u64 hi)
/// variant hi - lo
{
    if (hi - lo > 1) {
        u64 p = partition(&mut a, lo, hi);
        quicksort_range(&mut a, lo, p);
        quicksort_range(&mut a, p + 1, hi);
    }
}

/// post sorted a
/// post perm a (old a)
pub fn quicksort(&mut [i32] a) {
    u64 n = a.len;
    quicksort_range(&mut a, 0, n);
}

// --- partition: the swap in the loop body preserves each invariant ---

// "everything left of i is < pivot": the swap writes a[j] (which the
// path says is < pivot) into slot i; slots below i are untouched.
/// discharge partition.inv_preserved.k_lo_k_k_i_a_get_k_pivot by
///   intro k hk0 hk
///   by_cases hkj : k = j
///   · have hij : i = j := by omega
///     simp [Sable.Seq.get_set, hkj]
///     rw [hij]
///     exact h_path_a_get_j_old_a_get_hi_1
///   · by_cases hki : k = i
///     · have hij : ¬ i = j := by omega
///       simp [Sable.Seq.get_set, hki, hij]
///       exact h_path_a_get_j_old_a_get_hi_1
///     · simp [Sable.Seq.get_set, hki, hkj]
///       exact h_inv_k_lo_k_k_i_a_get_k_pivot k hk0 (by omega)

// "everything in [i, j) is ≥ pivot": the old a[i] (≥ pivot) moves to
// slot j, the rest of the window shifts by one.
/// discharge partition.inv_preserved.k_i_k_k_j_pivot_a_get_k by
///   intro k hk0 hk
///   by_cases hkj : k = j
///   · simp [Sable.Seq.get_set, hkj]
///     exact h_inv_k_i_k_k_j_pivot_a_get_k i (by omega) (by omega)
///   · have hki : k ≠ i := by omega
///     simp [Sable.Seq.get_set, hkj, hki]
///     exact h_inv_k_i_k_k_j_pivot_a_get_k k (by omega) (by omega)

// Each swap is a permutation, chained transitively.
/// discharge partition.inv_preserved.perm_a_old_a by
///   exact Sable.Seq.perm_trans
///     (Sable.Seq.perm_swap a i j (by omega) (by omega) (by omega) (by omega))
///     h_inv_perm_a_old_a

// Lower-bound preservation: the swapped-in values are old in-range values.
/// discharge partition.inv_preserved.b_k_lo_k_k_hi_b_old_a_get_k_k_lo_k_k_hi by
///   intro b hb k hk0 hk1
///   have hbi : b ≤ a.get i := h_inv_b_k_lo_k_k_hi_b_old_a_ge b hb i (by omega) (by omega)
///   have hbj : b ≤ a.get j := h_inv_b_k_lo_k_k_hi_b_old_a_ge b hb j (by omega) (by omega)
///   have hbk : b ≤ a.get k := h_inv_b_k_lo_k_k_hi_b_old_a_ge b hb k hk0 hk1
///   simp [Sable.Seq.get_set]
///   by_cases hkj : k = j
///   · simp [hkj]
///     exact hbi
///   · simp [hkj]
///     by_cases hki : k = i
///     · simp [hki]
///       exact hbj
///     · simp [hki]
///       exact hbk

// Upper-bound preservation, symmetric.
/// discharge partition.inv_preserved.b_k_lo_k_k_hi_old_a_get_k_b_k_lo_k_k_hi by
///   intro b hb k hk0 hk1
///   have hbi : a.get i ≤ b := h_inv_b_k_lo_k_k_hi_old_a_get b hb i (by omega) (by omega)
///   have hbj : a.get j ≤ b := h_inv_b_k_lo_k_k_hi_old_a_get b hb j (by omega) (by omega)
///   have hbk : a.get k ≤ b := h_inv_b_k_lo_k_k_hi_old_a_get b hb k hk0 hk1
///   simp [Sable.Seq.get_set]
///   by_cases hkj : k = j
///   · simp [hkj]
///     exact hbi
///   · simp [hkj]
///     by_cases hki : k = i
///     · simp [hki]
///       exact hbj
///     · simp [hki]
///       exact hbk

// --- partition: the final swap puts the pivot at `result` ---

// Left of the pivot: untouched slots, all < pivot; the pivot lands at
// `result` in both the i = hi-1 (self-swap) and i < hi-1 cases.
/// discharge partition.post.k_lo_k_k_result_a_get_k_a_get_result by
///   intro k hk0 hk1
///   have hklt : a.get k < _old_a.get (hi - 1) :=
///     h_inv_k_lo_k_k_i_a_get_k_pivot k hk0 (by omega)
///   have hgi : ((a.set i (a.get (hi - 1))).set (hi - 1) (a.get i)).get result
///       = _old_a.get (hi - 1) := by
///     by_cases hih : i = hi - 1
///     · simp [Sable.Seq.get_set, h_result, hih]
///       exact h_inv_a_get_h_pivot
///     · simp [Sable.Seq.get_set, h_result, hih]
///       exact h_inv_a_get_h_pivot
///   have hki : ¬ k = i := by omega
///   have hkh : ¬ k = hi - 1 := by omega
///   have hgk : ((a.set i (a.get (hi - 1))).set (hi - 1) (a.get i)).get k = a.get k := by
///     simp [Sable.Seq.get_set, hki, hkh]
///   rw [hgi, hgk]
///   omega

// Right of the pivot: slot hi-1 now holds the old a[i] (≥ pivot), the
// rest of (result, hi) is the ≥-pivot window, untouched by the swap.
/// discharge partition.post.k_result_k_k_hi_a_get_result_a_get_k by
///   intro k hk0 hk1
///   have hgi : ((a.set i (a.get (hi - 1))).set (hi - 1) (a.get i)).get result
///       = _old_a.get (hi - 1) := by
///     by_cases hih : i = hi - 1
///     · simp [Sable.Seq.get_set, h_result, hih]
///       exact h_inv_a_get_h_pivot
///     · simp [Sable.Seq.get_set, h_result, hih]
///       exact h_inv_a_get_h_pivot
///   rw [hgi]
///   by_cases hkh : k = hi - 1
///   · simp [Sable.Seq.get_set, hkh]
///     exact h_inv_k_i_k_k_j_pivot_a_get_k i (by omega) (by omega)
///   · have hki : ¬ k = i := by omega
///     simp [Sable.Seq.get_set, hkh, hki]
///     exact h_inv_k_i_k_k_j_pivot_a_get_k k (by omega) (by omega)

// The final swap is one more permutation step.
/// discharge partition.post.perm_a_old_a by
///   exact Sable.Seq.perm_trans
///     (Sable.Seq.perm_swap a i (hi - 1) (by omega) (by omega) (by omega) (by omega))
///     h_inv_perm_a_old_a

// Bound preservation across the final swap.
/// discharge partition.post.b_k_lo_k_k_hi_b_old_a_get_k_k_lo_k_k_hi by
///   intro b hb k hk0 hk1
///   have hbi : b ≤ a.get i := h_inv_b_k_lo_k_k_hi_b_old_a_ge b hb i (by omega) (by omega)
///   have hbh : b ≤ a.get (hi - 1) :=
///     h_inv_b_k_lo_k_k_hi_b_old_a_ge b hb (hi - 1) (by omega) (by omega)
///   have hbk : b ≤ a.get k := h_inv_b_k_lo_k_k_hi_b_old_a_ge b hb k hk0 hk1
///   simp [Sable.Seq.get_set]
///   by_cases hkh : k = hi - 1
///   · simp [hkh]
///     exact hbi
///   · simp [hkh]
///     by_cases hki : k = i
///     · simp [hki]
///       exact hbh
///     · simp [hki]
///       exact hbk

/// discharge partition.post.b_k_lo_k_k_hi_old_a_get_k_b_k_lo_k_k_hi by
///   intro b hb k hk0 hk1
///   have hbi : a.get i ≤ b := h_inv_b_k_lo_k_k_hi_old_a_get b hb i (by omega) (by omega)
///   have hbh : a.get (hi - 1) ≤ b :=
///     h_inv_b_k_lo_k_k_hi_old_a_get b hb (hi - 1) (by omega) (by omega)
///   have hbk : a.get k ≤ b := h_inv_b_k_lo_k_k_hi_old_a_get b hb k hk0 hk1
///   simp [Sable.Seq.get_set]
///   by_cases hkh : k = hi - 1
///   · simp [hkh]
///     exact hbi
///   · simp [hkh]
///     by_cases hki : k = i
///     · simp [hki]
///       exact hbh
///     · simp [hki]
///       exact hbk

// --- quicksort_range: composing the recursive calls' posts ---
// The body threads four symbolic array states:
//   _old_a --partition--> _arr1 (pivot slot p)
//          --left rec-->  _arr3   (posts: h_quicksort_range_post_*)
//          --right rec--> _arr5   (posts: h_quicksort_range_post_*_2)
// Each call's frame post relates consecutive states only, so the posts
// about the final state _arr5 need transitive composition along the
// chain. The three length-preservation facts are all named `h_a_len`
// (the later ones shadow the earlier), so the shadowed ones are
// recovered by type with `assumption`.

// Sortedness of [lo, hi): left half comes from the left recursion's
// sortedRange carried across the right recursion's frame; right half is
// the right recursion's own post; across the pivot, partition's
// "≤ pivot / ≥ pivot" facts survive via the recursions' bound-
// preservation posts (left) and frame + bound posts (right), with the
// pivot value itself pinned by both frames: _arr5[p] = _arr3[p] =
// _arr1[p].
/// discharge quicksort_range.post.sortedrange_a_lo_hi by
///   have hlen53 : (_arr5).len = (_arr3).len := by assumption
///   have hlen31 : (_arr3).len = (_arr1).len := by assumption
///   have hlen10 : (_arr1).len = (_old_a).len := by assumption
///   have hLle : ∀ k, lo ≤ k → k < p → (_arr3).get k ≤ (_arr1).get p :=
///     h_quicksort_range_post_b_k_lo_k_k_hi_old_a_get ((_arr1).get p)
///       h_partition_post_k_lo_k_k_result_a_get_k
///   have hp53 : (_arr5).get p = (_arr1).get p := by
///     have h1 : (_arr5).get p = (_arr3).get p :=
///       h_quicksort_range_post_k_0_k_k_a_len_k_lo_hi_k_2 p (by omega) (by omega) (by omega)
///     have h2 : (_arr3).get p = (_arr1).get p :=
///       h_quicksort_range_post_k_0_k_k_a_len_k_lo_hi_k p (by omega) (by omega) (by omega)
///     rw [h1, h2]
///   have hRge0 : ∀ k, p + 1 ≤ k → k < hi → (_arr1).get p ≤ (_arr3).get k := by
///     intro k hk1 hk2
///     have h31 : (_arr3).get k = (_arr1).get k :=
///       h_quicksort_range_post_k_0_k_k_a_len_k_lo_hi_k k (by omega) (by omega) (by omega)
///     rw [h31]
///     exact h_partition_post_k_result_k_k_hi_a_get_re k (by omega) hk2
///   have hRge : ∀ k, p + 1 ≤ k → k < hi → (_arr1).get p ≤ (_arr5).get k :=
///     h_quicksort_range_post_b_k_lo_k_k_hi_b_old_a_ge_2 ((_arr1).get p) hRge0
///   intro x y hx0 hxy hyhi
///   by_cases hyr : y ≤ p
///   · have hx5 : (_arr5).get x = (_arr3).get x :=
///       h_quicksort_range_post_k_0_k_k_a_len_k_lo_hi_k_2 x (by omega) (by omega) (by omega)
///     have hy5 : (_arr5).get y = (_arr3).get y :=
///       h_quicksort_range_post_k_0_k_k_a_len_k_lo_hi_k_2 y (by omega) (by omega) (by omega)
///     rw [hx5, hy5]
///     by_cases hyp : y = p
///     · have h2 : (_arr3).get p = (_arr1).get p :=
///         h_quicksort_range_post_k_0_k_k_a_len_k_lo_hi_k p (by omega) (by omega) (by omega)
///       rw [hyp, h2]
///       exact hLle x hx0 (by omega)
///     · exact h_quicksort_range_post_sortedrange_a_lo_hi x y hx0 hxy (by omega)
///   · by_cases hxr : x ≤ p
///     · have hyge : (_arr1).get p ≤ (_arr5).get y := hRge y (by omega) hyhi
///       have hxle : (_arr5).get x ≤ (_arr1).get p := by
///         by_cases hxeq : x = p
///         · rw [hxeq, hp53]
///           omega
///         · have hx5 : (_arr5).get x = (_arr3).get x :=
///             h_quicksort_range_post_k_0_k_k_a_len_k_lo_hi_k_2 x (by omega) (by omega) (by omega)
///           rw [hx5]
///           exact hLle x hx0 (by omega)
///       omega
///     · exact h_quicksort_range_post_sortedrange_a_lo_hi_2 x y (by omega) hxy hyhi

// Permutation: chain the three per-call perms transitively.
/// discharge quicksort_range.post.perm_a_old_a by
///   exact Sable.Seq.perm_trans h_quicksort_range_post_perm_a_old_a_2
///     (Sable.Seq.perm_trans h_quicksort_range_post_perm_a_old_a
///       h_partition_post_perm_a_old_a)

// Frame: outside [lo, hi) each of the three steps leaves the slot
// alone; rewrite through the chain of pointwise equalities.
/// discharge quicksort_range.post.k_0_k_k_a_len_k_lo_hi_k_a_get_k_old_a_ge by
///   have hlen53 : (_arr5).len = (_arr3).len := by assumption
///   have hlen31 : (_arr3).len = (_arr1).len := by assumption
///   have hlen10 : (_arr1).len = (_old_a).len := by assumption
///   intro k hk0 hk1 hk2
///   have h53 : (_arr5).get k = (_arr3).get k :=
///     h_quicksort_range_post_k_0_k_k_a_len_k_lo_hi_k_2 k hk0 hk1 (by omega)
///   have h31 : (_arr3).get k = (_arr1).get k :=
///     h_quicksort_range_post_k_0_k_k_a_len_k_lo_hi_k k hk0 (by omega) (by omega)
///   have h10 : (_arr1).get k = (_old_a).get k :=
///     h_partition_post_k_0_k_k_a_len_k_lo_hi_k k hk0 (by omega) (by omega)
///   rw [h53, h31, h10]

// Lower-bound preservation over [lo, hi): push the bound through
// partition, then through the left recursion on [lo, p) (slots in
// [p, hi) unchanged by its frame), then through the right recursion
// on [p+1, hi) (slots in [lo, p] unchanged by its frame).
/// discharge quicksort_range.post.b_k_lo_k_k_hi_b_old_a_get_k_k_lo_k_k_hi by
///   have hlen53 : (_arr5).len = (_arr3).len := by assumption
///   have hlen31 : (_arr3).len = (_arr1).len := by assumption
///   have hlen10 : (_arr1).len = (_old_a).len := by assumption
///   intro b hb
///   have hb1 : ∀ k, lo ≤ k → k < hi → b ≤ (_arr1).get k :=
///     h_partition_post_b_k_lo_k_k_hi_b_old_a_ge b hb
///   have hbL : ∀ k, lo ≤ k → k < p → b ≤ (_arr1).get k := by
///     intro k hk1 hk2
///     exact hb1 k hk1 (by omega)
///   have hb3L : ∀ k, lo ≤ k → k < p → b ≤ (_arr3).get k :=
///     h_quicksort_range_post_b_k_lo_k_k_hi_b_old_a_ge b hbL
///   have hb3 : ∀ k, lo ≤ k → k < hi → b ≤ (_arr3).get k := by
///     intro k hk1 hk2
///     by_cases hkr : k < p
///     · exact hb3L k hk1 hkr
///     · have h31 : (_arr3).get k = (_arr1).get k :=
///         h_quicksort_range_post_k_0_k_k_a_len_k_lo_hi_k k (by omega) (by omega) (by omega)
///       rw [h31]
///       exact hb1 k hk1 hk2
///   have hbR : ∀ k, p + 1 ≤ k → k < hi → b ≤ (_arr3).get k := by
///     intro k hk1 hk2
///     exact hb3 k (by omega) hk2
///   have hb5R : ∀ k, p + 1 ≤ k → k < hi → b ≤ (_arr5).get k :=
///     h_quicksort_range_post_b_k_lo_k_k_hi_b_old_a_ge_2 b hbR
///   intro k hk1 hk2
///   by_cases hkr : k < p + 1
///   · have h53 : (_arr5).get k = (_arr3).get k :=
///       h_quicksort_range_post_k_0_k_k_a_len_k_lo_hi_k_2 k (by omega) (by omega) (by omega)
///     rw [h53]
///     exact hb3 k hk1 hk2
///   · exact hb5R k (by omega) hk2

// Upper-bound preservation, symmetric.
/// discharge quicksort_range.post.b_k_lo_k_k_hi_old_a_get_k_b_k_lo_k_k_hi by
///   have hlen53 : (_arr5).len = (_arr3).len := by assumption
///   have hlen31 : (_arr3).len = (_arr1).len := by assumption
///   have hlen10 : (_arr1).len = (_old_a).len := by assumption
///   intro b hb
///   have hb1 : ∀ k, lo ≤ k → k < hi → (_arr1).get k ≤ b :=
///     h_partition_post_b_k_lo_k_k_hi_old_a_get b hb
///   have hbL : ∀ k, lo ≤ k → k < p → (_arr1).get k ≤ b := by
///     intro k hk1 hk2
///     exact hb1 k hk1 (by omega)
///   have hb3L : ∀ k, lo ≤ k → k < p → (_arr3).get k ≤ b :=
///     h_quicksort_range_post_b_k_lo_k_k_hi_old_a_get b hbL
///   have hb3 : ∀ k, lo ≤ k → k < hi → (_arr3).get k ≤ b := by
///     intro k hk1 hk2
///     by_cases hkr : k < p
///     · exact hb3L k hk1 hkr
///     · have h31 : (_arr3).get k = (_arr1).get k :=
///         h_quicksort_range_post_k_0_k_k_a_len_k_lo_hi_k k (by omega) (by omega) (by omega)
///       rw [h31]
///       exact hb1 k hk1 hk2
///   have hbR : ∀ k, p + 1 ≤ k → k < hi → (_arr3).get k ≤ b := by
///     intro k hk1 hk2
///     exact hb3 k (by omega) hk2
///   have hb5R : ∀ k, p + 1 ≤ k → k < hi → (_arr5).get k ≤ b :=
///     h_quicksort_range_post_b_k_lo_k_k_hi_old_a_get_2 b hbR
///   intro k hk1 hk2
///   by_cases hkr : k < p + 1
///   · have h53 : (_arr5).get k = (_arr3).get k :=
///       h_quicksort_range_post_k_0_k_k_a_len_k_lo_hi_k_2 k (by omega) (by omega) (by omega)
///     rw [h53]
///     exact hb3 k hk1 hk2
///   · exact hb5R k (by omega) hk2
