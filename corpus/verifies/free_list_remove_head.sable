// U8f5: remove the first stored node while keeping the runtime head separate
// from erased allocator authority. The extracted header is cleared back into
// the exact allocator-internal byte extent; leasing/splitting remains policy
// for the next layer.

pub class FreeListState {
    u64 head;
    u64 limit;

    /// invariant head <= limit

    /// pre head <= limit
    /// post self.head = head ∧ self.limit = limit
    init make(u64 head, u64 limit) {
        self.head = head;
        self.limit = limit;
    }

    /// pre next <= self.limit
    /// post self.head = next ∧ self.limit = old self.limit
    fn advance(&mut self, u64 next) {
        self.head = next;
    }
}

/// pre  #[label(base)] base.alloc = state.root.alloc ∧ base.off = 0
/// pre  #[label(limit)] list.limit = state.root.len
/// pre  #[label(chain)]
///        Sable.AllocatorView.StoredChain state list.limit list.head
/// pre  #[label(nonempty)] list.head != list.limit
/// pre  #[label(node)] ∃ header,
///        state.storesHeader list.head header ∧
///        header.hasFields size next
/// post #[label(limit_frame)] list.limit = (old list).limit
/// post #[label(head)] list.head = next
/// post #[label(transition)] state =
///        (old state).takeHeader (old list).head
/// post #[label(chain)]
///        Sable.AllocatorView.StoredChain state list.limit list.head
/// post #[label(removed)] result.key = (old list).head ∧
///        result.span.len = size
/// post #[label(owner)] result.allocator = state.allocator
/// post #[label(root)] result.span.alloc = state.root.alloc
pub fn free_list_remove_head(raw<u8> base,
                             &mut FreeListState list,
                             resource &mut AllocatorState state,
                             u64 size, u64 next)
                             -> resource FreeBlock {
    u64 current = list.head;
    u64 limit = list.limit;
    mut resource FreeHeader node =
        allocator_step_header(&mut state, limit, current);
    unsafe {
        raw<u8> node_ptr = raw_offset(base, current);
        raw_header_clear(node_ptr, &mut node);
        resource FreeBlock block = raw_from_free_header(node_ptr, node);
    }
    list.advance(next);
    return block;
}

/// discharge free_list_remove_head.free_header.clear by
///   obtain ⟨header, hstored, hfields⟩ := h_pre_node
///   have hnode : _header2 = header := by
///     rw [h_header2_step,
///       Sable.AllocatorView.storesHeader_headerAt hstored]
///   have hwf := hstored.2.2.2.1
///   unfold Sable.FreeHeaderView.wf at hwf
///   obtain ⟨hsizewf, _, hkeyoff, halloc, _, hoff, _, _⟩ := hwf
///   have hlayout : header.sizeCell.layout = Sable.u64.layout :=
///     hsizewf.1
///   rw [hnode]
///   constructor
///   · unfold Sable.PointsToView.names
///     constructor
///     · calc
///         (Sable.RawPtr.add base _old_list.head).alloc = base.alloc := rfl
///         _ = _old_state.root.alloc := h_pre_base.1
///         _ = header.sizeCell.alloc := hstored.2.2.2.2.2.symm
///     · calc
///         (Sable.RawPtr.add base _old_list.head).off =
///             base.off + _old_list.head := rfl
///         _ = _old_list.head := by rw [h_pre_base.2]; omega
///         _ = header.key := hstored.2.2.1.symm
///         _ = header.sizeCell.off := hkeyoff
///   constructor
///   · rw [hfields.1]
///     simp
///   constructor
///   · calc
///       header.nextCell.alloc = header.sizeCell.alloc := halloc.symm
///       _ = _old_state.root.alloc := hstored.2.2.2.2.2
///       _ = base.alloc := h_pre_base.1.symm
///       _ = (Sable.RawPtr.add base _old_list.head).alloc := rfl
///   constructor
///   · calc
///       header.nextCell.off =
///           header.sizeCell.off + header.sizeCell.layout.size := hoff.symm
///       _ = header.key + Sable.u64.layout.size := by
///         rw [← hkeyoff, hlayout]
///       _ = _old_list.head + Sable.u64.layout.size := by
///         rw [hstored.2.2.1]
///       _ = (Sable.RawPtr.add base _old_list.head).off +
///           Sable.u64.layout.size := by
///         rw [Sable.RawPtr.add_off, h_pre_base.2]
///         omega
///   · rw [hfields.2]
///     simp

/// discharge free_list_remove_head.free_header.to_block by
///   rw [h_node_clear]
///   constructor
///   · simpa [Sable.FreeHeaderView.clearFields,
///       Sable.PointsToView.names] using
///       h_fact_sable_pointstoview_names.1
///   constructor
///   · simp [Sable.FreeHeaderView.clearFields]
///   constructor
///   · simpa [Sable.FreeHeaderView.clearFields] using
///       h_fact_sable_pointstoview_names.2.2.1
///   constructor
///   · simpa [Sable.FreeHeaderView.clearFields] using
///       h_fact_sable_pointstoview_names.2.2.2.1
///   · simp [Sable.FreeHeaderView.clearFields]

/// discharge free_list_remove_head.call_pre.FreeListState_advance.next_self_limit by
///   obtain ⟨header, hstored, hfields⟩ := h_pre_node
///   have hmatch := Sable.AllocatorView.StoredChain.takeMatchingHead
///     h_pre_chain (by omega) hstored hfields
///   exact hmatch.2.2.2.2.1

/// discharge free_list_remove_head.post.chain by
///   obtain ⟨header, hstored, hfields⟩ := h_pre_node
///   have hmatch := Sable.AllocatorView.StoredChain.takeMatchingHead
///     h_pre_chain (by omega) hstored hfields
///   rw [h_state_step_header,
///     h_FreeListState_advance_post_self_head_next_self_limi.1,
///     h_FreeListState_advance_post_self_head_next_self_limi.2]
///   exact hmatch.2.2.2.2.2

/// discharge free_list_remove_head.post.transition by
///   rw [h_state_step_header]

/// discharge free_list_remove_head.post.removed by
///   obtain ⟨header, hstored, hfields⟩ := h_pre_node
///   have hmatch := Sable.AllocatorView.StoredChain.takeMatchingHead
///     h_pre_chain (by omega) hstored hfields
///   have hnode : _header2 = header := by
///     rw [h_header2_step,
///       Sable.AllocatorView.storesHeader_headerAt hstored]
///   constructor
///   · rw [h_result, h_free4_block, h_node_clear, hnode]
///     exact hstored.2.2.1
///   · rw [h_result, h_free4_block, h_node_clear, hnode,
///       Sable.FreeHeaderView.clearFields_toFree_span_len]
///     exact hmatch.1

/// discharge free_list_remove_head.post.owner by
///   rw [h_result, h_free4_block, h_node_clear]
///   exact h_header2_owner

/// discharge free_list_remove_head.post.root by
///   obtain ⟨header, hstored, hfields⟩ := h_pre_node
///   have hnode : _header2 = header := by
///     rw [h_header2_step,
///       Sable.AllocatorView.storesHeader_headerAt hstored]
///   rw [h_result, h_free4_block, h_node_clear, hnode]
///   calc
///     header.sizeCell.alloc = _old_state.root.alloc :=
///       hstored.2.2.2.2.2
///     _ = state.root.alloc := by rw [h_state_step_header]; rfl
