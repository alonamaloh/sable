// The UTF-8 codec. The encoder is specified against
// ghost byte maps (utf8_b0..utf8_b3, if-chains over division by
// CONSTANTS — omega's fragment once split); the decoder returns a value
// equal to the ghost byte-level decoder applied to the input bytes
// (junk-tolerant: arguments past the length class are ignored), plus a
// completeness post — canonical bytes never decode to `none`. The
// program-level roundtrip then follows from one ghost theorem,
// utf8_decode_encode. Validation (continuation ranges, overlong forms,
// surrogates, the 0x10FFFF ceiling) is real: RFC 3629 byte classes.

/// def utf8_len (cp : int) : int := if cp < 128 then 1 else if cp < 2048 then 2 else if cp < 65536 then 3 else 4

/// def utf8_b0 (cp : int) : int := if cp < 128 then cp else if cp < 2048 then 192 + cp / 64 else if cp < 65536 then 224 + cp / 4096 else 240 + cp / 262144

/// def utf8_b1 (cp : int) : int := if cp < 2048 then 128 + cp % 64 else if cp < 65536 then 128 + (cp / 64) % 64 else 128 + (cp / 4096) % 64

/// def utf8_b2 (cp : int) : int := if cp < 65536 then 128 + cp % 64 else 128 + (cp / 64) % 64

/// def utf8_b3 (cp : int) : int := 128 + cp % 64

/// def utf8_decode (b0 b1 b2 b3 : int) : int := if b0 < 128 then b0 else if b0 < 224 then (b0 - 192) * 64 + (b1 - 128) else if b0 < 240 then (b0 - 224) * 4096 + (b1 - 128) * 64 + (b2 - 128) else (b0 - 240) * 262144 + (b1 - 128) * 4096 + (b2 - 128) * 64 + (b3 - 128)

/// def scalar (cp : int) : Prop := 0 ≤ cp ∧ cp ≤ 1114111 ∧ (cp < 55296 ∨ cp > 57343)

/// theorem utf8_b0_range (cp : int) (h : scalar cp) :
///     0 ≤ utf8_b0 cp ∧ utf8_b0 cp ≤ 255 := by
///   unfold scalar at h
///   unfold utf8_b0
///   repeat (first | omega | split)

/// theorem utf8_b1_range (cp : int) (h : scalar cp) :
///     128 ≤ utf8_b1 cp ∧ utf8_b1 cp ≤ 191 := by
///   unfold scalar at h
///   unfold utf8_b1
///   repeat (first | omega | split)

/// theorem utf8_b2_range (cp : int) (h : scalar cp) :
///     128 ≤ utf8_b2 cp ∧ utf8_b2 cp ≤ 191 := by
///   unfold scalar at h
///   unfold utf8_b2
///   repeat (first | omega | split)

/// theorem utf8_b3_range (cp : int) (h : scalar cp) :
///     128 ≤ utf8_b3 cp ∧ utf8_b3 cp ≤ 191 := by
///   unfold scalar at h
///   unfold utf8_b3
///   omega

/// theorem utf8_decode_encode (cp : int) (h : scalar cp) :
///     utf8_decode (utf8_b0 cp) (utf8_b1 cp) (utf8_b2 cp) (utf8_b3 cp) = cp := by
///   unfold scalar at h
///   unfold utf8_decode utf8_b0 utf8_b1 utf8_b2 utf8_b3
///   repeat (first | omega | split)

/// theorem utf8_decode_encode2 (cp g1 g2 g3 : int) (h : scalar cp)
///     (h1 : 2 ≤ utf8_len cp → g1 = utf8_b1 cp)
///     (h2 : 3 ≤ utf8_len cp → g2 = utf8_b2 cp)
///     (h3 : utf8_len cp = 4 → g3 = utf8_b3 cp) :
///     utf8_decode (utf8_b0 cp) g1 g2 g3 = cp := by
///   unfold scalar at h
///   unfold utf8_len at h1 h2 h3
///   unfold utf8_decode utf8_b0 utf8_b1 utf8_b2 utf8_b3 at *
///   repeat (first | omega | split | split at h1 | split at h2 | split at h3)

/// pre  scalar cp
/// pre  out.len ≥ 4
/// post result = utf8_len cp
/// post out.get 0 = utf8_b0 cp
/// post 2 ≤ utf8_len cp → out.get 1 = utf8_b1 cp
/// post 3 ≤ utf8_len cp → out.get 2 = utf8_b2 cp
/// post utf8_len cp = 4 → out.get 3 = utf8_b3 cp
/// post ∀ k, utf8_len cp ≤ k → k < out.len → out.get k = (old out).get k
fn encode_utf8(u32 cp, &mut [u8] out) -> u64 {
    if (cp < 128) {
        out[0] = narrow<u8>(cp);
        return 1;
    }
    if (cp < 2048) {
        out[0] = narrow<u8>(192 + cp / 64);
        out[1] = narrow<u8>(128 + cp % 64);
        return 2;
    }
    if (cp < 65536) {
        out[0] = narrow<u8>(224 + cp / 4096);
        out[1] = narrow<u8>(128 + (cp / 64) % 64);
        out[2] = narrow<u8>(128 + cp % 64);
        return 3;
    }
    out[0] = narrow<u8>(240 + cp / 262144);
    out[1] = narrow<u8>(128 + (cp / 4096) % 64);
    out[2] = narrow<u8>(128 + (cp / 64) % 64);
    out[3] = narrow<u8>(128 + cp % 64);
    return 4;
}

/// pre  pos < b.len
/// pre  b.len ≤ 4611686018427387904
/// post match result with
///      | some v => scalar v ∧ v = utf8_decode (b.get pos) (b.get (pos + 1)) (b.get (pos + 2)) (b.get (pos + 3))
///      | none   => True
/// post (∃ cp2, scalar cp2 ∧ pos + utf8_len cp2 ≤ b.len ∧ b.get pos = utf8_b0 cp2 ∧ (2 ≤ utf8_len cp2 → b.get (pos + 1) = utf8_b1 cp2) ∧ (3 ≤ utf8_len cp2 → b.get (pos + 2) = utf8_b2 cp2) ∧ (utf8_len cp2 = 4 → b.get (pos + 3) = utf8_b3 cp2)) → result ≠ none
fn decode_utf8(&[u8] b, u64 pos) -> option<u32> {
    u8 b0 = b[pos];
    if (b0 < 128) {
        return some(widen<u32>(b0));
    }
    if (b0 >= 194 && b0 <= 223) {
        if (pos + 1 >= b.len) {
            return none;
        }
        u8 b1 = b[pos + 1];
        if (b1 < 128 || b1 > 191) {
            return none;
        }
        u32 v = (widen<u32>(b0) - 192) * 64 + (widen<u32>(b1) - 128);
        return some(v);
    }
    if (b0 >= 224 && b0 <= 239) {
        if (pos + 2 >= b.len) {
            return none;
        }
        u8 c1 = b[pos + 1];
        u8 c2 = b[pos + 2];
        if (c1 < 128 || c1 > 191) {
            return none;
        }
        if (c2 < 128 || c2 > 191) {
            return none;
        }
        if (b0 == 224 && c1 < 160) {
            return none;
        }
        if (b0 == 237 && c1 > 159) {
            return none;
        }
        u32 w = (widen<u32>(b0) - 224) * 4096 + (widen<u32>(c1) - 128) * 64 + (widen<u32>(c2) - 128);
        return some(w);
    }
    if (b0 >= 240 && b0 <= 244) {
        if (pos + 3 >= b.len) {
            return none;
        }
        u8 d1 = b[pos + 1];
        u8 d2 = b[pos + 2];
        u8 d3 = b[pos + 3];
        if (d1 < 128 || d1 > 191) {
            return none;
        }
        if (d2 < 128 || d2 > 191) {
            return none;
        }
        if (d3 < 128 || d3 > 191) {
            return none;
        }
        if (b0 == 240 && d1 < 144) {
            return none;
        }
        if (b0 == 244 && d1 > 143) {
            return none;
        }
        u32 u = (widen<u32>(b0) - 240) * 262144 + (widen<u32>(d1) - 128) * 4096 + (widen<u32>(d2) - 128) * 64 + (widen<u32>(d3) - 128);
        return some(u);
    }
    return none;
}


// Buffer-level validation. `utf8_step` classifies one position: 0 for
// invalid, else the sequence length — with an existential canonicity
// post (there IS a scalar value whose canonical bytes sit at pos).
// `validFrom` is the well-founded ghost predicate "decomposable into
// canonical scalar encodings from pos on"; the scanner carries the
// classic forward-scan invariant `validFrom b pos → validFrom b 0`.

/// def validFrom (b : Sable.Seq Int) (pos : int) : Prop :=
///   if b.len ≤ pos then True
///   else ∃ cp, scalar cp ∧ pos + utf8_len cp ≤ b.len ∧
///     b.get pos = utf8_b0 cp ∧
///     (2 ≤ utf8_len cp → b.get (pos + 1) = utf8_b1 cp) ∧
///     (3 ≤ utf8_len cp → b.get (pos + 2) = utf8_b2 cp) ∧
///     (utf8_len cp = 4 → b.get (pos + 3) = utf8_b3 cp) ∧
///     validFrom b (pos + utf8_len cp)
/// termination_by (b.len - pos).toNat
/// decreasing_by
///   unfold utf8_len
///   repeat (first | omega | split)

/// theorem validFrom_step (b : Sable.Seq Int) (pos cp : int)
///     (hpos : pos < b.len)
///     (hs : scalar cp) (hlen : pos + utf8_len cp ≤ b.len)
///     (h0 : b.get pos = utf8_b0 cp)
///     (h1 : 2 ≤ utf8_len cp → b.get (pos + 1) = utf8_b1 cp)
///     (h2 : 3 ≤ utf8_len cp → b.get (pos + 2) = utf8_b2 cp)
///     (h3 : utf8_len cp = 4 → b.get (pos + 3) = utf8_b3 cp)
///     (hrest : validFrom b (pos + utf8_len cp)) :
///     validFrom b pos := by
///   rw [validFrom]
///   rw [if_neg (by omega)]
///   exact ⟨cp, hs, hlen, h0, h1, h2, h3, hrest⟩

/// theorem validFrom_end (b : Sable.Seq Int) (pos : int) (h : b.len ≤ pos) :
///     validFrom b pos := by
///   rw [validFrom]
///   rw [if_pos h]
///   trivial

// `validScan` is the byte-table form of the same property: a forward
// scan over RFC 3629's lead/continuation ranges, with no existential —
// so it lies in the monitorable fragment and, on a literal's concrete
// bytes, discharges by `simp` unfolding alone. `validScan_sound` ties
// it to the canonical predicate: every scan-accepted buffer is
// decomposable into scalar encodings. String's class invariant speaks
// validScan; consumers reach validFrom through the lemma.

/// def validScan (b : Sable.Seq Int) (pos : int) : Prop :=
///   if b.len ≤ pos then True
///   else if 0 ≤ b.get pos ∧ b.get pos ≤ 127 then validScan b (pos + 1)
///   else if 194 ≤ b.get pos ∧ b.get pos ≤ 223 then
///     pos + 2 ≤ b.len ∧ 128 ≤ b.get (pos + 1) ∧ b.get (pos + 1) ≤ 191 ∧ validScan b (pos + 2)
///   else if b.get pos = 224 then
///     pos + 3 ≤ b.len ∧ 160 ≤ b.get (pos + 1) ∧ b.get (pos + 1) ≤ 191 ∧
///       128 ≤ b.get (pos + 2) ∧ b.get (pos + 2) ≤ 191 ∧ validScan b (pos + 3)
///   else if 225 ≤ b.get pos ∧ b.get pos ≤ 236 then
///     pos + 3 ≤ b.len ∧ 128 ≤ b.get (pos + 1) ∧ b.get (pos + 1) ≤ 191 ∧
///       128 ≤ b.get (pos + 2) ∧ b.get (pos + 2) ≤ 191 ∧ validScan b (pos + 3)
///   else if b.get pos = 237 then
///     pos + 3 ≤ b.len ∧ 128 ≤ b.get (pos + 1) ∧ b.get (pos + 1) ≤ 159 ∧
///       128 ≤ b.get (pos + 2) ∧ b.get (pos + 2) ≤ 191 ∧ validScan b (pos + 3)
///   else if 238 ≤ b.get pos ∧ b.get pos ≤ 239 then
///     pos + 3 ≤ b.len ∧ 128 ≤ b.get (pos + 1) ∧ b.get (pos + 1) ≤ 191 ∧
///       128 ≤ b.get (pos + 2) ∧ b.get (pos + 2) ≤ 191 ∧ validScan b (pos + 3)
///   else if b.get pos = 240 then
///     pos + 4 ≤ b.len ∧ 144 ≤ b.get (pos + 1) ∧ b.get (pos + 1) ≤ 191 ∧
///       128 ≤ b.get (pos + 2) ∧ b.get (pos + 2) ≤ 191 ∧
///       128 ≤ b.get (pos + 3) ∧ b.get (pos + 3) ≤ 191 ∧ validScan b (pos + 4)
///   else if 241 ≤ b.get pos ∧ b.get pos ≤ 243 then
///     pos + 4 ≤ b.len ∧ 128 ≤ b.get (pos + 1) ∧ b.get (pos + 1) ≤ 191 ∧
///       128 ≤ b.get (pos + 2) ∧ b.get (pos + 2) ≤ 191 ∧
///       128 ≤ b.get (pos + 3) ∧ b.get (pos + 3) ≤ 191 ∧ validScan b (pos + 4)
///   else if b.get pos = 244 then
///     pos + 4 ≤ b.len ∧ 128 ≤ b.get (pos + 1) ∧ b.get (pos + 1) ≤ 143 ∧
///       128 ≤ b.get (pos + 2) ∧ b.get (pos + 2) ≤ 191 ∧
///       128 ≤ b.get (pos + 3) ∧ b.get (pos + 3) ≤ 191 ∧ validScan b (pos + 4)
///   else False
/// termination_by (b.len - pos).toNat
/// decreasing_by all_goals omega

// Conditional step lemmas: simp applies one only when the byte-range
// side conditions discharge — so a literal's concrete bytes unfold the
// scan automatically, while an abstract `validScan` hypothesis (a
// String invariant in scope, say) is left untouched.

/// theorem #[unfold] validScan_done (b : Sable.Seq Int) (pos : int)
///     (h : b.len ≤ pos) : validScan b pos ↔ True := by
///   rw [validScan, if_pos h]

/// theorem #[unfold] validScan_ascii (b : Sable.Seq Int) (pos : int)
///     (hp : pos < b.len) (h1 : 0 ≤ b.get pos) (h2 : b.get pos ≤ 127) :
///     validScan b pos ↔ validScan b (pos + 1) := by
///   rw [validScan, if_neg (by omega), if_pos ⟨h1, h2⟩]

/// theorem #[unfold] validScan_two (b : Sable.Seq Int) (pos : int)
///     (hp : pos < b.len) (h1 : 194 ≤ b.get pos) (h2 : b.get pos ≤ 223) :
///     validScan b pos ↔
///       pos + 2 ≤ b.len ∧ 128 ≤ b.get (pos + 1) ∧ b.get (pos + 1) ≤ 191 ∧ validScan b (pos + 2) := by
///   rw [validScan, if_neg (by omega), if_neg (by omega), if_pos ⟨h1, h2⟩]

/// theorem #[unfold] validScan_e0 (b : Sable.Seq Int) (pos : int)
///     (hp : pos < b.len) (h1 : b.get pos = 224) :
///     validScan b pos ↔
///       pos + 3 ≤ b.len ∧ 160 ≤ b.get (pos + 1) ∧ b.get (pos + 1) ≤ 191 ∧
///         128 ≤ b.get (pos + 2) ∧ b.get (pos + 2) ≤ 191 ∧ validScan b (pos + 3) := by
///   rw [validScan, if_neg (by omega), if_neg (by omega), if_neg (by omega), if_pos h1]

/// theorem #[unfold] validScan_three (b : Sable.Seq Int) (pos : int)
///     (hp : pos < b.len) (h1 : 225 ≤ b.get pos) (h2 : b.get pos ≤ 236) :
///     validScan b pos ↔
///       pos + 3 ≤ b.len ∧ 128 ≤ b.get (pos + 1) ∧ b.get (pos + 1) ≤ 191 ∧
///         128 ≤ b.get (pos + 2) ∧ b.get (pos + 2) ≤ 191 ∧ validScan b (pos + 3) := by
///   rw [validScan, if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega),
///      if_pos ⟨h1, h2⟩]

/// theorem #[unfold] validScan_ed (b : Sable.Seq Int) (pos : int)
///     (hp : pos < b.len) (h1 : b.get pos = 237) :
///     validScan b pos ↔
///       pos + 3 ≤ b.len ∧ 128 ≤ b.get (pos + 1) ∧ b.get (pos + 1) ≤ 159 ∧
///         128 ≤ b.get (pos + 2) ∧ b.get (pos + 2) ≤ 191 ∧ validScan b (pos + 3) := by
///   rw [validScan, if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega),
///      if_neg (by omega), if_pos h1]

/// theorem #[unfold] validScan_ee (b : Sable.Seq Int) (pos : int)
///     (hp : pos < b.len) (h1 : 238 ≤ b.get pos) (h2 : b.get pos ≤ 239) :
///     validScan b pos ↔
///       pos + 3 ≤ b.len ∧ 128 ≤ b.get (pos + 1) ∧ b.get (pos + 1) ≤ 191 ∧
///         128 ≤ b.get (pos + 2) ∧ b.get (pos + 2) ≤ 191 ∧ validScan b (pos + 3) := by
///   rw [validScan, if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega),
///      if_neg (by omega), if_neg (by omega), if_pos ⟨h1, h2⟩]

/// theorem #[unfold] validScan_f0 (b : Sable.Seq Int) (pos : int)
///     (hp : pos < b.len) (h1 : b.get pos = 240) :
///     validScan b pos ↔
///       pos + 4 ≤ b.len ∧ 144 ≤ b.get (pos + 1) ∧ b.get (pos + 1) ≤ 191 ∧
///         128 ≤ b.get (pos + 2) ∧ b.get (pos + 2) ≤ 191 ∧
///         128 ≤ b.get (pos + 3) ∧ b.get (pos + 3) ≤ 191 ∧ validScan b (pos + 4) := by
///   rw [validScan, if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega),
///      if_neg (by omega), if_neg (by omega), if_neg (by omega), if_pos h1]

/// theorem #[unfold] validScan_f13 (b : Sable.Seq Int) (pos : int)
///     (hp : pos < b.len) (h1 : 241 ≤ b.get pos) (h2 : b.get pos ≤ 243) :
///     validScan b pos ↔
///       pos + 4 ≤ b.len ∧ 128 ≤ b.get (pos + 1) ∧ b.get (pos + 1) ≤ 191 ∧
///         128 ≤ b.get (pos + 2) ∧ b.get (pos + 2) ≤ 191 ∧
///         128 ≤ b.get (pos + 3) ∧ b.get (pos + 3) ≤ 191 ∧ validScan b (pos + 4) := by
///   rw [validScan, if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega),
///      if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega), if_pos ⟨h1, h2⟩]

/// theorem #[unfold] validScan_f4 (b : Sable.Seq Int) (pos : int)
///     (hp : pos < b.len) (h1 : b.get pos = 244) :
///     validScan b pos ↔
///       pos + 4 ≤ b.len ∧ 128 ≤ b.get (pos + 1) ∧ b.get (pos + 1) ≤ 143 ∧
///         128 ≤ b.get (pos + 2) ∧ b.get (pos + 2) ≤ 191 ∧
///         128 ≤ b.get (pos + 3) ∧ b.get (pos + 3) ≤ 191 ∧ validScan b (pos + 4) := by
///   rw [validScan, if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega),
///      if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega),
///      if_neg (by omega), if_pos h1]

// Congruence: a byte-for-byte copy (on the in-range prefix) preserves
// the scan. Positions stay ≥ 0, so every read is in range.

/// theorem validScan_congr (a b : Sable.Seq Int) (pos : int)
///     (hlen : b.len = a.len)
///     (hget : ∀ k, 0 ≤ k → k < a.len → b.get k = a.get k)
///     (hpos : 0 ≤ pos)
///     (h : validScan a pos) : validScan b pos := by
///   fun_induction validScan a pos
///   case case1 pos hend => exact (validScan_done b pos (by omega)).mpr trivial
///   next pos hend hascii ih =>
///     rw [validScan_ascii b pos (by omega) (by rw [hget pos hpos (by omega)]; omega)
///       (by rw [hget pos hpos (by omega)]; omega)]
///     exact ih (by omega) h
///   next pos hend _ hc ih =>
///     obtain ⟨hL, h1, h2, hrest⟩ := h
///     rw [validScan_two b pos (by omega) (by rw [hget pos hpos (by omega)]; omega)
///       (by rw [hget pos hpos (by omega)]; omega)]
///     exact ⟨by omega, by rw [hget (pos+1) (by omega) (by omega)]; omega,
///       by rw [hget (pos+1) (by omega) (by omega)]; omega, ih (by omega) hrest⟩
///   next pos hend _ _ hc ih =>
///     obtain ⟨hL, h1, h2, h3, h4, hrest⟩ := h
///     rw [validScan_e0 b pos (by omega) (by rw [hget pos hpos (by omega)]; omega)]
///     exact ⟨by omega, by rw [hget (pos+1) (by omega) (by omega)]; omega,
///       by rw [hget (pos+1) (by omega) (by omega)]; omega,
///       by rw [hget (pos+2) (by omega) (by omega)]; omega,
///       by rw [hget (pos+2) (by omega) (by omega)]; omega, ih (by omega) hrest⟩
///   next pos hend _ _ _ hc ih =>
///     obtain ⟨hL, h1, h2, h3, h4, hrest⟩ := h
///     rw [validScan_three b pos (by omega) (by rw [hget pos hpos (by omega)]; omega)
///       (by rw [hget pos hpos (by omega)]; omega)]
///     exact ⟨by omega, by rw [hget (pos+1) (by omega) (by omega)]; omega,
///       by rw [hget (pos+1) (by omega) (by omega)]; omega,
///       by rw [hget (pos+2) (by omega) (by omega)]; omega,
///       by rw [hget (pos+2) (by omega) (by omega)]; omega, ih (by omega) hrest⟩
///   next pos hend _ _ _ _ hc ih =>
///     obtain ⟨hL, h1, h2, h3, h4, hrest⟩ := h
///     rw [validScan_ed b pos (by omega) (by rw [hget pos hpos (by omega)]; omega)]
///     exact ⟨by omega, by rw [hget (pos+1) (by omega) (by omega)]; omega,
///       by rw [hget (pos+1) (by omega) (by omega)]; omega,
///       by rw [hget (pos+2) (by omega) (by omega)]; omega,
///       by rw [hget (pos+2) (by omega) (by omega)]; omega, ih (by omega) hrest⟩
///   next pos hend _ _ _ _ _ hc ih =>
///     obtain ⟨hL, h1, h2, h3, h4, hrest⟩ := h
///     rw [validScan_ee b pos (by omega) (by rw [hget pos hpos (by omega)]; omega)
///       (by rw [hget pos hpos (by omega)]; omega)]
///     exact ⟨by omega, by rw [hget (pos+1) (by omega) (by omega)]; omega,
///       by rw [hget (pos+1) (by omega) (by omega)]; omega,
///       by rw [hget (pos+2) (by omega) (by omega)]; omega,
///       by rw [hget (pos+2) (by omega) (by omega)]; omega, ih (by omega) hrest⟩
///   next pos hend _ _ _ _ _ _ hc ih =>
///     obtain ⟨hL, h1, h2, h3, h4, h5, h6, hrest⟩ := h
///     rw [validScan_f0 b pos (by omega) (by rw [hget pos hpos (by omega)]; omega)]
///     exact ⟨by omega, by rw [hget (pos+1) (by omega) (by omega)]; omega,
///       by rw [hget (pos+1) (by omega) (by omega)]; omega,
///       by rw [hget (pos+2) (by omega) (by omega)]; omega,
///       by rw [hget (pos+2) (by omega) (by omega)]; omega,
///       by rw [hget (pos+3) (by omega) (by omega)]; omega,
///       by rw [hget (pos+3) (by omega) (by omega)]; omega, ih (by omega) hrest⟩
///   next pos hend _ _ _ _ _ _ _ hc ih =>
///     obtain ⟨hL, h1, h2, h3, h4, h5, h6, hrest⟩ := h
///     rw [validScan_f13 b pos (by omega) (by rw [hget pos hpos (by omega)]; omega)
///       (by rw [hget pos hpos (by omega)]; omega)]
///     exact ⟨by omega, by rw [hget (pos+1) (by omega) (by omega)]; omega,
///       by rw [hget (pos+1) (by omega) (by omega)]; omega,
///       by rw [hget (pos+2) (by omega) (by omega)]; omega,
///       by rw [hget (pos+2) (by omega) (by omega)]; omega,
///       by rw [hget (pos+3) (by omega) (by omega)]; omega,
///       by rw [hget (pos+3) (by omega) (by omega)]; omega, ih (by omega) hrest⟩
///   next pos hend _ _ _ _ _ _ _ _ hc ih =>
///     obtain ⟨hL, h1, h2, h3, h4, h5, h6, hrest⟩ := h
///     rw [validScan_f4 b pos (by omega) (by rw [hget pos hpos (by omega)]; omega)]
///     exact ⟨by omega, by rw [hget (pos+1) (by omega) (by omega)]; omega,
///       by rw [hget (pos+1) (by omega) (by omega)]; omega,
///       by rw [hget (pos+2) (by omega) (by omega)]; omega,
///       by rw [hget (pos+2) (by omega) (by omega)]; omega,
///       by rw [hget (pos+3) (by omega) (by omega)]; omega,
///       by rw [hget (pos+3) (by omega) (by omega)]; omega, ih (by omega) hrest⟩
///   next pos hend _ _ _ _ _ _ _ _ _ =>
///     exact absurd h (by simp)

/// theorem validScan_sound (b : Sable.Seq Int) (pos : int)
///     (h : validScan b pos) : validFrom b pos := by
///   fun_induction validScan b pos
///   case case1 pos hend => exact validFrom_end b pos (by omega)
///   next pos hend hascii ih =>
///     have hl : utf8_len (b.get pos) = 1 := by simp [utf8_len]; omega
///     refine validFrom_step b pos (b.get pos) (by omega) (by simp [scalar]; omega)
///       (by rw [hl]; omega) (by simp [utf8_b0]; omega)
///       (by rw [hl]; intro hx; omega) (by rw [hl]; intro hx; omega) (by rw [hl]; intro hx; omega)
///       ?_
///     rw [hl]; exact ih h
///   next pos hend _ hcond ih =>
///     obtain ⟨hL, ha, hb2, hrest⟩ := h
///     have hl2 : utf8_len ((b.get pos - 192) * 64 + (b.get (pos + 1) - 128)) = 2 := by
///       simp only [utf8_len]; repeat (first | omega | split)
///     refine validFrom_step b pos ((b.get pos - 192) * 64 + (b.get (pos + 1) - 128))
///       (by omega)
///       (by simp only [scalar]; omega)
///       (by rw [hl2]; omega)
///       (by simp only [utf8_b0]; repeat (first | omega | split))
///       (by rw [hl2]; intro _; simp only [utf8_b1]; repeat (first | omega | split))
///       (by rw [hl2]; intro _; simp only [utf8_b2]; repeat (first | omega | split))
///       (by rw [hl2]; intro _; simp only [utf8_b3]; repeat (first | omega | split))
///       (by rw [hl2]; exact ih hrest)
///   next pos hend _ _ hcond ih =>
///     obtain ⟨hL, ha, hb2, hc, hd, hrest⟩ := h
///     have hl3 : utf8_len ((b.get pos - 224) * 4096 + (b.get (pos + 1) - 128) * 64 + (b.get (pos + 2) - 128)) = 3 := by
///       simp only [utf8_len]; repeat (first | omega | split)
///     refine validFrom_step b pos ((b.get pos - 224) * 4096 + (b.get (pos + 1) - 128) * 64 + (b.get (pos + 2) - 128))
///       (by omega)
///       (by simp only [scalar]; omega)
///       (by rw [hl3]; omega)
///       (by simp only [utf8_b0]; repeat (first | omega | split))
///       (by rw [hl3]; intro _; simp only [utf8_b1]; repeat (first | omega | split))
///       (by rw [hl3]; intro _; simp only [utf8_b2]; repeat (first | omega | split))
///       (by rw [hl3]; intro hx; omega)
///       (by rw [hl3]; exact ih hrest)
///   next pos hend _ _ _ hcond ih =>
///     obtain ⟨hL, ha, hb2, hc, hd, hrest⟩ := h
///     have hl4 : utf8_len ((b.get pos - 224) * 4096 + (b.get (pos + 1) - 128) * 64 + (b.get (pos + 2) - 128)) = 3 := by
///       simp only [utf8_len]; repeat (first | omega | split)
///     refine validFrom_step b pos ((b.get pos - 224) * 4096 + (b.get (pos + 1) - 128) * 64 + (b.get (pos + 2) - 128))
///       (by omega)
///       (by simp only [scalar]; omega)
///       (by rw [hl4]; omega)
///       (by simp only [utf8_b0]; repeat (first | omega | split))
///       (by rw [hl4]; intro _; simp only [utf8_b1]; repeat (first | omega | split))
///       (by rw [hl4]; intro _; simp only [utf8_b2]; repeat (first | omega | split))
///       (by rw [hl4]; intro hx; omega)
///       (by rw [hl4]; exact ih hrest)
///   next pos hend _ _ _ _ hcond ih =>
///     obtain ⟨hL, ha, hb2, hc, hd, hrest⟩ := h
///     have hl5 : utf8_len ((b.get pos - 224) * 4096 + (b.get (pos + 1) - 128) * 64 + (b.get (pos + 2) - 128)) = 3 := by
///       simp only [utf8_len]; repeat (first | omega | split)
///     refine validFrom_step b pos ((b.get pos - 224) * 4096 + (b.get (pos + 1) - 128) * 64 + (b.get (pos + 2) - 128))
///       (by omega)
///       (by simp only [scalar]; omega)
///       (by rw [hl5]; omega)
///       (by simp only [utf8_b0]; repeat (first | omega | split))
///       (by rw [hl5]; intro _; simp only [utf8_b1]; repeat (first | omega | split))
///       (by rw [hl5]; intro _; simp only [utf8_b2]; repeat (first | omega | split))
///       (by rw [hl5]; intro hx; omega)
///       (by rw [hl5]; exact ih hrest)
///   next pos hend _ _ _ _ _ hcond ih =>
///     obtain ⟨hL, ha, hb2, hc, hd, hrest⟩ := h
///     have hl6 : utf8_len ((b.get pos - 224) * 4096 + (b.get (pos + 1) - 128) * 64 + (b.get (pos + 2) - 128)) = 3 := by
///       simp only [utf8_len]; repeat (first | omega | split)
///     refine validFrom_step b pos ((b.get pos - 224) * 4096 + (b.get (pos + 1) - 128) * 64 + (b.get (pos + 2) - 128))
///       (by omega)
///       (by simp only [scalar]; omega)
///       (by rw [hl6]; omega)
///       (by simp only [utf8_b0]; repeat (first | omega | split))
///       (by rw [hl6]; intro _; simp only [utf8_b1]; repeat (first | omega | split))
///       (by rw [hl6]; intro _; simp only [utf8_b2]; repeat (first | omega | split))
///       (by rw [hl6]; intro hx; omega)
///       (by rw [hl6]; exact ih hrest)
///   next pos hend _ _ _ _ _ _ hcond ih =>
///     obtain ⟨hL, ha, hb2, hc, hd, he, hf, hrest⟩ := h
///     have hl7 : utf8_len ((b.get pos - 240) * 262144 + (b.get (pos + 1) - 128) * 4096 + (b.get (pos + 2) - 128) * 64 + (b.get (pos + 3) - 128)) = 4 := by
///       simp only [utf8_len]; repeat (first | omega | split)
///     refine validFrom_step b pos ((b.get pos - 240) * 262144 + (b.get (pos + 1) - 128) * 4096 + (b.get (pos + 2) - 128) * 64 + (b.get (pos + 3) - 128))
///       (by omega)
///       (by simp only [scalar]; omega)
///       (by rw [hl7]; omega)
///       (by simp only [utf8_b0]; repeat (first | omega | split))
///       (by rw [hl7]; intro _; simp only [utf8_b1]; repeat (first | omega | split))
///       (by rw [hl7]; intro _; simp only [utf8_b2]; repeat (first | omega | split))
///       (by rw [hl7]; intro _; simp only [utf8_b3]; repeat (first | omega | split))
///       (by rw [hl7]; exact ih hrest)
///   next pos hend _ _ _ _ _ _ _ hcond ih =>
///     obtain ⟨hL, ha, hb2, hc, hd, he, hf, hrest⟩ := h
///     have hl8 : utf8_len ((b.get pos - 240) * 262144 + (b.get (pos + 1) - 128) * 4096 + (b.get (pos + 2) - 128) * 64 + (b.get (pos + 3) - 128)) = 4 := by
///       simp only [utf8_len]; repeat (first | omega | split)
///     refine validFrom_step b pos ((b.get pos - 240) * 262144 + (b.get (pos + 1) - 128) * 4096 + (b.get (pos + 2) - 128) * 64 + (b.get (pos + 3) - 128))
///       (by omega)
///       (by simp only [scalar]; omega)
///       (by rw [hl8]; omega)
///       (by simp only [utf8_b0]; repeat (first | omega | split))
///       (by rw [hl8]; intro _; simp only [utf8_b1]; repeat (first | omega | split))
///       (by rw [hl8]; intro _; simp only [utf8_b2]; repeat (first | omega | split))
///       (by rw [hl8]; intro _; simp only [utf8_b3]; repeat (first | omega | split))
///       (by rw [hl8]; exact ih hrest)
///   next pos hend _ _ _ _ _ _ _ _ hcond ih =>
///     obtain ⟨hL, ha, hb2, hc, hd, he, hf, hrest⟩ := h
///     have hl9 : utf8_len ((b.get pos - 240) * 262144 + (b.get (pos + 1) - 128) * 4096 + (b.get (pos + 2) - 128) * 64 + (b.get (pos + 3) - 128)) = 4 := by
///       simp only [utf8_len]; repeat (first | omega | split)
///     refine validFrom_step b pos ((b.get pos - 240) * 262144 + (b.get (pos + 1) - 128) * 4096 + (b.get (pos + 2) - 128) * 64 + (b.get (pos + 3) - 128))
///       (by omega)
///       (by simp only [scalar]; omega)
///       (by rw [hl9]; omega)
///       (by simp only [utf8_b0]; repeat (first | omega | split))
///       (by rw [hl9]; intro _; simp only [utf8_b1]; repeat (first | omega | split))
///       (by rw [hl9]; intro _; simp only [utf8_b2]; repeat (first | omega | split))
///       (by rw [hl9]; intro _; simp only [utf8_b3]; repeat (first | omega | split))
///       (by rw [hl9]; exact ih hrest)
///   next pos hend _ _ _ _ _ _ _ _ _ =>
///     exact absurd h (by simp)

/// pre  pos < b.len
/// pre  b.len ≤ 4611686018427387904
/// post result ≤ 4
/// post result ≠ 0 → ∃ cp, scalar cp ∧ pos + utf8_len cp ≤ b.len ∧ utf8_len cp = result ∧ b.get pos = utf8_b0 cp ∧ (2 ≤ utf8_len cp → b.get (pos + 1) = utf8_b1 cp) ∧ (3 ≤ utf8_len cp → b.get (pos + 2) = utf8_b2 cp) ∧ (utf8_len cp = 4 → b.get (pos + 3) = utf8_b3 cp)
fn utf8_step(&[u8] b, u64 pos) -> u64 {
    u8 b0 = b[pos];
    if (b0 < 128) {
        return 1;
    }
    if (b0 >= 194 && b0 <= 223) {
        if (pos + 1 >= b.len) {
            return 0;
        }
        u8 b1 = b[pos + 1];
        if (b1 < 128 || b1 > 191) {
            return 0;
        }
        return 2;
    }
    if (b0 >= 224 && b0 <= 239) {
        if (pos + 2 >= b.len) {
            return 0;
        }
        u8 c1 = b[pos + 1];
        u8 c2 = b[pos + 2];
        if (c1 < 128 || c1 > 191) {
            return 0;
        }
        if (c2 < 128 || c2 > 191) {
            return 0;
        }
        if (b0 == 224 && c1 < 160) {
            return 0;
        }
        if (b0 == 237 && c1 > 159) {
            return 0;
        }
        return 3;
    }
    if (b0 >= 240 && b0 <= 244) {
        if (pos + 3 >= b.len) {
            return 0;
        }
        u8 d1 = b[pos + 1];
        u8 d2 = b[pos + 2];
        u8 d3 = b[pos + 3];
        if (d1 < 128 || d1 > 191) {
            return 0;
        }
        if (d2 < 128 || d2 > 191) {
            return 0;
        }
        if (d3 < 128 || d3 > 191) {
            return 0;
        }
        if (b0 == 240 && d1 < 144) {
            return 0;
        }
        if (b0 == 244 && d1 > 143) {
            return 0;
        }
        return 4;
    }
    return 0;
}

/// pre  b.len ≤ 4611686018427387904
/// post result → validFrom b 0
fn validate_utf8(&[u8] b) -> bool {
    u64 pos = 0;
    u64 n = b.len;
    /// invariant pos ≤ n
    /// invariant validFrom b pos → validFrom b 0
    /// variant   n - pos
    while (pos < n) {
        u64 s = utf8_step(&b, pos);
        if (s == 0) {
            return false;
        }
        pos = pos + s;
    }
    return true;
}

// The kernel-checked roundtrip: encode into a fresh buffer, decode it
// back, get exactly the codepoint you started with.

/// pre  scalar cp
/// post result = some cp
fn roundtrip(u32 cp) -> option<u32> {
    [u8] buf = alloc_array<u8>(4, 0);
    u64 n = encode_utf8(cp, &mut buf);
    return decode_utf8(&buf, 0);
}

/// discharge roundtrip.post.result_some_cp by
///   have hl4 : 1 ≤ utf8_len cp ∧ utf8_len cp ≤ 4 := by
///     unfold utf8_len
///     repeat (first | omega | split)
///   have hex : ∃ cp2, scalar cp2 ∧ (0 : Int) + utf8_len cp2 ≤ (_arr4).len ∧ (_arr4).get 0 = utf8_b0 cp2 ∧ (2 ≤ utf8_len cp2 → (_arr4).get (0 + 1) = utf8_b1 cp2) ∧ (3 ≤ utf8_len cp2 → (_arr4).get (0 + 2) = utf8_b2 cp2) ∧ (utf8_len cp2 = 4 → (_arr4).get (0 + 3) = utf8_b3 cp2) := by
///     refine ⟨cp, h_pre_scalar_cp, by omega, h_encode_utf8_post_out_get_0_utf8_b0_cp, ?_, ?_, ?_⟩
///     · intro h2
///       simpa using h_encode_utf8_post_2_utf8_len_cp_out_get_1 h2
///     · intro h3
///       simpa using h_encode_utf8_post_3_utf8_len_cp_out_get_2 h3
///     · intro h4
///       simpa using h_encode_utf8_post_utf8_len_cp_4_out_get_3 h4
///   have hne := h_decode_utf8_post_cp2_scalar_cp2_pos_utf8 hex
///   have hkey := utf8_decode_encode2 cp ((_arr4).get (0 + 1)) ((_arr4).get (0 + 2)) ((_arr4).get (0 + 3)) h_pre_scalar_cp
///     (fun h2 => by simpa using h_encode_utf8_post_2_utf8_len_cp_out_get_1 h2)
///     (fun h3 => by simpa using h_encode_utf8_post_3_utf8_len_cp_out_get_2 h3)
///     (fun h4 => by simpa using h_encode_utf8_post_utf8_len_cp_4_out_get_3 h4)
///   rw [h_result]
///   cases hr : _r6 with
///   | none =>
///     exact absurd hr hne
///   | some v =>
///     rw [hr] at h_decode_utf8_post_match_result_with_some_v
///     have hm2 := h_decode_utf8_post_match_result_with_some_v.2
///     rw [h_encode_utf8_post_out_get_0_utf8_b0_cp] at hm2
///     rw [hm2, hkey]

// The scanner's discharges: the step posts need their existential
// witness named (automation cannot invent `utf8_decode` of the bytes);
// the scan invariant chains through validFrom_step / validFrom_end.

/// discharge utf8_step.post.result_0_cp_scalar_cp_pos_utf8_len_cp_b by
///   intro _
///   refine ⟨utf8_decode ((b).get pos) ((b).get (pos + 1)) ((b).get (pos + 2)) ((b).get (pos + 3)), ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
///   all_goals simp only [scalar, utf8_decode, utf8_len, utf8_b0, utf8_b1, utf8_b2, utf8_b3]
///   all_goals repeat (first | omega | split)

/// discharge utf8_step.post.result_0_cp_scalar_cp_pos_utf8_len_cp_b.4 by
