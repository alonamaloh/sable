// Round-trip hex codec: hex_encode maps each byte to two lowercase
// ASCII hex characters; hex_decode inverts it, rejecting non-hex input.
// The ghost maps are written arithmetically (Euclidean division by a
// constant) rather than with if-then-else so they stay inside both
// omega's fragment and the dynamic checker's monitorable fragment:
//   hex_digit d = 48+d for d in [0,10), 87+d for d in [10,16)
//   unhex c    = c-48 for c in [48,58), c-87 for c in [97,103)

/// def hex_digit (d : int) : int := 48 + d + 39 * (d / 10)
/// def unhex (c : int) : int := c - 48 - 39 * (c / 97)

// The program-side mapping uses if/else; the post ties it to the ghost map.

/// pre  d < 16
/// post result = hex_digit d
fn nibble_char(u8 d) -> u8 {
    if (d < 10) { return 48 + d; }
    return 87 + d;
}

/// pre  (48 ≤ c ∧ c ≤ 57) ∨ (97 ≤ c ∧ c ≤ 102)
/// post result = unhex c
fn unhex_char(u8 c) -> u8 {
    if (c < 58) { return c - 48; }
    return c - 87;
}

/// pre  src.len ≤ 1000000
/// pre  dst.len = 2 * src.len
/// post ∀ k, 0 ≤ k → k < src.len →
///      dst.get (2 * k) = hex_digit (src.get k / 16) ∧
///      dst.get (2 * k + 1) = hex_digit (src.get k % 16)
pub fn hex_encode(&[u8] src, &mut [u8] dst) {
    u64 n = src.len;
    /// invariant ∀ k, 0 ≤ k → k < i →
    ///           dst.get (2 * k) = hex_digit (src.get k / 16) ∧
    ///           dst.get (2 * k + 1) = hex_digit (src.get k % 16)
    for (u64 i : range(n)) {
        u8 b = src[i];
        u8 c1 = nibble_char(b / 16);
        u8 c2 = nibble_char(b % 16);
        dst[2 * i] = c1;
        dst[2 * i + 1] = c2;
    }
}

/// pre  dst.len ≤ 1000000
/// pre  src.len = 2 * dst.len
/// post result → ∀ k, 0 ≤ k → k < dst.len →
///      dst.get k = 16 * unhex (src.get (2 * k)) + unhex (src.get (2 * k + 1))
pub fn hex_decode(&[u8] src, &mut [u8] dst) -> bool {
    u64 n = dst.len;
    /// invariant ∀ k, 0 ≤ k → k < i →
    ///           dst.get k = 16 * unhex (src.get (2 * k)) + unhex (src.get (2 * k + 1))
    for (u64 i : range(n)) {
        u8 c1 = src[2 * i];
        u8 c2 = src[2 * i + 1];
        if (c1 < 48 || (c1 > 57 && c1 < 97) || c1 > 102) { return false; }
        if (c2 < 48 || (c2 > 57 && c2 < 97) || c2 > 102) { return false; }
        u8 d1 = unhex_char(c1);
        u8 d2 = unhex_char(c2);
        dst[i] = 16 * d1 + d2;
    }
    return true;
}

// The two invariant-preservation discharges. Both nibble_char call sites
// share the post slug, so `h_nibble_char_post_result_hex_digit_d` names
// only the second (_r8) instance and the _r7 one is shadowed; we recover
// it by unfolding the ghost map across the whole context (`at *` reaches
// shadowed hypotheses) and letting omega read it. Same for unhex_char.

/// discharge hex_encode.inv_preserved.k_0_k_k_i_dst_get_2_k_hex_digit_src_get by
///   have h7 := h_nibble_char_post_result_hex_digit_d
///   have h8 := h_nibble_char_post_result_hex_digit_d_2
///   simp only [hex_digit] at h7 h8
///   intro k hk0 hk
///   by_cases hki : k = i
///   · have hne : 2 * i ≠ 2 * i + 1 := by omega
///     constructor
///     · simp [Sable.Seq.get_set, hki, hne]
///       omega
///     · simp [Sable.Seq.get_set, hki]
///       omega
///   · have hkalt := h_inv_k_0_k_k_i_dst_get_2_k_he k hk0 (by omega)
///     simp only [hex_digit] at hkalt
///     have hne1 : 2 * k ≠ 2 * i := by omega
///     have hne2 : 2 * k ≠ 2 * i + 1 := by omega
///     have hne3 : 2 * k + 1 ≠ 2 * i := by omega
///     have hne4 : 2 * k + 1 ≠ 2 * i + 1 := by omega
///     simp [Sable.Seq.get_set, hne1, hne2, hne3, hne4]
///     omega

/// discharge hex_decode.inv_preserved.k_0_k_k_i_dst_get_k_16_unhex_src_get_2_k by
///   have h7 := h_unhex_char_post_result_unhex_c
///   have h8 := h_unhex_char_post_result_unhex_c_2
///   simp only [unhex] at h7 h8
///   intro k hk0 hk
///   by_cases hki : k = i
///   · simp [Sable.Seq.get_set, hki]
///     omega
///   · have hkalt := h_inv_k_0_k_k_i_dst_get_k_16_u k hk0 (by omega)
///     simp only [unhex] at hkalt
///     simp [Sable.Seq.get_set, hki]
///     omega

// The round trip, stated over the ghost maps alone (pure Lean): decoding
// what hex_encode's post says about a byte gives the byte back.

/// theorem unhex_hex_digit (d : int) (h0 : 0 ≤ d) (h1 : d < 16) :
///     unhex (hex_digit d) = d := by
///   simp only [unhex, hex_digit]
///   omega

/// theorem hex_round_trip (b : int) (h0 : 0 ≤ b) (h1 : b < 256) :
///     16 * unhex (hex_digit (b / 16)) + unhex (hex_digit (b % 16)) = b := by
///   have h2 := unhex_hex_digit (b / 16) (by omega) (by omega)
///   have h3 := unhex_hex_digit (b % 16) (by omega) (by omega)
///   rw [h2, h3]
///   omega
