///   intro i hi0 hic hocc
///   have hdb := dist_bounds ((hv % ((_old_self.occ).len))) i ((_old_self.occ).len) h_inv_0_h_h_cap.1 h_inv_0_h_h_cap.2 hi0 hic
///   have hpd := probe_dist_eq ((hv % ((_old_self.occ).len))) i ((_old_self.occ).len) h_inv_0_h_h_cap.1 h_inv_0_h_h_cap.2 hi0 hic
///   have hl := h_inv_j2_0_j2_j2_j_self_occ_ge (dist ((hv % ((_old_self.occ).len))) i ((_old_self.occ).len)) hdb.1 (by omega)
///   rw [hpd] at hl
