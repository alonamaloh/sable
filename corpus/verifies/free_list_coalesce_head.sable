// U8g3 successor coalescing at the runtime head. The returned lease is exactly
// before the first stored node, so clearing that node exposes two adjacent
// FreeBlocks which are joined before one replacement header is materialized.

use free_list_remove_head;

/// pre  #[label(base)] base.alloc = state.root.alloc ∧ base.off = 0
/// pre  #[label(limit)] list.limit = state.root.len
/// pre  #[label(chain)]
///        Sable.AllocatorView.StoredChain state list.limit list.head
/// pre  #[label(nonempty)] list.head != list.limit
/// pre  #[label(returnable)] state.returnable lease
/// pre  #[label(key)] lease.key = key
/// pre  #[label(size)] lease.span.len = size
/// pre  #[label(header)] Sable.freeHeaderBytes ≤ size ∧
///        key % u64.layout.align = 0
/// pre  #[label(adjacent)] key + size = list.head
/// post #[label(limit_frame)] list.limit = (old list).limit
/// post #[label(head)] list.head = key
/// post #[label(chain)]
///        Sable.AllocatorView.StoredChain state list.limit list.head
pub fn free_list_coalesce_head(raw<u8> base,
                               &mut FreeListState list,
                               resource &mut AllocatorState state,
                               u64 key, u64 size,
                               resource BlockLease lease) {
    resource FreeBlock left = block_lease_free(lease);
    u64 current = list.head;
    mut resource FreeHeader successor =
        allocator_step_header(&mut state, list.limit, current);
    mut u64 successor_size = 0;
    mut u64 next = 0;
    unsafe {
        raw<u8> successor_ptr = raw_offset(base, current);
        successor_size = raw_header_size(successor_ptr, &successor);
        next = raw_header_next(successor_ptr, &successor);
        raw_header_clear(successor_ptr, &mut successor);
        resource FreeBlock right =
            raw_from_free_header(successor_ptr, successor);
    }
    resource FreeBlock joined = free_block_join(left, right);
    u64 joined_size = size + successor_size;
    unsafe {
        raw<u8> joined_ptr = raw_offset(base, key);
        mut resource FreeHeader header =
            raw_into_free_header(joined_ptr, joined);
        raw_header_init(joined_ptr, joined_size, next, &mut header);
    }
    allocator_put_header(&mut state, header);
    list.advance(key);
}

/// discharge free_list_coalesce_head.block_lease_free by
///   exact ⟨h_pre_returnable.2.1,
///     h_pre_returnable.2.2.1⟩

/// discharge free_list_coalesce_head.free_header.size by
///   obtain ⟨node, storedSize, storedNext, hstored, hfields,
///       hextent, hclear, hfit, horder, hbound, tail⟩ :=
///     Sable.AllocatorView.StoredChain.step
///       h_pre_chain (by simpa using h_pre_nonempty)
///   have hnode : _header3 = node := by
///     rw [h_header3_step,
///       Sable.AllocatorView.storesHeader_headerAt hstored]
///   have hwf := hstored.2.2.2.1
///   unfold Sable.FreeHeaderView.wf at hwf
///   obtain ⟨_, _, hkeyoff, _, _, _, _, _⟩ := hwf
///   rw [hnode]
///   constructor
///   · unfold Sable.PointsToView.names
///     constructor
///     · calc
///         (Sable.RawPtr.add base _old_list.head).alloc = base.alloc := rfl
///         _ = _old_state.root.alloc := h_pre_base.1
///         _ = node.sizeCell.alloc := hstored.2.2.2.2.2.symm
///     · calc
///         (Sable.RawPtr.add base _old_list.head).off =
///             base.off + _old_list.head := rfl
///         _ = _old_list.head := by rw [h_pre_base.2]; omega
///         _ = node.key := hstored.2.2.1.symm
///         _ = node.sizeCell.off := hkeyoff
///   · rw [hfields.1]
///     simp

/// discharge free_list_coalesce_head.free_header.next by
///   obtain ⟨node, storedSize, storedNext, hstored, hfields,
///       hextent, hclear, hfit, horder, hbound, tail⟩ :=
///     Sable.AllocatorView.StoredChain.step
///       h_pre_chain (by simpa using h_pre_nonempty)
///   have hnode : _header3 = node := by
///     rw [h_header3_step,
///       Sable.AllocatorView.storesHeader_headerAt hstored]
///   have hwf := hstored.2.2.2.1
///   unfold Sable.FreeHeaderView.wf at hwf
///   obtain ⟨hsizewf, _, hkeyoff, halloc, _, hoff, _, _⟩ := hwf
///   have hlayout : node.sizeCell.layout = Sable.u64.layout :=
///     hsizewf.1
///   rw [hnode]
///   constructor
///   · constructor
///     · calc
///         node.nextCell.alloc = node.sizeCell.alloc := halloc.symm
///         _ = _old_state.root.alloc := hstored.2.2.2.2.2
///         _ = base.alloc := h_pre_base.1.symm
///         _ = (Sable.RawPtr.add base _old_list.head).alloc := rfl
///     · calc
///         node.nextCell.off =
///             node.sizeCell.off + node.sizeCell.layout.size := hoff.symm
///         _ = node.key + Sable.u64.layout.size := by
///           rw [← hkeyoff, hlayout]
///         _ = _old_list.head + Sable.u64.layout.size := by
///           rw [hstored.2.2.1]
///         _ = (Sable.RawPtr.add base _old_list.head).off +
///             Sable.u64.layout.size := by
///           rw [Sable.RawPtr.add_off, h_pre_base.2]
///           omega
///   · rw [hfields.2]
///     simp

/// discharge free_list_coalesce_head.free_header.to_block by
///   rw [h_successor_clear]
///   constructor
///   · simpa [Sable.FreeHeaderView.clearFields,
///       Sable.PointsToView.names] using
///       h_fact_sable_pointstoview_names.1
///   constructor
///   · simp [Sable.FreeHeaderView.clearFields]
///   constructor
///   · simpa [Sable.FreeHeaderView.clearFields] using
///       h_fact_sable_pointstoview_names.2.2.1
///   constructor
///   · simpa [Sable.FreeHeaderView.clearFields] using
///       h_fact_sable_pointstoview_names.2.2.2.1
///   · simp [Sable.FreeHeaderView.clearFields]

/// discharge free_list_coalesce_head.free_block_join by
///   obtain ⟨node, storedSize, storedNext, hstored, hfields,
///       hextent, hclear, hfit, horder, hbound, tail⟩ :=
///     Sable.AllocatorView.StoredChain.step
///       h_pre_chain (by simpa using h_pre_nonempty)
///   have hnode : _header3 = node := by
///     rw [h_header3_step,
///       Sable.AllocatorView.storesHeader_headerAt hstored]
///   have hwf := hstored.2.2.2.1
///   unfold Sable.FreeHeaderView.wf at hwf
///   obtain ⟨_, _, hkeyoff, _, _, _, _, _⟩ := hwf
///   rw [h_free1_free, h_free7_block, h_successor_clear, hnode]
///   unfold Sable.FreeBlockView.joinable
///   constructor
///   · change lease.allocator = node.allocator
///     exact h_pre_returnable.1.1.trans
///       hstored.2.2.2.2.1.symm
///   constructor
///   · change lease.span.alloc = node.sizeCell.alloc
///     exact h_pre_returnable.2.2.2.1.trans
///       hstored.2.2.2.2.2.symm
///   constructor
///   · change lease.span.off + lease.span.len = node.sizeCell.off
///     calc
///       lease.span.off + lease.span.len = key + size := by
///         rw [← h_pre_key, ← h_pre_size,
///           h_pre_returnable.2.1]
///       _ = _old_list.head := h_pre_adjacent
///       _ = node.key := hstored.2.2.1.symm
///       _ = node.sizeCell.off := hkeyoff
///   · change node.key = lease.key + lease.span.len
///     calc
///       node.key = _old_list.head := hstored.2.2.1
///       _ = key + size := h_pre_adjacent.symm
///       _ = lease.key + lease.span.len := by
///         rw [h_pre_key, h_pre_size]

/// discharge free_list_coalesce_head.overflow.size_successor_size by
///   obtain ⟨node, storedSize, storedNext, hstored, hfields,
///       hextent, hclear, hfit, horder, hbound, tail⟩ :=
///     Sable.AllocatorView.StoredChain.step
///       h_pre_chain (by simpa using h_pre_nonempty)
///   have hnode : _header3 = node := by
///     rw [h_header3_step,
///       Sable.AllocatorView.storesHeader_headerAt hstored]
///   have hvalue : storedSize = _value4 := by
///     rw [hnode, hfields.1] at h_value4_header_size
///     injection h_value4_header_size
///   constructor <;> omega

/// discharge free_list_coalesce_head.free_header.from_block by
///   rw [h_free8_join]
///   constructor
///   · rw [h_free1_free]
///     change base.alloc = lease.span.alloc
///     exact h_pre_base.1.trans
///       h_pre_returnable.2.2.2.1.symm
///   constructor
///   · rw [h_free1_free]
///     change base.off + key = lease.span.off
///     rw [h_pre_base.2, ← h_pre_key,
///       h_pre_returnable.2.1]
///     omega
///   constructor
///   · rw [Sable.RawPtr.add_off, h_pre_base.2]
///     omega
///   constructor
///   · simpa [Sable.RawPtr.add_off, h_pre_base.2] using
///       h_pre_header.2
///   · rw [h_free1_free]
///     change Sable.freeHeaderBytes ≤
///       lease.span.len + _free7.span.len
///     rw [h_pre_size]
///     have hpositive : 0 < _free7.span.len := h_free7_wf.2
///     omega

/// discharge free_list_coalesce_head.free_header.init by
///   obtain ⟨node, storedSize, storedNext, hstored, hfields,
///       hextent, hclear, hfit, horder, hbound, tail⟩ :=
///     Sable.AllocatorView.StoredChain.step
///       h_pre_chain (by simpa using h_pre_nonempty)
///   have hnode : _header3 = node := by
///     rw [h_header3_step,
///       Sable.AllocatorView.storesHeader_headerAt hstored]
///   have hvalue : storedSize = _value4 := by
///     rw [hnode, hfields.1] at h_value4_header_size
///     injection h_value4_header_size
///   have hright : _free7.span.len = _value4 := by
///     rw [h_free7_block, h_successor_clear, hnode,
///       Sable.FreeHeaderView.clearFields_toFree_span_len]
///     exact hextent.trans hvalue
///   have hjoined : _free8.span.len = size + _value4 := by
///     rw [h_free8_join]
///     change _free1.span.len + _free7.span.len = size + _value4
///     rw [h_free1_free]
///     change lease.span.len + _free7.span.len = size + _value4
///     rw [h_pre_size, hright]
///   rw [h_header9_header]
///   simp [Sable.FreeBlockView.toHeader, Sable.PointsToView.names,
///     h_fact_sable_rawptr_add_base_ke, Sable.freeHeaderBytes,
///     Sable.u64.layout]
///   refine ⟨⟨h_fact_sable_rawptr_add_base_ke.1,
///       h_fact_sable_rawptr_add_base_ke.2.1⟩,
///     h_fact_sable_rawptr_add_base_ke.1.symm,
///     h_fact_sable_rawptr_add_base_ke.2.1.symm, ?_⟩
///   rw [hjoined]
///   simp [Sable.freeHeaderBytes, Sable.u64.layout]
///     at h_fact_sable_rawptr_add_base_ke ⊢
///   omega

/// discharge free_list_coalesce_head.allocator_put_header by
///   have hne : lease.key ≠ _old_list.head := by
///     rw [h_pre_key, ← h_pre_adjacent]
///     have hpositive : 0 < size := by
///       rw [← h_pre_size]
///       exact h_pre_returnable.2.2.1
///     omega
///   have hreturn :=
///     Sable.AllocatorView.returnable_takeHeader_ne
///       h_pre_returnable hne
///   have hheaderkey : header.key = lease.key := by
///     rw [h_header_init, h_header9_header, h_free8_join,
///       h_free1_free]
///     rfl
///   have howner : header.allocator = lease.allocator := by
///     rw [h_header_init, h_header9_header, h_free8_join,
///       h_free1_free]
///     rfl
///   rw [h_state_step_header]
///   exact Sable.AllocatorView.returnable_canPutHeader
///     hreturn hheaderkey h_header_wf howner

/// discharge free_list_coalesce_head.post.chain by
///   obtain ⟨node, storedSize, storedNext, hstored, hfields,
///       hextent, hclear, hfit, horder, hbound, tail⟩ :=
///     Sable.AllocatorView.StoredChain.step
///       h_pre_chain (by simpa using h_pre_nonempty)
///   have hnode : _header3 = node := by
///     rw [h_header3_step,
///       Sable.AllocatorView.storesHeader_headerAt hstored]
///   have hsizeValue : storedSize = _value4 := by
///     rw [hnode, hfields.1] at h_value4_header_size
///     injection h_value4_header_size
///   have hnextValue : storedNext = _value5 := by
///     rw [hnode, hfields.2] at h_value5_header_next
///     injection h_value5_header_next
///   have hmatch :=
///     Sable.AllocatorView.StoredChain.takeMatchingHead
///       h_pre_chain (by simpa using h_pre_nonempty)
///       hstored hfields
///   have hright : _free7.span.len = _value4 := by
///     rw [h_free7_block, h_successor_clear, hnode,
///       Sable.FreeHeaderView.clearFields_toFree_span_len]
///     exact hextent.trans hsizeValue
///   have hjoined : _free8.span.len = size + _value4 := by
///     rw [h_free8_join]
///     change _free1.span.len + _free7.span.len = size + _value4
///     rw [h_free1_free]
///     change lease.span.len + _free7.span.len = size + _value4
///     rw [h_pre_size, hright]
///   have hheaderLease : header.key = lease.key := by
///     rw [h_header_init, h_header9_header, h_free8_join,
///       h_free1_free]
///     rfl
///   have hheaderKey : header.key = key :=
///     hheaderLease.trans h_pre_key
///   have hheaderFields :
///       header.hasFields (size + _value4) _value5 := by
///     simp [h_header_init, Sable.FreeHeaderView.hasFields,
///       Sable.FreeHeaderView.putFields]
///   have hheaderExtent :
///       header.toFree.span.len = size + _value4 := by
///     rw [h_header_init, h_header9_header,
///       Sable.FreeBlockView.toHeader_putFields_toFree_span_len]
///     exact hjoined
///   have hadjacent :
///       lease.key + lease.span.len = _old_list.head := by
///     rw [h_pre_key, h_pre_size]
///     exact h_pre_adjacent
///   have hcombined :=
///     Sable.AllocatorView.returnable_takeAdjacentHeader_clearInterior
///       h_pre_returnable hadjacent hstored hmatch.2.1
///   have hheaderClear :
///       state.clearInterior header.key (size + _value4) := by
///     rw [h_state_step_header, hheaderLease]
///     simpa [h_pre_size, hsizeValue] using hcombined
///   have hheaderRoot :
///       header.sizeCell.alloc = state.root.alloc := by
///     rw [h_header_init, h_header9_header, h_free8_join,
///       h_free1_free, h_state_step_header]
///     change lease.span.alloc = _old_state.root.alloc
///     exact h_pre_returnable.2.2.2.1
///   have hheaderNonneg : 0 ≤ header.key := by
///     rw [hheaderKey]
///     exact h_key_range.1
///   have hheaderFits :
///       Sable.freeHeaderBytes ≤ size + _value4 := by
///     omega
///   have hheaderOrder :
///       header.key + (size + _value4) ≤ _value5 := by
///     rw [hheaderKey, ← hsizeValue, ← hnextValue]
///     omega
///   have hnextBound : _value5 ≤ _old_list.limit := by
///     rw [← hnextValue]
///     exact hbound
///   have htail :
///       state.StoredChain _old_list.limit _value5 := by
///     rw [h_state_step_header, ← hnextValue]
///     exact hmatch.2.2.2.2.2
///   rw [h_state_put_header,
///     h_FreeListState_advance_post_self_head_next_self_limi.1,
///     h_FreeListState_advance_post_self_head_next_self_limi.2,
///     ← hheaderKey]
///   exact Sable.AllocatorView.StoredChain.prependAfterPut
///     htail h_fact_sable_allocatorview_canp hheaderFields
///     hheaderExtent hheaderClear hheaderRoot hheaderNonneg
///     hheaderFits hheaderOrder hnextBound
