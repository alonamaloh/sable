// The first safe wrapper over raw memory (ADR 0026).
//
// `copy_prefix` copies bytes through pointers, in `unsafe`, and its
// contract is four lines of value-level arithmetic. There is **no
// user-visible heap predicate, frame clause, separating conjunction,
// provenance lemma, or manual proof of disjointness** — that was the
// acceptance criterion for the whole raw-memory direction, and this
// function is what it was written against.
//
// Two things carry it. First, *lexical exposure*: `unsafe expose` lends
// the array's bytes for the body and takes them back, so the bridge
// between the safe world's `[u8]` and the raw world's bytes is a
// construct rather than a proof. Second, *affinity supplies separation*:
// `raw_copy_nonoverlapping` has no nonoverlap premise at all, because
// `smem` and `dmem` are distinct affine tokens and that is what being
// distinct means. A caller who possesses two exclusive resources should
// not have to prove they do not alias.

/// pre  src.len ≤ dst.len
/// post #[label(copied)] ∀ i, 0 ≤ i → i < src.len → dst.get i = src.get i
/// post #[label(kept)]   ∀ i, src.len ≤ i → i < dst.len → dst.get i = (old dst).get i
pub fn copy_prefix(&[u8] src, &mut [u8] dst) {
    // An exposed array's own name is frozen for the body (ADR 0073), so a
    // length the body needs is bound before the loan opens.
    u64 n = src.len;
    unsafe expose &src as (sp, resource smem) {
        unsafe expose &mut dst as (dp, resource dmem) {
            raw_copy_nonoverlapping(sp, dp, n, &smem, &mut dmem);
        }
    }
}

// A shared exposure reads. It cannot write: the resource it binds is not
// `mut`, so `&mut smem` is rejected by the checker rather than disproved
// by a frame condition.
/// pre  a.len ≥ 1
/// post result = a.get 0
pub fn first_byte(&[u8] a) -> u8 {
    mut u8 r = 0;
    unsafe expose &a as (p, resource m) {
        r = raw_load8(p, &m);
    }
    return r;
}

// A mutable exposure writes, and the array afterwards is what the bytes
// say. The frame half of the contract — that nothing else moved — comes
// out of the store being a *function* on the view.
/// pre  a.len ≥ 2
/// post #[label(set)]  a.get 1 = 9
/// post #[label(rest)] ∀ k, 0 ≤ k → k < a.len → k ≠ 1 → a.get k = (old a).get k
pub fn set_second(&mut [u8] a) {
    unsafe expose &mut a as (p, resource m) {
        raw_store8(raw_offset(p, 1), 9, &mut m);
    }
}

// Pointer arithmetic is pure, so a pointer may be computed anywhere; only
// the load asks whether it is in bounds.
/// pre  a.len ≥ 3
/// post result = a.get 2
pub fn third_byte(&[u8] a) -> u8 {
    mut u8 r = 0;
    unsafe expose &a as (p, resource m) {
        r = raw_load8(raw_offset(p, 2), &m);
    }
    return r;
}

// Carving inside an exposure: the span may be split, and the whole extent
// has to be rejoined before the body ends, or the array cannot be
// reconstructed.
/// pre  a.len ≥ 1
/// post #[label(head)] a.get 0 = 7
pub fn split_write_join(&mut [u8] a) {
    unsafe expose &mut a as (p, resource m) {
        resource RawSpan tail = split_off(&mut m, 1);
        raw_store8(p, 7, &mut m);
        resource RawSpan whole = join(m, tail);
        m = whole;
    }
}

// ------------------------- the audited boundary --------------------------
//
// An `extern "C"` declaration's contract is *audited*, not proved: there
// is no body to check it against, so it owes no obligations and the build
// status has to say so. During Priority Zero it reports `Lean accepted relative
// to an audited extern boundary; proof dependencies unaudited`; after the
// transitive proof audit lands, the extern still prevents an unqualified
// strongest status (ADR 0027).
//
// Effects are stated *structurally*, through the resource parameters.
// Only a passed mutable resource may change; everything else is framed by
// the caller's ownership discipline, so there is no free-form `modifies`
// clause anywhere. Resources are erased from the ABI: the foreign
// function receives the pointer, the length, and the byte.

/// pre  #[label(names)] p.alloc = mem.alloc ∧ p.off = mem.off
/// pre  #[label(fits)]  n ≤ mem.len
/// post #[label(shape)] mem.alloc = (old mem).alloc ∧ mem.off = (old mem).off
///          ∧ mem.len = (old mem).len
/// post #[label(set)]   ∀ k, 0 ≤ k → k < n → mem.bytes.get k = Sable.ByteState.init value
/// post #[label(kept)]  ∀ k, n ≤ k → mem.bytes.get k = (old mem).bytes.get k
pub extern "C" #[audit(id := "test.fill.v1",
                       reason := "deterministic test shim: writes n bytes at p and nothing else")]
fn c_fill(raw<u8> p, u64 n, u8 value, resource &mut RawSpan mem);

// The safe wrapper. Its contract is one line of value-level arithmetic;
// the exposure's exit obligation is now *proved from the extern's post*
// rather than assumed, which is what makes trusting a boundary different
// from trusting the compiler.
/// post ∀ i, 0 ≤ i → i < a.len → a.get i = v
pub fn fill_all(&mut [u8] a, u8 v) {
    u64 n = a.len;
    unsafe expose &mut a as (p, resource m) {
        c_fill(p, n, v, &mut m);
    }
}

// Effects are structural, so *undeclared mutation is impossible at the
// call boundary*. `c_checksum` takes its span as `resource &RawSpan` —
// shared — so the caller's view of the bytes survives the call untouched,
// and nothing in the extern's contract could say otherwise. There is no
// `modifies` clause to get wrong: what a foreign function may change is
// exactly what it was handed mutably.
/// pre  #[label(names)] p.alloc = mem.alloc ∧ p.off = mem.off
/// pre  #[label(fits)]  n ≤ mem.len
/// post #[label(range)] 0 ≤ result
pub extern "C" #[audit(id := "test.checksum.v1",
                       reason := "deterministic test shim: reads n bytes, writes nothing")]
fn c_checksum(raw<u8> p, u64 n, resource &RawSpan mem) -> u64;

// The array comes back byte for byte, and that is proved, not assumed:
// the shared borrow is what frames it.
/// post ∀ i, 0 ≤ i → i < a.len → a.get i = (old a).get i
pub fn checksum_all(&mut [u8] a) -> u64 {
    mut u64 s = 0;
    u64 n = a.len;
    unsafe expose &mut a as (p, resource m) {
        s = c_checksum(p, n, &m);
    }
    return s;
}
