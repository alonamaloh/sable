///     simp [Sable.FreeBlockView.toLease, Sable.FreeBlockView.prefix]
///   have hafterRemainder :=
///     Sable.AllocatorView.returnable_putHeaderOutside
///       hprefix (Or.inr (by
///         rw [hblockkey, hblocklen, hremkey]
///         omega))
///   have hfinalReturn :=
