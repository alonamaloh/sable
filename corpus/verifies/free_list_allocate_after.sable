///     Sable.PointsToView.clear,
///     Sable.AllocatorView.putHeader,
///     Sable.AllocatorView.takeHeader] using
///     hstored.2.2.2.2.2

/// discharge free_list_allocate_after.post.returnable by
///   obtain ⟨selectedHeader, hselectedStored, hselectedFields, hfit⟩ :=
///     h_pre_location.foundData (by simpa using h_pre_found)
