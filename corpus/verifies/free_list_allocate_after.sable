///         rw [Sable.RawPtr.add_off, h_pre_base.2, hlayout]
///         omega
///   constructor
///   · simp [Sable.FreeHeaderView.clearFields]
///   · simp [Sable.FreeHeaderView.clearFields]
///     rw [← hvalue]
///     omega

/// discharge free_list_allocate_after.allocator_put_header by
///   obtain ⟨selectedHeader, hselectedStored, hselectedFields, hfit⟩ :=
///     h_pre_location.foundData (by simpa using h_pre_found)
///   have hselected : _header2 = selectedHeader := by
///     rw [h_header2_take,
///       Sable.AllocatorView.storesHeader_headerAt hselectedStored]
///   have hmatch := h_pre_location.resultChain.takeMatchingHead
///     (by simpa using h_pre_found) hselectedStored hselectedFields
///   have hbefore :=
///     h_pre_location.predecessorBefore (by simpa using h_pre_interior)
///   have hneedpos : 0 < need := by
///     simp [Sable.freeHeaderBytes, Sable.u64.layout]
///       at h_pre_request
///     omega
///   have hproper : need < size := by
///     simp [Sable.freeHeaderBytes, Sable.u64.layout]
///       at h_pre_split
///     omega
///   have hkey : remainder_header.key = current + need := by
///     simp [h_remainder_header_init, h_header7_header,
///       h_free6_suffix, h_free4_block, h_selected_clear, hselected,
///       Sable.FreeHeaderView.putFields,
///       Sable.FreeBlockView.toHeader, Sable.FreeBlockView.suffix,
///       Sable.FreeHeaderView.toFree,
///       Sable.FreeHeaderView.clearFields,
///       hselectedStored.2.2.1]
///   have hslotOld := hmatch.2.1 (current + need)
///     (by omega) (by omega)
///   have hne : current + need ≠ previous := by omega
///   have hslot :
///       state_2.free (current + need) = none ∧
///       state_2.headers (current + need) = none := by
///     rw [h_state_take_header_2, h_state_take_header]
///     simpa [Sable.AllocatorView.takeHeader, hne] using hslotOld
///   unfold Sable.AllocatorView.canPutHeader
///   refine ⟨?_, h_remainder_header_wf, ?_, ?_⟩
///   · simpa [h_remainder_header_init, h_header7_header,
///       h_free6_suffix, h_free4_block, h_selected_clear,
///       Sable.FreeHeaderView.putFields,
///       Sable.FreeBlockView.toHeader, Sable.FreeBlockView.suffix,
///       Sable.FreeHeaderView.toFree,
///       Sable.FreeHeaderView.clearFields,
///       Sable.AllocatorView.takeHeader,
///       h_state_take_header_2] using h_header2_owner
///   · rw [hkey]
///     exact hslot.1
///   · rw [hkey]
///     exact hslot.2

/// discharge free_list_allocate_after.allocator_put_header.2 by
///   obtain ⟨header, previousSize, hstored, hfields, hrejected⟩ :=
///     h_pre_location.predecessor (by simpa using h_pre_interior)
///   have hbefore :=
///     h_pre_location.predecessorBefore (by simpa using h_pre_interior)
///   have htakeOld := Sable.AllocatorView.storesHeader_canTake hstored
///   have htakeState : state.canTakeHeader previous := by
///     rw [h_state_take_header]
///     exact Sable.AllocatorView.takeHeader_canTakeHeader_ne
///       _ htakeOld (by omega)
///   have horiginal : state_2.canPutHeader _header10 := by
///     rw [h_state_take_header_2, h_header10_take]
///     exact Sable.AllocatorView.takeHeader_canPutHeader
///       state previous htakeState
///   have hnode : _header10 = header := by
///     rw [h_header10_take, h_state_take_header,
///       Sable.AllocatorView.takeHeader_headerAt_ne _ (by omega),
///       Sable.AllocatorView.storesHeader_headerAt hstored]
///   have hheaderkey : _header10.key = previous := by
///     rw [hnode]
///     exact hstored.2.2.1
///   have hpredkey : predecessor_2.key = previous := by
///     simp [h_predecessor_init, h_predecessor_clear, hnode,
///       Sable.FreeHeaderView.putFields,
///       Sable.FreeHeaderView.clearFields,
///       hstored.2.2.1]
///   obtain ⟨selectedHeader, hselectedStored, hselectedFields, hfit⟩ :=
///     h_pre_location.foundData (by simpa using h_pre_found)
///   have hselected : _header2 = selectedHeader := by
///     rw [h_header2_take,
///       Sable.AllocatorView.storesHeader_headerAt hselectedStored]
///   have hremkey : remainder_header.key = current + need := by
///     simp [h_remainder_header_init, h_header7_header,
///       h_free6_suffix, h_free4_block, h_selected_clear, hselected,
///       Sable.FreeHeaderView.putFields,
///       Sable.FreeBlockView.toHeader, Sable.FreeBlockView.suffix,
///       Sable.FreeHeaderView.toFree,
///       Sable.FreeHeaderView.clearFields,
///       hselectedStored.2.2.1]
///   have hneedpos : 0 < need := by
///     simp [Sable.freeHeaderBytes, Sable.u64.layout]
///       at h_pre_request
///     omega
///   have hne : previous ≠ remainder_header.key := by
///     rw [hremkey]
///     omega
///   rw [h_state_put_header]
///   unfold Sable.AllocatorView.canPutHeader at horiginal ⊢
///   refine ⟨?_, h_predecessor_wf_2, ?_, ?_⟩
///   · simpa [h_predecessor_init, h_predecessor_clear,
///       Sable.FreeHeaderView.putFields,
///       Sable.FreeHeaderView.clearFields,
///       Sable.AllocatorView.putHeader] using horiginal.1
///   · simpa [Sable.AllocatorView.putHeader, hpredkey,
///       hheaderkey] using horiginal.2.2.1
///   · simpa [Sable.AllocatorView.putHeader, hpredkey,
///       hheaderkey, hne] using horiginal.2.2.2

/// discharge free_list_allocate_after.post.chain by
///   obtain ⟨selectedHeader, hselectedStored, hselectedFields, hfit⟩ :=
///     h_pre_location.foundData (by simpa using h_pre_found)
///   obtain ⟨predecessorHeader, previousSize, hpredecessorStored,
///       hpredecessorFields, hrejected⟩ :=
///     h_pre_location.predecessor (by simpa using h_pre_interior)
///   have hselected : _header2 = selectedHeader := by
///     rw [h_header2_take,
///       Sable.AllocatorView.storesHeader_headerAt hselectedStored]
///   have hbefore :=
///     h_pre_location.predecessorBefore (by simpa using h_pre_interior)
///   have hpredecessor : _header10 = predecessorHeader := by
///     rw [h_header10_take, h_state_take_header,
///       Sable.AllocatorView.takeHeader_headerAt_ne _ (by omega),
///       Sable.AllocatorView.storesHeader_headerAt hpredecessorStored]
///   have hvalue : previousSize = _value11 := by
///     rw [hpredecessor, hpredecessorFields.1]
///       at h_value11_header_size
///     injection h_value11_header_size
///   have hselectedMatch :=
///     h_pre_location.resultChain.takeMatchingHead
///       (by simpa using h_pre_found)
///       hselectedStored hselectedFields
///   have hremkey : remainder_header.key = current + need := by
///     simp [h_remainder_header_init, h_header7_header,
