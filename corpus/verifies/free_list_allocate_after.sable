///       hafterRemainder (Or.inl (by
///         rw [hpredkey, hblockkey]
///         omega))
///   rw [h_result, h_lease16_lease, h_state_put_header_2,
///     h_state_put_header, h_state_take_header_2,
///     h_state_take_header]
///   refine ⟨hfinalReturn, previous, current + need, ?_⟩
///   rw [hblockkey, hblocklen]
///   exact hlocation
