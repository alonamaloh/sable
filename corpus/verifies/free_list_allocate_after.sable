///       need ≤ selectedHeader.clearFields.toFree.toLease.span.len := by
///     change need ≤ selectedHeader.clearFields.toFree.span.len
///     rw [Sable.FreeHeaderView.clearFields_toFree_span_len,
///       hselectedMatch.1]
///     omega
///   have hprefix :
///       ((_old_state.takeHeader current).takeHeader previous
///         ).returnable block.toLease := by
///     rw [h_block_prefix, h_free4_block, h_selected_clear, hselected]
///     exact Sable.AllocatorView.returnable_prefix
///       hbare ⟨hneedpos, hneedle⟩
///   have hblockkey : block.toLease.key = current := by
///     rw [h_block_prefix, h_free4_block, h_selected_clear, hselected]
