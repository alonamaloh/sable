///     · rw [hremkey]
///       exact hslotBare.2
///   have hrelinked : predecessor_2 =
///       predecessorHeader.clearFields.putFields
///         previousSize (current + need) := by
///     rw [h_predecessor_init, h_predecessor_clear,
///       hpredecessor, ← hvalue]
///   have hcanrelinked :
///       (((_old_state.takeHeader current).takeHeader previous
///         ).putHeader remainder_header).canPutHeader predecessor_2 := by
///     rw [h_state_put_header, h_state_take_header_2,
///       h_state_take_header] at h_fact_sable_allocatorview_canp
///     exact h_fact_sable_allocatorview_canp
///   have hremmin : Sable.freeHeaderBytes ≤ size - need := by
///     omega
///   rw [h_state_put_header_2, h_state_put_header,
///     h_state_take_header_2, h_state_take_header]
///   exact h_pre_location.splitAfter
///     (by simpa using h_pre_found)
///     (by simpa using h_pre_interior)
///     hselectedStored hselectedFields
