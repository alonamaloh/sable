///     rw [h_block_prefix]
///     simp [Sable.FreeBlockView.toLease, Sable.FreeBlockView.prefix]
///   have hafterRemainder :=
///     Sable.AllocatorView.returnable_putHeaderOutside
///       hprefix (Or.inr (by
///         rw [hblockkey, hblocklen, hremkey]
///         omega))
///   have hfinal :=
///     Sable.AllocatorView.returnable_putHeaderOutside
///       hafterRemainder (Or.inl (by rw [hpredkey, hblockkey]; omega))
///   rw [h_result, h_lease16_lease, h_state_put_header_2,
///     h_state_put_header, h_state_take_header_2,
///     h_state_take_header]
///   exact hfinal

/// discharge free_list_allocate_after.post.returnable_in by
///   obtain ⟨selectedHeader, hselectedStored, hselectedFields, hfit⟩ :=
