///     hrelinked hcanrelinked h_pre_request.1 hremmin

/// discharge free_list_allocate_after.post.lease by
///   obtain ⟨header, hstored, hfields, hfit⟩ :=
///     h_pre_location.foundData (by simpa using h_pre_found)
///   have hnode : _header2 = header := by
///     rw [h_header2_take,
///       Sable.AllocatorView.storesHeader_headerAt hstored]
///   rw [h_result, h_lease16_lease, h_block_prefix,
///     h_free4_block, h_selected_clear, hnode]
///   simp [Sable.FreeBlockView.toLease,
///     Sable.FreeBlockView.prefix, Sable.SpanView.take,
///     Sable.FreeHeaderView.clearFields_toFree_key,
///     hstored.2.2.1]

/// discharge free_list_allocate_after.post.owner by
///   rw [h_result, h_lease16_lease, h_block_prefix,
///     h_state_put_header_2, h_state_put_header]
