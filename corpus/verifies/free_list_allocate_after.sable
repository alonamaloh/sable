///       Sable.FreeHeaderView.hasFields,
///       Sable.FreeHeaderView.putFields]
///   have hremextent :
///       remainder_header.toFree.span.len = size - need := by
///     rw [h_remainder_header_init, h_header7_header,
///       Sable.FreeBlockView.toHeader_putFields_toFree_span_len,
///       h_free6_split.2.2.2.2, h_free4_block,
///       h_selected_clear, hselected,
///       Sable.FreeHeaderView.clearFields_toFree_span_len,
///       hselectedMatch.1]
///   have hremroot : remainder_header.sizeCell.alloc =
