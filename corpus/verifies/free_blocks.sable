// Allocator-internal FreeBlock roles (ADR 0039): split and join stay inside
// the allocator; the client receives a nonsplittable BlockLease.

/// post result = 37
pub fn free_block_round_trip() -> u64 {
    unsafe system_alloc(16) as (base, resource mem, resource release);
    mut resource AllocatorState state = allocator_create(mem);
    mut resource FreeBlock left_block = allocator_take_free(&mut state, 0);
    resource FreeBlock suffix = free_block_split(&mut left_block, 8);
    resource BlockLease lease = free_block_lease(left_block);
    allocator_put_free(&mut state, suffix);

    mut u64 out = 0;
    unsafe {
        mut resource LeasedPointsTo<u64> cell = raw_into_cell_u64(base, lease);
        raw_cell_init_u64(base, 37, &mut cell);
        out = raw_cell_take_u64(base, &mut cell);
        resource BlockLease returned = raw_from_cell_u64(base, cell);
    }

    resource FreeBlock left = block_lease_free(returned);
    resource FreeBlock right = allocator_take_free(&mut state, 8);
    resource FreeBlock whole_free = free_block_join(left, right);
    allocator_put_free(&mut state, whole_free);
    resource RawSpan whole = allocator_destroy(state);
    unsafe system_dealloc(base, whole, release);
    return out;
}

