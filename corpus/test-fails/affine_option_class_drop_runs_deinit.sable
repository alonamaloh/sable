// expect-test-failure: pre of `require_zero` violated
// The at-least-once half of exact-once for the owning class option: a
// destructor whose body failure is visible proves the drop of a
// present payload really runs it. A compiler that destroyed nothing
// would pass the at-most-once half alone.

/// pre x = 0
fn require_zero(u64 x) -> u64 {
    return x;
}

pub class Loud {
    u64 armed;

    /// post self.armed = 1
    init arm() {
        self.armed = 1;
    }

    deinit {
        u64 w = require_zero(self.armed);
    }
}

fn test_drop_while_some_runs_the_deinit() {
    mut option<Loud> held = some(Loud::arm());
}
