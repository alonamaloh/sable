// Dynamic checks for the bignum layer: the natVal contracts of
// cmp/add/sub/mul/div/rem monitored per call, loop invariants (weighted
// carry and borrow sums, the schoolbook accumulator, the double-and-
// subtract quotient relation with its ghost natVal variant) checked per
// iteration, and the normalization invariant at init exits, RAII drops,
// and class-local reassignment drops. Limb counts stay small so the
// monitor's exact evaluation of pw/valIn never leaves i128.

/// def pw (n : int) : int := if 0 < n then 4294967296 * pw (n - 1) else 1
/// termination_by n.toNat
/// decreasing_by omega

/// def valIn (a : Sable.Seq Int) (i n : int) : int := if i < n then a.get i + 4294967296 * valIn a (i + 1) n else 0
/// termination_by (n - i).toNat
/// decreasing_by omega

/// def natVal (a : Sable.Seq Int) : int := valIn a 0 a.len

class Nat {
    [u32] limbs;

    /// invariant limbs.len = 0 ∨ limbs.get (limbs.len - 1) ≥ 1

    /// pre  n ≤ xs.len
    /// pre  n = 0 ∨ xs.get (n - 1) ≥ 1
    /// post #[label(len)]   self.limbs.len = n
    /// post #[label(value)] natVal self.limbs = valIn xs 0 n
    init from_prefix(&[u32] xs, u64 n) {
        self.limbs = alloc_array<u32>(n, 0);
        /// invariant ∀ k, 0 ≤ k → k < i → self.limbs.get k = xs.get k
        for (u64 i : range(n)) {
            self.limbs[i] = xs[i];
        }
    }

    deinit {
    }
}

// Limb selector: reading past the top yields 0, so mixed-length loops
// have no path split in their bodies.
/// post #[label(sel)] result = (if i < x.limbs.len then x.limbs.get i else 0)
fn limb_or0(&Nat x, u64 i) -> u32 {
    if (i < x.limbs.len) {
        return x.limbs[i];
    }
    return 0;
}

/// post #[label(pick)] result = (if x < y then y else x)
fn max_len(u64 x, u64 y) -> u64 {
    if (x < y) {
        return y;
    }
    return x;
}

// Normalization: the length after dropping leading zero limbs. The value
// is unchanged, and what remains has a nonzero top limb.
/// post #[label(le)]    result ≤ xs.len
/// post #[label(top)]   result = 0 ∨ xs.get (result - 1) ≥ 1
/// post #[label(value)] valIn xs 0 result = valIn xs 0 xs.len
fn trim_len(&[u32] xs) -> u64 {
    u64 rl = xs.len;
    /// invariant rl ≤ xs.len
    /// invariant valIn xs 0 rl = valIn xs 0 xs.len
    /// variant   rl
    while (rl > 0 && xs[rl - 1] == 0) {
        rl = rl - 1;
    }
    return rl;
}

/// post #[label(lt)] result = -1 ↔ natVal a.limbs < natVal b.limbs
/// post #[label(eq)] result = 0 ↔ natVal a.limbs = natVal b.limbs
/// post #[label(gt)] result = 1 ↔ natVal b.limbs < natVal a.limbs
/// post #[label(range)] result = -1 ∨ result = 0 ∨ result = 1
fn cmp(&Nat a, &Nat b) -> i32 {
    if (a.limbs.len < b.limbs.len) {
        return -1;
    }
    if (b.limbs.len < a.limbs.len) {
        return 1;
    }
    u64 i = a.limbs.len;
    /// invariant i ≤ a.limbs.len
    /// invariant ∀ k, i ≤ k → k < a.limbs.len → a.limbs.get k = b.limbs.get k
    /// variant   i
    while (i > 0) {
        i = i - 1;
        if (a.limbs[i] < b.limbs[i]) {
            return -1;
        }
        if (b.limbs[i] < a.limbs[i]) {
            return 1;
        }
    }
    return 0;
}

/// pre  a.limbs.len + b.limbs.len ≤ 4611686018427387904
/// post #[label(sum)] natVal result.limbs = natVal a.limbs + natVal b.limbs
fn add(&Nat a, &Nat b) -> Nat {
    u64 la = a.limbs.len;
    u64 lb = b.limbs.len;
    u64 n = max_len(la, lb) + 1;
    [u32] out = alloc_array<u32>(n, 0);
    u64 carry = 0;
    /// invariant carry ≤ 1
    /// invariant valIn out 0 i + carry * pw i = valIn a.limbs 0 (if i ≤ la then i else la) + valIn b.limbs 0 (if i ≤ lb then i else lb)
    for (u64 i : range(n)) {
        u64 x = widen<u64>(limb_or0(&a, i));
        u64 y = widen<u64>(limb_or0(&b, i));
        u64 s = carry + x + y;
        out[i] = narrow<u32>(s % 4294967296);
        carry = s / 4294967296;
    }
    u64 rl = trim_len(&out);
    var r = Nat::from_prefix(&out, rl);
    return r;
}

/// pre  natVal b.limbs ≤ natVal a.limbs
/// post #[label(diff)] natVal result.limbs = natVal a.limbs - natVal b.limbs
fn sub(&Nat a, &Nat b) -> Nat {
    u64 la = a.limbs.len;
    [u32] out = alloc_array<u32>(la, 0);
    u64 borrow = 0;
    /// invariant borrow ≤ 1
    /// invariant valIn out 0 i - borrow * pw i = valIn a.limbs 0 i - valIn b.limbs 0 (if i ≤ b.limbs.len then i else b.limbs.len)
    for (u64 i : range(la)) {
        u64 y = widen<u64>(limb_or0(&b, i));
        u64 s = widen<u64>(a.limbs[i]) + 4294967296 - y - borrow;
        out[i] = narrow<u32>(s % 4294967296);
        borrow = 1 - s / 4294967296;
    }
    u64 rl = trim_len(&out);
    var r = Nat::from_prefix(&out, rl);
    return r;
}

/// pre  a.limbs.len + b.limbs.len ≤ 4611686018427387904
/// post #[label(prod)] natVal result.limbs = natVal a.limbs * natVal b.limbs
fn mul(&Nat a, &Nat b) -> Nat {
    u64 la = a.limbs.len;
    u64 lb = b.limbs.len;
    u64 n = la + lb;
    [u32] out = alloc_array<u32>(n, 0);
    /// invariant valIn out 0 n = valIn a.limbs 0 i * valIn b.limbs 0 lb
    /// invariant ∀ k, i + lb ≤ k → k < n → out.get k = 0
    for (u64 i : range(la)) {
        u64 carry = 0;
        /// invariant carry ≤ 4294967295
        /// invariant valIn out 0 n + carry * pw (i + j) = valIn a.limbs 0 i * valIn b.limbs 0 lb + a.limbs.get i * valIn b.limbs 0 j * pw i
        /// invariant ∀ k, i + lb ≤ k → k < n → out.get k = 0
        for (u64 j : range(lb)) {
            u64 t = widen<u64>(out[i + j]) + widen<u64>(a.limbs[i]) * widen<u64>(b.limbs[j]) + carry;
            out[i + j] = narrow<u32>(t % 4294967296);
            carry = t / 4294967296;
        }
        out[i + lb] = narrow<u32>(carry);
    }
    u64 rl = trim_len(&out);
    var r = Nat::from_prefix(&out, rl);
    return r;
}

// Double-and-subtract long division, composed entirely from the verified
// operations above: d = b·m doubles until it overshoots the remainder,
// then q += m, r -= d. The outer invariant IS the specification; the
// Euclidean uniqueness lemma turns the exit facts into `/` and `%`.

/// pre  natVal b.limbs ≥ 1
/// pre  a.limbs.len + b.limbs.len ≤ 2305843009213693952
/// post #[label(quot)] natVal result.limbs = natVal a.limbs / natVal b.limbs
fn div(&Nat a, &Nat b) -> Nat {
    [u32] zarr = alloc_array<u32>(1, 0);
    [u32] onearr = alloc_array<u32>(1, 1);
    var zero = Nat::from_prefix(&zarr, 0);
    var q = Nat::from_prefix(&zarr, 0);
    var r = add(&a, &zero);
    i32 c = cmp(&r, &b);
    /// invariant natVal q.limbs * natVal b.limbs + natVal r.limbs = natVal a.limbs
    /// invariant (c = -1 ↔ natVal r.limbs < natVal b.limbs)
    /// invariant c = -1 ∨ c = 0 ∨ c = 1
    /// invariant q.limbs.len ≤ a.limbs.len
    /// invariant r.limbs.len ≤ a.limbs.len
    /// variant   natVal r.limbs
    while (c >= 0) {
        var d = add(&b, &zero);
        var m = Nat::from_prefix(&onearr, 1);
        var d2 = add(&d, &d);
        i32 t = cmp(&d2, &r);
        /// invariant natVal d.limbs = natVal b.limbs * natVal m.limbs
        /// invariant natVal b.limbs ≤ natVal d.limbs
        /// invariant natVal d.limbs ≤ natVal r.limbs
        /// invariant natVal d2.limbs = natVal d.limbs + natVal d.limbs
        /// invariant (t = -1 ↔ natVal d2.limbs < natVal r.limbs)
        /// invariant (t = 0 ↔ natVal d2.limbs = natVal r.limbs)
        /// invariant t = -1 ∨ t = 0 ∨ t = 1
        /// invariant d.limbs.len ≤ a.limbs.len
        /// invariant m.limbs.len ≤ a.limbs.len
        /// variant   natVal r.limbs - natVal d.limbs
        while (t <= 0) {
            d = add(&d, &d);
            m = add(&m, &m);
            d2 = add(&d, &d);
            t = cmp(&d2, &r);
        }
        q = add(&q, &m);
        r = sub(&r, &d);
        c = cmp(&r, &b);
    }
    return q;
}

/// pre  natVal b.limbs ≥ 1
/// pre  a.limbs.len + b.limbs.len ≤ 2305843009213693952
/// post #[label(rem)] natVal result.limbs = natVal a.limbs % natVal b.limbs
fn rem(&Nat a, &Nat b) -> Nat {
    var q = div(&a, &b);
    var p = mul(&q, &b);
    var r = sub(&a, &p);
    return r;
}
// ------------------------------ discharges ------------------------------
// The value-level reasoning: normalization at init exit, the trim
// step, and the cmp closers (first-difference, shorter-is-smaller,
// pointwise-equal-means-equal), all through the in-file lemmas.

// Monitored assertion: the pre is the check.
/// pre x = y
fn expect_eq(i32 x, i32 y) {
}

fn test_cmp_orderings() {
    [u32] xs = [ 7, 9 ];
    var a = Nat::from_prefix(&xs, 2);
    [u32] ys = [ 5 ];
    var b = Nat::from_prefix(&ys, 1);
    expect_eq(cmp(&b, &a), -1);
    expect_eq(cmp(&a, &b), 1);
    [u32] zs = [ 8, 9 ];
    var c = Nat::from_prefix(&zs, 2);
    expect_eq(cmp(&a, &c), -1);
    expect_eq(cmp(&c, &a), 1);
    expect_eq(cmp(&a, &a), 0);
}

fn test_add_carry_chain() {
    [u32] xs = [ 4294967295, 4294967295 ];
    var a = Nat::from_prefix(&xs, 2);
    [u32] ys = [ 1 ];
    var b = Nat::from_prefix(&ys, 1);
    var c = add(&a, &b);
    [u32] es = [ 0, 0, 1 ];
    var e = Nat::from_prefix(&es, 3);
    expect_eq(cmp(&c, &e), 0);
}

fn test_add_zero() {
    [u32] xs = [ 123456789, 42 ];
    var a = Nat::from_prefix(&xs, 2);
    [u32] ys = [ 1 ];
    var z = Nat::from_prefix(&ys, 0);
    var c = add(&a, &z);
    expect_eq(cmp(&c, &a), 0);
}

fn test_sub_roundtrip() {
    [u32] xs = [ 4294967295, 4294967295 ];
    var a = Nat::from_prefix(&xs, 2);
    [u32] ys = [ 4294967290, 1 ];
    var b = Nat::from_prefix(&ys, 2);
    var c = add(&a, &b);
    var d = sub(&c, &b);
    expect_eq(cmp(&d, &a), 0);
}

fn test_sub_to_zero() {
    [u32] xs = [ 17, 3 ];
    var a = Nat::from_prefix(&xs, 2);
    var d = sub(&a, &a);
    [u32] ys = [ 1 ];
    var z = Nat::from_prefix(&ys, 0);
    expect_eq(cmp(&d, &z), 0);
    var s = add(&d, &a);
    expect_eq(cmp(&s, &a), 0);
}

fn test_mul_single_limbs() {
    [u32] xs = [ 4294967295 ];
    var a = Nat::from_prefix(&xs, 1);
    var p = mul(&a, &a);
    [u32] es = [ 1, 4294967294 ];
    var e = Nat::from_prefix(&es, 2);
    expect_eq(cmp(&p, &e), 0);
}

fn test_mul_carry_rows() {
    [u32] xs = [ 4294967295, 4294967295 ];
    var a = Nat::from_prefix(&xs, 2);
    [u32] ys = [ 2 ];
    var b = Nat::from_prefix(&ys, 1);
    var p = mul(&a, &b);
    [u32] es = [ 4294967294, 4294967295, 1 ];
    var e = Nat::from_prefix(&es, 3);
    expect_eq(cmp(&p, &e), 0);
    var s = add(&a, &a);
    expect_eq(cmp(&p, &s), 0);
}

fn test_mul_zero() {
    [u32] xs = [ 9, 4 ];
    var a = Nat::from_prefix(&xs, 2);
    [u32] ys = [ 1 ];
    var z = Nat::from_prefix(&ys, 0);
    var p = mul(&a, &z);
    expect_eq(cmp(&p, &z), 0);
    var q = mul(&z, &a);
    expect_eq(cmp(&q, &z), 0);
}

fn test_div_exact_and_rounding() {
    [u32] xs = [ 4294967295, 4294967295 ];
    var a = Nat::from_prefix(&xs, 2);
    [u32] ys = [ 3 ];
    var b = Nat::from_prefix(&ys, 1);
    var q = div(&a, &b);
    var m = rem(&a, &b);
    var p = mul(&q, &b);
    var s = add(&p, &m);
    expect_eq(cmp(&s, &a), 0);
    var q2 = div(&a, &a);
    [u32] os = [ 1 ];
    var one = Nat::from_prefix(&os, 1);
    expect_eq(cmp(&q2, &one), 0);
}

fn test_div_small_by_large() {
    [u32] xs = [ 7 ];
    var a = Nat::from_prefix(&xs, 1);
    [u32] ys = [ 1, 1 ];
    var b = Nat::from_prefix(&ys, 2);
    var q = div(&a, &b);
    [u32] zs = [ 1 ];
    var z = Nat::from_prefix(&zs, 0);
    expect_eq(cmp(&q, &z), 0);
    var m = rem(&a, &b);
    expect_eq(cmp(&m, &a), 0);
}

fn test_div_by_one() {
    [u32] xs = [ 123456789, 42 ];
    var a = Nat::from_prefix(&xs, 2);
    [u32] os = [ 1 ];
    var one = Nat::from_prefix(&os, 1);
    var q = div(&a, &one);
    expect_eq(cmp(&q, &a), 0);
    var m = rem(&a, &one);
    [u32] zs = [ 1 ];
    var z = Nat::from_prefix(&zs, 0);
    expect_eq(cmp(&m, &z), 0);
}
