// Dynamic checks for the bignum layer: the natVal contracts of
// cmp/add/sub/mul/div/rem/gcd monitored per call, loop invariants (weighted
// carry and borrow sums, the schoolbook accumulator, the double-and-
// subtract quotient relation with its ghost natVal variant) checked per
// iteration, and the normalization invariant at init exits, RAII drops,
// and class-local reassignment drops. Limb counts stay small so the
// monitor's exact evaluation of pw/valIn never leaves i128.

// The multi-limb division tests drive add/sub/mul on values whose
// weighted loop invariants exceed the monitor's i128 ghost width;
// those subject clauses are deliberately unmonitorable at this
// magnitude (the verifier has proven them; the fences keep the
// zero-skip harness two-sided).
// expect-skip: valIn out 0 i + carry * pw i
// expect-skip: valIn out 0 n + carry * pw (i + j)
// expect-skip: valIn out 0 i - borrow * pw i

use bignum;

// Monitored assertion: the pre is the check.
/// pre x = y
fn expect_eq(i32 x, i32 y) {
}

fn test_cmp_orderings() {
    [u32] xs = [ 7, 9 ];
    var a = Nat::from_prefix(&xs, 2);
    [u32] ys = [ 5 ];
    var b = Nat::from_prefix(&ys, 1);
    expect_eq(cmp(&b, &a), -1);
    expect_eq(cmp(&a, &b), 1);
    [u32] zs = [ 8, 9 ];
    var c = Nat::from_prefix(&zs, 2);
    expect_eq(cmp(&a, &c), -1);
    expect_eq(cmp(&c, &a), 1);
    expect_eq(cmp(&a, &a), 0);
}

fn test_add_carry_chain() {
    [u32] xs = [ 4294967295, 4294967295 ];
    var a = Nat::from_prefix(&xs, 2);
    [u32] ys = [ 1 ];
    var b = Nat::from_prefix(&ys, 1);
    var c = add(&a, &b);
    [u32] es = [ 0, 0, 1 ];
    var e = Nat::from_prefix(&es, 3);
    expect_eq(cmp(&c, &e), 0);
}

fn test_add_zero() {
    [u32] xs = [ 123456789, 42 ];
    var a = Nat::from_prefix(&xs, 2);
    [u32] ys = [ 1 ];
    var z = Nat::from_prefix(&ys, 0);
    var c = add(&a, &z);
    expect_eq(cmp(&c, &a), 0);
}

fn test_sub_roundtrip() {
    [u32] xs = [ 4294967295, 4294967295 ];
    var a = Nat::from_prefix(&xs, 2);
    [u32] ys = [ 4294967290, 1 ];
    var b = Nat::from_prefix(&ys, 2);
    var c = add(&a, &b);
    var d = sub(&c, &b);
    expect_eq(cmp(&d, &a), 0);
}

fn test_sub_to_zero() {
    [u32] xs = [ 17, 3 ];
    var a = Nat::from_prefix(&xs, 2);
    var d = sub(&a, &a);
    [u32] ys = [ 1 ];
    var z = Nat::from_prefix(&ys, 0);
    expect_eq(cmp(&d, &z), 0);
    var s = add(&d, &a);
    expect_eq(cmp(&s, &a), 0);
}

fn test_mul_single_limbs() {
    [u32] xs = [ 4294967295 ];
    var a = Nat::from_prefix(&xs, 1);
    var p = mul(&a, &a);
    [u32] es = [ 1, 4294967294 ];
    var e = Nat::from_prefix(&es, 2);
    expect_eq(cmp(&p, &e), 0);
}

fn test_mul_carry_rows() {
    [u32] xs = [ 4294967295, 4294967295 ];
    var a = Nat::from_prefix(&xs, 2);
    [u32] ys = [ 2 ];
    var b = Nat::from_prefix(&ys, 1);
    var p = mul(&a, &b);
    [u32] es = [ 4294967294, 4294967295, 1 ];
    var e = Nat::from_prefix(&es, 3);
    expect_eq(cmp(&p, &e), 0);
    var s = add(&a, &a);
    expect_eq(cmp(&p, &s), 0);
}

fn test_mul_zero() {
    [u32] xs = [ 9, 4 ];
    var a = Nat::from_prefix(&xs, 2);
    [u32] ys = [ 1 ];
    var z = Nat::from_prefix(&ys, 0);
    var p = mul(&a, &z);
    expect_eq(cmp(&p, &z), 0);
    var q = mul(&z, &a);
    expect_eq(cmp(&q, &z), 0);
}

fn test_div_exact_and_rounding() {
    [u32] xs = [ 4294967295, 4294967295 ];
    var a = Nat::from_prefix(&xs, 2);
    [u32] ys = [ 3 ];
    var b = Nat::from_prefix(&ys, 1);
    var q = div(&a, &b);
    var m = rem(&a, &b);
    var p = mul(&q, &b);
    var s = add(&p, &m);
    expect_eq(cmp(&s, &a), 0);
    var q2 = div(&a, &a);
    [u32] os = [ 1 ];
    var one = Nat::from_prefix(&os, 1);
    expect_eq(cmp(&q2, &one), 0);
}

fn test_div_small_by_large() {
    [u32] xs = [ 7 ];
    var a = Nat::from_prefix(&xs, 1);
    [u32] ys = [ 1, 1 ];
    var b = Nat::from_prefix(&ys, 2);
    var q = div(&a, &b);
    [u32] zs = [ 1 ];
    var z = Nat::from_prefix(&zs, 0);
    expect_eq(cmp(&q, &z), 0);
    var m = rem(&a, &b);
    expect_eq(cmp(&m, &a), 0);
}

fn test_div_by_one() {
    [u32] xs = [ 123456789, 42 ];
    var a = Nat::from_prefix(&xs, 2);
    [u32] os = [ 1 ];
    var one = Nat::from_prefix(&os, 1);
    var q = div(&a, &one);
    expect_eq(cmp(&q, &a), 0);
    var m = rem(&a, &one);
    [u32] zs = [ 1 ];
    var z = Nat::from_prefix(&zs, 0);
    expect_eq(cmp(&m, &z), 0);
}

fn test_gcd_basics() {
    [u32] xs = [ 12 ];
    var a = Nat::from_prefix(&xs, 1);
    [u32] ys = [ 18 ];
    var b = Nat::from_prefix(&ys, 1);
    var g = gcd(&a, &b);
    [u32] es = [ 6 ];
    var e = Nat::from_prefix(&es, 1);
    expect_eq(cmp(&g, &e), 0);
    var g2 = gcd(&b, &a);
    expect_eq(cmp(&g2, &e), 0);
}

fn test_gcd_zero_and_self() {
    [u32] xs = [ 40, 2 ];
    var a = Nat::from_prefix(&xs, 2);
    [u32] zs = [ 1 ];
    var z = Nat::from_prefix(&zs, 0);
    var g = gcd(&a, &z);
    expect_eq(cmp(&g, &a), 0);
    var g2 = gcd(&z, &a);
    expect_eq(cmp(&g2, &a), 0);
    var g3 = gcd(&a, &a);
    expect_eq(cmp(&g3, &a), 0);
}

fn test_gcd_coprime_and_multilimb() {
    [u32] xs = [ 35 ];
    var a = Nat::from_prefix(&xs, 1);
    [u32] ys = [ 64 ];
    var b = Nat::from_prefix(&ys, 1);
    var g = gcd(&a, &b);
    [u32] os = [ 1 ];
    var one = Nat::from_prefix(&os, 1);
    expect_eq(cmp(&g, &one), 0);
    [u32] cs = [ 0, 6 ];
    var c = Nat::from_prefix(&cs, 2);
    [u32] ds = [ 0, 4 ];
    var d = Nat::from_prefix(&ds, 2);
    var g2 = gcd(&c, &d);
    [u32] es = [ 0, 2 ];
    var e = Nat::from_prefix(&es, 2);
    expect_eq(cmp(&g2, &e), 0);
}

fn test_div_multilimb_small_top() {
    // Divisor with a tiny top limb maximizes normalization (the q̂
    // estimate path); quotient and remainder reconstruct the dividend.
    [u32] xs = [ 4054939, 2882400001, 305419896 ];
    var a = Nat::from_prefix(&xs, 3);
    [u32] ys = [ 4294967295, 1 ];
    var b = Nat::from_prefix(&ys, 2);
    var q = a / b;
    var r = a % b;
    var p = q * b;
    var s = p + r;
    expect_eq(cmp(&s, &a), 0);
    expect_eq(cmp(&r, &b), -1);
}

fn test_div_near_multiple() {
    // Dividend one below and one above a multiple of the divisor.
    [u32] xs = [ 1000000007 ];
    var b = Nat::from_prefix(&xs, 1);
    [u32] os = [ 1 ];
    var one = Nat::from_prefix(&os, 1);
    var m = b * b;
    var lo = m - one;
    var hi = m + one;
    var qlo = lo / b;
    var qhi = hi / b;
    var d = b - one;
    expect_eq(cmp(&qlo, &d), 0);
    expect_eq(cmp(&qhi, &b), 0);
    var rlo = lo % b;
    expect_eq(cmp(&rlo, &d), 0);
}

fn test_div_wide_by_two_limbs() {
    // 4-limb by 2-limb schoolbook path, several digit iterations.
    [u32] xs = [ 3735928559, 3405691582, 2596069104, 39 ];
    var a = Nat::from_prefix(&xs, 4);
    [u32] ys = [ 2882343476, 76 ];
    var b = Nat::from_prefix(&ys, 2);
    var q = a / b;
    var r = a % b;
    var p = q * b;
    var s = p + r;
    expect_eq(cmp(&s, &a), 0);
    expect_eq(cmp(&r, &b), -1);
}
