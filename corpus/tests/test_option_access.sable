// Dynamic checks over option accessors (ADR 0008): accessor-style
// contracts are fully monitorable — `.is_some`/`.value` in clause text
// evaluate with the same junk-on-none convention as the model.

use option_access;

fn test_option_roundtrip() {
    use_it(0);
    use_it(41);
    use_it(1000);
    incr_nonneg(-5);
    incr_nonneg(-1);
}

// Precedence guard: `↔` must parse at Lean's precedence (loosest — below
// ∧/∨/→). Under Lean's parse this post is (1 = 2 ∧ result) ↔ 1 = 2,
// which holds for result = true. Any tighter `↔` makes it false (or
// unparseable), so this test plus the zero-skip harness pin the
// monitor's grammar to Lean's.

/// post 1 = 2 ∧ result ↔ 1 = 2
fn iff_precedence_witness() -> bool {
    return true;
}

fn test_iff_precedence() {
    iff_precedence_witness();
}
