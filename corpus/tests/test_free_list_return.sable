fn test_return_inserts_when_separated() {
    unsafe system_alloc(112) as (base, resource mem, resource release);
    mut resource AllocatorState state = allocator_create(mem);
    mut resource FreeBlock predecessor_block =
        allocator_take_free(&mut state, 0);
    mut resource FreeBlock left_gap_block =
        free_block_split(&mut predecessor_block, 24);
    mut resource FreeBlock returned_block =
        free_block_split(&mut left_gap_block, 16);
    mut resource FreeBlock right_gap_block =
        free_block_split(&mut returned_block, 16);
    resource FreeBlock successor_block =
        free_block_split(&mut right_gap_block, 16);
    resource BlockLease left_gap = free_block_lease(left_gap_block);
    resource BlockLease returned = free_block_lease(returned_block);
    resource BlockLease right_gap = free_block_lease(right_gap_block);

    unsafe {
        raw<u8> successor_ptr = raw_offset(base, 72);
        mut resource FreeHeader successor =
            raw_into_free_header(successor_ptr, successor_block);
        raw_header_init(successor_ptr, 40, 112, &mut successor);
    }
    allocator_put_header(&mut state, successor);
    unsafe {
        mut resource FreeHeader predecessor =
            raw_into_free_header(base, predecessor_block);
        raw_header_init(base, 24, 72, &mut predecessor);
    }
    allocator_put_header(&mut state, predecessor);
    var mut list = FreeListState::make(0, 112);

    free_list_return(base, &mut list, &mut state, 40, 16, returned);

    mut resource FreeHeader predecessor_cleanup =
        allocator_take_header(&mut state, 0);
    mut u64 predecessor_next = 0;
    unsafe {
        predecessor_next = raw_header_next(base, &predecessor_cleanup);
        raw_header_clear(base, &mut predecessor_cleanup);
        resource FreeBlock predecessor_free =
            raw_from_free_header(base, predecessor_cleanup);
    }
    expect_eq_u64(predecessor_next, 40);

    mut resource FreeHeader inserted_cleanup =
        allocator_take_header(&mut state, 40);
    mut u64 inserted_size = 0;
    mut u64 inserted_next = 0;
    unsafe {
        raw<u8> inserted_ptr = raw_offset(base, 40);
        inserted_size = raw_header_size(inserted_ptr, &inserted_cleanup);
        inserted_next = raw_header_next(inserted_ptr, &inserted_cleanup);
        raw_header_clear(inserted_ptr, &mut inserted_cleanup);
        resource FreeBlock inserted_free =
            raw_from_free_header(inserted_ptr, inserted_cleanup);
    }
    expect_eq_u64(inserted_size, 16);
    expect_eq_u64(inserted_next, 72);

    mut resource FreeHeader successor_cleanup =
        allocator_take_header(&mut state, 72);
    unsafe {
        raw<u8> successor_cleanup_ptr = raw_offset(base, 72);
        raw_header_clear(successor_cleanup_ptr, &mut successor_cleanup);
        resource FreeBlock successor_free =
            raw_from_free_header(successor_cleanup_ptr, successor_cleanup);
    }
    resource FreeBlock left_gap_free = block_lease_free(left_gap);
    resource FreeBlock right_gap_free = block_lease_free(right_gap);
    resource FreeBlock first =
        free_block_join(predecessor_free, left_gap_free);
    resource FreeBlock second = free_block_join(first, inserted_free);
    resource FreeBlock third = free_block_join(second, right_gap_free);
    resource FreeBlock whole_free = free_block_join(third, successor_free);
    allocator_put_free(&mut state, whole_free);
    resource RawSpan whole = allocator_destroy(state);
    unsafe system_dealloc(base, whole, release);
}
