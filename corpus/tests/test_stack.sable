// Dynamic checks over the class machinery: posts (including the
// structure-equality `self = old self`), the class invariant at init
// and &mut-method exits, and at RAII drop.

use bounded_stack;

fn test_push_pop_roundtrip() {
    var s = BoundedStack::with_capacity(3);
    s.push(10);
    s.push(20);
    s.pop();
    s.pop();
    s.pop();
}

fn test_push_to_capacity_and_overflow() {
    var s = BoundedStack::with_capacity(2);
    s.push(1);
    s.push(2);
    s.push(3);
    s.pop();
}
