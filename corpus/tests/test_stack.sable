// Dynamic checks over the class machinery: posts (including the
// structure-equality `self = old self`), the class invariant at init
// and &mut-method exits, and at RAII drop.

class BoundedStack {
    [i32] buf;
    u64  len;

    /// invariant len ≤ buf.len
    /// invariant buf.len > 0

    /// pre cap > 0
    init with_capacity(u64 cap) {
        self.buf = alloc_array<i32>(cap, 0);
        self.len = 0;
    }

    /// post result  → self.len = old self.len + 1 ∧ self.buf.get (old self.len) = x
    /// post ¬result → self = old self
    fn push(&mut self, i32 x) -> bool {
        if (self.len == self.buf.len) { return false; }
        self.buf[self.len] = x;
        self.len = self.len + 1;
        return true;
    }

    /// post old self.len = 0 → result = none
    /// post old self.len > 0 → result = some (self.buf.get (old self.len - 1))
    fn pop(&mut self) -> option<i32> {
        if (self.len == 0) { return none; }
        self.len = self.len - 1;
        return some(self.buf[self.len]);
    }

    deinit {
    }
}

fn test_push_pop_roundtrip() {
    var s = BoundedStack::with_capacity(3);
    s.push(10);
    s.push(20);
    s.pop();
    s.pop();
    s.pop();
}

fn test_push_to_capacity_and_overflow() {
    var s = BoundedStack::with_capacity(2);
    s.push(1);
    s.push(2);
    s.push(3);
    s.pop();
}
