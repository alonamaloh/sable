// Dynamic checks over the JSON tokenizer. The recursive grammar
// predicates (strTail/lexable) and ∃-split posts are kernel-verified in
// the verifies file and unmonitorable here (unbounded ∀/recursion over
// all ends); this copy carries the phase contracts that are — digit
// runs, hex classification, phase bounds — plus behavioral wrappers
// whose posts the monitor checks per call.

/// def isWs (c : int) : Prop := c = 32 ∨ c = 9 ∨ c = 10 ∨ c = 13

/// def digitc (c : int) : Prop := 48 ≤ c ∧ c ≤ 57

/// def hexd (c : int) : Prop := (48 ≤ c ∧ c ≤ 57) ∨ (65 ≤ c ∧ c ≤ 70) ∨ (97 ≤ c ∧ c ≤ 102)

/// def escc (c : int) : Prop := c = 34 ∨ c = 92 ∨ c = 47 ∨ c = 98 ∨ c = 102 ∨ c = 110 ∨ c = 114 ∨ c = 116

/// def strTail (b : Sable.Seq Int) (i j : int) : Prop :=
///   if j ≤ i then False
///   else if b.get i = 34 then j = i + 1
///   else if b.get i = 92 then
///     (b.get (i + 1) = 117 ∧ hexd (b.get (i + 2)) ∧ hexd (b.get (i + 3)) ∧
/// termination_by (j - i).toNat
/// decreasing_by
///   all_goals omega

/// def jstring (b : Sable.Seq Int) (i j : int) : Prop := b.get i = 34 ∧ strTail b (i + 1) j

/// def digits (b : Sable.Seq Int) (i j : int) : Prop := i < j ∧ ∀ k, i ≤ k → k < j → digitc (b.get k)

/// def jint (b : Sable.Seq Int) (i j : int) : Prop := (b.get i = 48 ∧ j = i + 1) ∨ (49 ≤ b.get i ∧ b.get i ≤ 57 ∧ digits b i j)

/// def jfrac (b : Sable.Seq Int) (i j : int) : Prop := i = j ∨ (b.get i = 46 ∧ digits b (i + 1) j)

/// def jexp (b : Sable.Seq Int) (i j : int) : Prop := i = j ∨ ((b.get i = 101 ∨ b.get i = 69) ∧ (digits b (i + 1) j ∨ ((b.get (i + 1) = 43 ∨ b.get (i + 1) = 45) ∧ digits b (i + 2) j)))

/// def jnumber (b : Sable.Seq Int) (i j : int) : Prop := ∃ p q, ((b.get i = 45 ∧ jint b (i + 1) p) ∨ (b.get i ≠ 45 ∧ jint b i p)) ∧ jfrac b p q ∧ jexp b q j ∧ i < p ∧ p ≤ q ∧ q ≤ j

/// def jpunct (c : int) : Prop := c = 123 ∨ c = 125 ∨ c = 91 ∨ c = 93 ∨ c = 58 ∨ c = 44

/// def jtoken (b : Sable.Seq Int) (i j : int) : Prop :=
///   (jpunct (b.get i) ∧ j = i + 1) ∨
///   (b.get i = 116 ∧ b.get (i + 1) = 114 ∧ b.get (i + 2) = 117 ∧ b.get (i + 3) = 101 ∧ j = i + 4) ∨
///   (b.get i = 102 ∧ b.get (i + 1) = 97 ∧ b.get (i + 2) = 108 ∧ b.get (i + 3) = 115 ∧ b.get (i + 4) = 101 ∧ j = i + 5) ∨
///   (b.get i = 110 ∧ b.get (i + 1) = 117 ∧ b.get (i + 2) = 108 ∧ b.get (i + 3) = 108 ∧ j = i + 4) ∨

/// def lexable (b : Sable.Seq Int) (pos : int) : Prop :=
///   if b.len ≤ pos then True
/// termination_by (b.len - pos).toNat
/// decreasing_by
///   all_goals first | omega | (split <;> omega)

// ------------------------------------------------------- phase helpers

/// pre  i ≤ b.len
/// pre  b.len ≤ 4611686018427387904
/// post i ≤ result ∧ result ≤ b.len
/// post ∀ k, i ≤ k → k < result → digitc (b.get k)
/// post result < b.len → ¬digitc (b.get result)
/// post i < b.len → digitc (b.get i) → i < result
fn digit_run(&[u8] b, u64 i) -> u64 {
    u64 j = i;
    u64 n = b.len;
    /// invariant i ≤ j ∧ j ≤ n
    /// invariant ∀ k, i ≤ k → k < j → digitc (b.get k)
    /// variant   n - j
    while (j < n) {
        u8 c = b[j];
        if (c < 48 || c > 57) {
            return j;
        }
        j = j + 1;
    }
    return j;
}

/// post result ↔ hexd c
fn hexd_ok(u8 c) -> bool {
    if (c >= 48 && c <= 57) {
        return true;
    }
    if (c >= 65 && c <= 70) {
        return true;
    }
    if (c >= 97 && c <= 102) {
        return true;
    }
    return false;
}

// `jint_scan` consumes `-? (0 | [1-9][0-9]*)` starting at `pos`;
// `jfrac_scan`/`jexp_scan` consume an OPTIONAL fraction/exponent
// (returning their start unchanged when absent). All return 0 on a
// malformed phase.

/// pre  pos < b.len
/// pre  b.len ≤ 4611686018427387904
/// post result ≠ 0 → pos < result ∧ result ≤ b.len ∧ ((b.get pos = 45 ∧ jint b (pos + 1) result) ∨ (b.get pos ≠ 45 ∧ jint b pos result))
fn jint_scan(&[u8] b, u64 pos) -> u64 {
    u64 n = b.len;
    u64 i = pos;
    if (b[i] == 45) {
        i = i + 1;
        if (i >= n) {
            return 0;
        }
    }
    u8 c0 = b[i];
    if (c0 == 48) {
        return i + 1;
    }
    if (c0 < 49 || c0 > 57) {
        return 0;
    }
    u64 e = digit_run(&b, i);
    return e;
}

/// pre  i ≤ b.len
/// pre  b.len ≤ 4611686018427387904
/// post result ≠ 0 → i ≤ result ∧ result ≤ b.len ∧ jfrac b i result
fn jfrac_scan(&[u8] b, u64 i) -> u64 {
    u64 n = b.len;
    if (i >= n) {
        return i;
    }
    if (b[i] != 46) {
        return i;
    }
    u64 d = i + 1;
    if (d >= n) {
        return 0;
    }
    if (b[d] < 48 || b[d] > 57) {
        return 0;
    }
    u64 e = digit_run(&b, d);
    return e;
}

/// pre  i ≤ b.len
/// pre  b.len ≤ 4611686018427387904
/// post result ≠ 0 → i ≤ result ∧ result ≤ b.len ∧ jexp b i result
fn jexp_scan(&[u8] b, u64 i) -> u64 {
    u64 n = b.len;
    if (i >= n) {
        return i;
    }
    if (b[i] != 101 && b[i] != 69) {
        return i;
    }
    u64 d = i + 1;
    if (d >= n) {
        return 0;
    }
    if (b[d] == 43 || b[d] == 45) {
        u64 d2 = d + 1;
        if (d2 >= n) {
            return 0;
        }
        if (b[d2] < 48 || b[d2] > 57) {
            return 0;
        }
        u64 e2 = digit_run(&b, d2);
        return e2;
    }
    if (b[d] < 48 || b[d] > 57) {
        return 0;
    }
    u64 e = digit_run(&b, d);
    return e;
}

// --------------------------------------------------------- the lexemes

/// pre  pos < b.len
/// pre  b.len ≤ 4611686018427387904
fn json_number_end(&[u8] b, u64 pos) -> u64 {
    u64 a1 = jint_scan(&b, pos);
    if (a1 == 0) {
        return 0;
    }
    u64 a2 = jfrac_scan(&b, a1);
    if (a2 == 0) {
        return 0;
    }
    u64 a3 = jexp_scan(&b, a2);
    if (a3 == 0) {
        return 0;
    }
    return a3;
}

/// pre  pos < b.len
/// pre  b.len ≤ 4611686018427387904
/// pre  b.get pos = 34
fn json_string_end(&[u8] b, u64 pos) -> u64 {
    u64 n = b.len;
    u64 i = pos + 1;
    /// invariant pos < i ∧ i ≤ n
    /// variant   n - i
    while (i < n) {
        u8 c = b[i];
        if (c == 34) {
            return i + 1;
        }
        if (c == 92) {
            if (i + 1 >= n) {
                return 0;
            }
            u8 e = b[i + 1];
            if (e == 117) {
                if (i + 5 >= n) {
                    return 0;
                }
                bool h2 = hexd_ok(b[i + 2]);
                bool h3 = hexd_ok(b[i + 3]);
                bool h4 = hexd_ok(b[i + 4]);
                bool h5 = hexd_ok(b[i + 5]);
                if (!h2 || !h3 || !h4 || !h5) {
                    return 0;
                }
                i = i + 6;
            } else {
                if (e != 34 && e != 92 && e != 47 && e != 98 && e != 102 && e != 110 && e != 114 && e != 116) {
                    return 0;
                }
                i = i + 2;
            }
        } else {
            if (c < 32) {
                return 0;
            }
            i = i + 1;
        }
    }
    return 0;
}

/// pre  pos < b.len
/// pre  b.len ≤ 4611686018427387904
fn json_token(&[u8] b, u64 pos) -> u64 {
    u64 n = b.len;
    u8 c = b[pos];
    if (c == 123 || c == 125 || c == 91 || c == 93 || c == 58 || c == 44) {
        return pos + 1;
    }
    if (c == 116) {
        if (pos + 3 >= n) {
            return 0;
        }
        if (b[pos + 1] == 114 && b[pos + 2] == 117 && b[pos + 3] == 101) {
            return pos + 4;
        }
        return 0;
    }
    if (c == 102) {
        if (pos + 4 >= n) {
            return 0;
        }
        if (b[pos + 1] == 97 && b[pos + 2] == 108 && b[pos + 3] == 115 && b[pos + 4] == 101) {
            return pos + 5;
        }
        return 0;
    }
    if (c == 110) {
        if (pos + 3 >= n) {
            return 0;
        }
        if (b[pos + 1] == 117 && b[pos + 2] == 108 && b[pos + 3] == 108) {
            return pos + 4;
        }
        return 0;
    }
    if (c == 34) {
        u64 es = json_string_end(&b, pos);
        return es;
    }
    if (c == 45 || (c >= 48 && c <= 57)) {
        u64 en = json_number_end(&b, pos);
        return en;
    }
    return 0;
}

// ---------------------------------------------------------- the capstone

/// pre  b.len ≤ 4611686018427387904
fn json_lex_ok(&[u8] b) -> bool {
    u64 pos = 0;
    u64 n = b.len;
    /// invariant pos ≤ n
    /// variant   n - pos
    while (pos < n) {
        u8 c = b[pos];
        if (c == 32 || c == 9 || c == 10 || c == 13) {
            pos = pos + 1;
        } else {
            u64 e = json_token(&b, pos);
            if (e == 0) {
                return false;
            }
            pos = e;
        }
    }
    return true;
}

// ------------------------------------------------------------ discharges



/// pre  b.len ≤ 4611686018427387904
/// post result
fn expect_lex_ok(&[u8] b) -> bool {
    return json_lex_ok(&b);
}

/// pre  b.len ≤ 4611686018427387904
/// post ¬result
fn expect_lex_bad(&[u8] b) -> bool {
    return json_lex_ok(&b);
}

fn test_valid_json() {
    [u8] empty = [];
    expect_lex_ok(&empty);
    [u8] obj = [123, 34, 107, 101, 121, 34, 58, 32, 91, 49, 44, 32, 50, 46, 53, 101, 45, 51, 44, 32, 116, 114, 117, 101, 44, 32, 110, 117, 108, 108, 93, 44, 32, 34, 98, 34, 58, 32, 34, 97, 92, 117, 48, 48, 52, 49, 98, 34, 125];
    expect_lex_ok(&obj);
    [u8] nums = [91, 48, 44, 32, 45, 49, 44, 32, 49, 50, 46, 55, 53, 44, 32, 49, 101, 49, 48, 44, 32, 50, 69, 43, 56, 44, 32, 45, 48, 46, 53, 101, 45, 50, 93];
    expect_lex_ok(&nums);
    [u8] esc = [34, 97, 92, 110, 32, 98, 92, 116, 32, 99, 92, 92, 32, 100, 92, 34, 32, 101, 47, 34];
    expect_lex_ok(&esc);
    [u8] ws = [32, 32, 91, 32, 116, 114, 117, 101, 32, 44, 32, 102, 97, 108, 115, 101, 32, 93, 32, 32];
    expect_lex_ok(&ws);
}

fn test_invalid_json() {
    [u8] unterminated = [34, 97, 98, 99];
    expect_lex_bad(&unterminated);
    [u8] badesc = [34, 97, 92, 113, 98, 34];
    expect_lex_bad(&badesc);
    [u8] badhex = [34, 92, 117, 49, 50, 71, 52, 34];
    expect_lex_bad(&badhex);
    [u8] ctrl = [34, 7, 34];
    expect_lex_bad(&ctrl);
    [u8] trunclit = [116, 114, 117, 93];
    expect_lex_bad(&trunclit);
    [u8] badexp = [49, 101, 43];
    expect_lex_bad(&badexp);
    [u8] plus = [43, 49];
    expect_lex_bad(&plus);
    [u8] dot = [46, 53];
    expect_lex_bad(&dot);
    [u8] bare = [120];
    expect_lex_bad(&bare);
}
