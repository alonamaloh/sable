// Dynamic checks over the JSON tokenizer. The recursive grammar
// predicates (strTail/lexable) and ∃-split posts are kernel-verified in
// the imported module and unmonitorable here (unbounded ∀/recursion
// over all ends, fenced below); the wrappers carry posts the monitor
// checks per call.
// expect-skip: ∀ e2, strTail b i e2
// expect-skip: lexable b pos → lexable b 0
// expect-skip: result → lexable b 0
// expect-skip: ∧ jstring b pos result
// expect-skip: ∧ jtoken b pos result

use json_lex;

/// pre  b.len ≤ 4611686018427387904
/// post result
fn expect_lex_ok(&[u8] b) -> bool {
    return json_lex_ok(&b);
}

/// pre  b.len ≤ 4611686018427387904
/// post ¬result
fn expect_lex_bad(&[u8] b) -> bool {
    return json_lex_ok(&b);
}

fn test_valid_json() {
    [u8] empty = [];
    expect_lex_ok(&empty);
    [u8] obj = b"{\"key\": [1, 2.5e-3, true, null], \"b\": \"a\\u0041b\"}";
    expect_lex_ok(&obj);
    [u8] nums = b"[0, -1, 12.75, 1e10, 2E+8, -0.5e-2]";
    expect_lex_ok(&nums);
    [u8] esc = b"\"a\\n b\\t c\\\\ d\\\" e/\"";
    expect_lex_ok(&esc);
    [u8] ws = b"  [ true , false ]  ";
    expect_lex_ok(&ws);
}

fn test_invalid_json() {
    [u8] unterminated = b"\"abc";
    expect_lex_bad(&unterminated);
    [u8] badesc = b"\"a\\qb\"";
    expect_lex_bad(&badesc);
    [u8] badhex = b"\"\\u12G4\"";
    expect_lex_bad(&badhex);
    [u8] ctrl = b"\"\x07\"";
    expect_lex_bad(&ctrl);
    [u8] trunclit = b"tru]";
    expect_lex_bad(&trunclit);
    [u8] badexp = b"1e+";
    expect_lex_bad(&badexp);
    [u8] plus = b"+1";
    expect_lex_bad(&plus);
    [u8] dot = b".5";
    expect_lex_bad(&dot);
    [u8] bare = b"x";
    expect_lex_bad(&bare);
}
