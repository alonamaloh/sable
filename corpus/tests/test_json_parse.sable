// Dynamic checks over the JSON parser. The recursive grammar predicate
// (jgram) and its dependents are kernel-verified in the imported
// module and unmonitorable here (unbounded ∃ under recursion, fenced
// below); the wrappers carry posts the monitor checks per call.
// expect-skip: ∀ e2, jgram b 4 cur e2
// expect-skip: ∀ e2, jgram b 6 cura e2
// expect-skip: ∀ e2, strTail b i e2
// expect-skip: result → (∃ e, jgram b 0 0 e
// expect-skip: ∧ jgram b 0 pos result

use json_parse;

/// pre  b.len ≤ MAX_BYTES
/// post result
fn expect_json(&[u8] b) -> bool {
    return json_valid(&b);
}

/// pre  b.len ≤ MAX_BYTES
/// post ¬result
fn expect_bad(&[u8] b) -> bool {
    return json_valid(&b);
}

fn test_valid_documents() {
    [u8] scalar = b"42";
    expect_json(&scalar);
    [u8] str1 = b"\"hello\"";
    expect_json(&str1);
    [u8] lit = b"  true  ";
    expect_json(&lit);
    [u8] obj = b"{\"a\": 1, \"b\": [true, null, -2.5e3], \"c\": {\"d\": \"x\"}}";
    expect_json(&obj);
    [u8] arr = b" [ 1 , [ 2 , [ 3 ] ] , {} , [] ] ";
    expect_json(&arr);
    [u8] deep = b"{\"k\" : { \"l\" : { \"m\" : [ \"deep\" , 0 ] } } }";
    expect_json(&deep);
}

fn test_invalid_documents() {
    [u8] empty = [];
    expect_bad(&empty);
    [u8] trail = b"42 x";
    expect_bad(&trail);
    [u8] unclosed = b"{\"a\": 1";
    expect_bad(&unclosed);
    [u8] noval = b"{\"a\": }";
    expect_bad(&noval);
    [u8] nocolon = b"{\"a\" 1}";
    expect_bad(&nocolon);
    [u8] barekey = b"{a: 1}";
    expect_bad(&barekey);
    [u8] trailcomma = b"[1, 2,]";
    expect_bad(&trailcomma);
    [u8] arrunclosed = b"[1, 2";
    expect_bad(&arrunclosed);
    [u8] badlit = b"tru";
    expect_bad(&badlit);
    [u8] two = b"1 2";
    expect_bad(&two);
}
