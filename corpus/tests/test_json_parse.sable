// Dynamic checks over the JSON parser. The recursive grammar predicate
// (jgram) and its dependents are kernel-verified in the verifies file
// and unmonitorable here (unbounded ∃ under recursion); this copy keeps
// the monitorable phase contracts and asserts behavior through wrappers
// whose posts the monitor checks per call.

/// def isWs (c : int) : Prop := c = 32 ∨ c = 9 ∨ c = 10 ∨ c = 13

/// def digitc (c : int) : Prop := 48 ≤ c ∧ c ≤ 57

/// def hexd (c : int) : Prop := (48 ≤ c ∧ c ≤ 57) ∨ (65 ≤ c ∧ c ≤ 70) ∨ (97 ≤ c ∧ c ≤ 102)

/// def escc (c : int) : Prop := c = 34 ∨ c = 92 ∨ c = 47 ∨ c = 98 ∨ c = 102 ∨ c = 110 ∨ c = 114 ∨ c = 116

/// def strTail (b : Sable.Seq Int) (i j : int) : Prop :=
///   if j ≤ i then False
///   else if b.get i = 34 then j = i + 1
///   else if b.get i = 92 then
///     (b.get (i + 1) = 117 ∧ hexd (b.get (i + 2)) ∧ hexd (b.get (i + 3)) ∧
/// termination_by (j - i).toNat
/// decreasing_by
///   all_goals omega

/// def jstring (b : Sable.Seq Int) (i j : int) : Prop := b.get i = 34 ∧ strTail b (i + 1) j

/// def digits (b : Sable.Seq Int) (i j : int) : Prop := i < j ∧ ∀ k, i ≤ k → k < j → digitc (b.get k)

/// def jint (b : Sable.Seq Int) (i j : int) : Prop := (b.get i = 48 ∧ j = i + 1) ∨ (49 ≤ b.get i ∧ b.get i ≤ 57 ∧ digits b i j)

/// def jfrac (b : Sable.Seq Int) (i j : int) : Prop := i = j ∨ (b.get i = 46 ∧ digits b (i + 1) j)

/// def jexp (b : Sable.Seq Int) (i j : int) : Prop := i = j ∨ ((b.get i = 101 ∨ b.get i = 69) ∧ (digits b (i + 1) j ∨ ((b.get (i + 1) = 43 ∨ b.get (i + 1) = 45) ∧ digits b (i + 2) j)))

/// def jnumber (b : Sable.Seq Int) (i j : int) : Prop := ∃ p q, ((b.get i = 45 ∧ jint b (i + 1) p) ∨ (b.get i ≠ 45 ∧ jint b i p)) ∧ jfrac b p q ∧ jexp b q j ∧ i < p ∧ p ≤ q ∧ q ≤ j

/// def wsTo (b : Sable.Seq Int) (i p : int) : Prop := i ≤ p ∧ ∀ k, i ≤ k → k < p → isWs (b.get k)

/// def jtrue (b : Sable.Seq Int) (i j : int) : Prop := b.get i = 116 ∧ b.get (i + 1) = 114 ∧ b.get (i + 2) = 117 ∧ b.get (i + 3) = 101 ∧ j = i + 4

/// def jfalse (b : Sable.Seq Int) (i j : int) : Prop := b.get i = 102 ∧ b.get (i + 1) = 97 ∧ b.get (i + 2) = 108 ∧ b.get (i + 3) = 115 ∧ b.get (i + 4) = 101 ∧ j = i + 5

/// def jnull (b : Sable.Seq Int) (i j : int) : Prop := b.get i = 110 ∧ b.get (i + 1) = 117 ∧ b.get (i + 2) = 108 ∧ b.get (i + 3) = 108 ∧ j = i + 4

/// def jgram (b : Sable.Seq Int) (m i j : int) : Prop :=
///   if j ≤ i then False
///   else if m = 0 then
///     ∃ p, wsTo b i p ∧
///         jnull b p j ∨
///   else if m = 1 then
///     (∃ q, wsTo b i q ∧ b.get q = 125 ∧ j = q + 1) ∨
///   else if m = 4 then
///     (∃ q, wsTo b i q ∧ b.get q = 125 ∧ j = q + 1) ∨
///     (∃ q q2 r s e, wsTo b i q ∧ b.get q = 44 ∧ wsTo b (q + 1) q2 ∧
///   else if m = 2 then
///     (∃ q, wsTo b i q ∧ b.get q = 93 ∧ j = q + 1) ∨
///   else if m = 6 then
///     (∃ q, wsTo b i q ∧ b.get q = 93 ∧ j = q + 1) ∨
///     (∃ q e, wsTo b i q ∧ b.get q = 44 ∧
///   else False
/// termination_by (j - i).toNat
/// decreasing_by
///   all_goals first | omega | (split <;> first | omega | (split <;> omega))

// ------------------------------------------------------- phase helpers

/// pre  i ≤ b.len
/// pre  b.len ≤ 4611686018427387904
/// post i ≤ result ∧ result ≤ b.len
/// post ∀ k, i ≤ k → k < result → digitc (b.get k)
/// post result < b.len → ¬digitc (b.get result)
/// post i < b.len → digitc (b.get i) → i < result
fn digit_run(&[u8] b, u64 i) -> u64 {
    u64 j = i;
    u64 n = b.len;
    /// invariant i ≤ j ∧ j ≤ n
    /// invariant ∀ k, i ≤ k → k < j → digitc (b.get k)
    /// variant   n - j
    while (j < n) {
        u8 c = b[j];
        if (c < 48 || c > 57) {
            return j;
        }
        j = j + 1;
    }
    return j;
}

/// post result ↔ hexd c
fn hexd_ok(u8 c) -> bool {
    if (c >= 48 && c <= 57) {
        return true;
    }
    if (c >= 65 && c <= 70) {
        return true;
    }
    if (c >= 97 && c <= 102) {
        return true;
    }
    return false;
}

// `jint_scan` consumes `-? (0 | [1-9][0-9]*)` starting at `pos`;
// `jfrac_scan`/`jexp_scan` consume an OPTIONAL fraction/exponent
// (returning their start unchanged when absent). All return 0 on a
// malformed phase.

/// pre  pos < b.len
/// pre  b.len ≤ 4611686018427387904
/// post result ≠ 0 → pos < result ∧ result ≤ b.len ∧ ((b.get pos = 45 ∧ jint b (pos + 1) result) ∨ (b.get pos ≠ 45 ∧ jint b pos result))
fn jint_scan(&[u8] b, u64 pos) -> u64 {
    u64 n = b.len;
    u64 i = pos;
    if (b[i] == 45) {
        i = i + 1;
        if (i >= n) {
            return 0;
        }
    }
    u8 c0 = b[i];
    if (c0 == 48) {
        return i + 1;
    }
    if (c0 < 49 || c0 > 57) {
        return 0;
    }
    u64 e = digit_run(&b, i);
    return e;
}

/// pre  i ≤ b.len
/// pre  b.len ≤ 4611686018427387904
/// post result ≠ 0 → i ≤ result ∧ result ≤ b.len ∧ jfrac b i result
fn jfrac_scan(&[u8] b, u64 i) -> u64 {
    u64 n = b.len;
    if (i >= n) {
        return i;
    }
    if (b[i] != 46) {
        return i;
    }
    u64 d = i + 1;
    if (d >= n) {
        return 0;
    }
    if (b[d] < 48 || b[d] > 57) {
        return 0;
    }
    u64 e = digit_run(&b, d);
    return e;
}

/// pre  i ≤ b.len
/// pre  b.len ≤ 4611686018427387904
/// post result ≠ 0 → i ≤ result ∧ result ≤ b.len ∧ jexp b i result
fn jexp_scan(&[u8] b, u64 i) -> u64 {
    u64 n = b.len;
    if (i >= n) {
        return i;
    }
    if (b[i] != 101 && b[i] != 69) {
        return i;
    }
    u64 d = i + 1;
    if (d >= n) {
        return 0;
    }
    if (b[d] == 43 || b[d] == 45) {
        u64 d2 = d + 1;
        if (d2 >= n) {
            return 0;
        }
        if (b[d2] < 48 || b[d2] > 57) {
            return 0;
        }
        u64 e2 = digit_run(&b, d2);
        return e2;
    }
    if (b[d] < 48 || b[d] > 57) {
        return 0;
    }
    u64 e = digit_run(&b, d);
    return e;
}

// --------------------------------------------------------- the lexemes

/// pre  pos < b.len
/// pre  b.len ≤ 4611686018427387904
fn json_number_end(&[u8] b, u64 pos) -> u64 {
    u64 a1 = jint_scan(&b, pos);
    if (a1 == 0) {
        return 0;
    }
    u64 a2 = jfrac_scan(&b, a1);
    if (a2 == 0) {
        return 0;
    }
    u64 a3 = jexp_scan(&b, a2);
    if (a3 == 0) {
        return 0;
    }
    return a3;
}

/// pre  pos < b.len
/// pre  b.len ≤ 4611686018427387904
/// pre  b.get pos = 34
fn json_string_end(&[u8] b, u64 pos) -> u64 {
    u64 n = b.len;
    u64 i = pos + 1;
    /// invariant pos < i ∧ i ≤ n
    /// variant   n - i
    while (i < n) {
        u8 c = b[i];
        if (c == 34) {
            return i + 1;
        }
        if (c == 92) {
            if (i + 1 >= n) {
                return 0;
            }
            u8 e = b[i + 1];
            if (e == 117) {
                if (i + 5 >= n) {
                    return 0;
                }
                bool h2 = hexd_ok(b[i + 2]);
                bool h3 = hexd_ok(b[i + 3]);
                bool h4 = hexd_ok(b[i + 4]);
                bool h5 = hexd_ok(b[i + 5]);
                if (!h2 || !h3 || !h4 || !h5) {
                    return 0;
                }
                i = i + 6;
            } else {
                if (e != 34 && e != 92 && e != 47 && e != 98 && e != 102 && e != 110 && e != 114 && e != 116) {
                    return 0;
                }
                i = i + 2;
            }
        } else {
            if (c < 32) {
                return 0;
            }
            i = i + 1;
        }
    }
    return 0;
}

/// pre  i ≤ b.len
/// pre  b.len ≤ 4611686018427387904
/// post i ≤ result ∧ result ≤ b.len
/// post wsTo b i result
/// post result < b.len → ¬isWs (b.get result)
fn ws_run(&[u8] b, u64 i) -> u64 {
    u64 j = i;
    u64 n = b.len;
    /// invariant i ≤ j ∧ j ≤ n
    /// invariant ∀ k, i ≤ k → k < j → isWs (b.get k)
    /// variant   n - j
    while (j < n) {
        u8 c = b[j];
        if (c != 32 && c != 9 && c != 10 && c != 13) {
            return j;
        }
        j = j + 1;
    }
    return j;
}

// One self-recursive function; objects and arrays are interior loops.
// Every success return is a `jgram` construction through the step
// lemmas; every 0 return is a rejection (no completeness claim in
// layer 1).

/// pre  pos ≤ b.len
/// pre  b.len ≤ 4611686018427387904
fn json_value_end(&[u8] b, u64 pos) -> u64
/// variant b.len - pos
{
    u64 n = b.len;
    u64 p = ws_run(&b, pos);
    if (p >= n) {
        return 0;
    }
    u8 c = b[p];
    if (c == 34) {
        u64 es = json_string_end(&b, p);
        return es;
    }
    if (c == 45 || (c >= 48 && c <= 57)) {
        u64 en = json_number_end(&b, p);
        return en;
    }
    if (c == 116) {
        if (p + 3 >= n) {
            return 0;
        }
        if (b[p + 1] == 114 && b[p + 2] == 117 && b[p + 3] == 101) {
            return p + 4;
        }
        return 0;
    }
    if (c == 102) {
        if (p + 4 >= n) {
            return 0;
        }
        if (b[p + 1] == 97 && b[p + 2] == 108 && b[p + 3] == 115 && b[p + 4] == 101) {
            return p + 5;
        }
        return 0;
    }
    if (c == 110) {
        if (p + 3 >= n) {
            return 0;
        }
        if (b[p + 1] == 117 && b[p + 2] == 108 && b[p + 3] == 108) {
            return p + 4;
        }
        return 0;
    }
    if (c == 123) {
        u64 q = ws_run(&b, p + 1);
        if (q >= n) {
            return 0;
        }
        if (b[q] == 125) {
            return q + 1;
        }
        if (b[q] != 34) {
            return 0;
        }
        u64 r = json_string_end(&b, q);
        if (r == 0) {
            return 0;
        }
        u64 s = ws_run(&b, r);
        if (s >= n) {
            return 0;
        }
        if (b[s] != 58) {
            return 0;
        }
        u64 e = json_value_end(&b, s + 1);
        if (e == 0) {
            return 0;
        }
        u64 cur = e;
        /// invariant pos < cur ∧ cur ≤ n
        /// variant   n - cur
        while (cur < n) {
            u64 t = ws_run(&b, cur);
            if (t >= n) {
                return 0;
            }
            if (b[t] == 125) {
                return t + 1;
            }
            if (b[t] != 44) {
                return 0;
            }
            u64 q2 = ws_run(&b, t + 1);
            if (q2 >= n) {
                return 0;
            }
            if (b[q2] != 34) {
                return 0;
            }
            u64 r2 = json_string_end(&b, q2);
            if (r2 == 0) {
                return 0;
            }
            u64 s2 = ws_run(&b, r2);
            if (s2 >= n) {
                return 0;
            }
            if (b[s2] != 58) {
                return 0;
            }
            u64 e2v = json_value_end(&b, s2 + 1);
            if (e2v == 0) {
                return 0;
            }
            cur = e2v;
        }
        return 0;
    }
    if (c == 91) {
        u64 qa = ws_run(&b, p + 1);
        if (qa >= n) {
            return 0;
        }
        if (b[qa] == 93) {
            return qa + 1;
        }
        u64 ea = json_value_end(&b, p + 1);
        if (ea == 0) {
            return 0;
        }
        u64 cura = ea;
        /// invariant pos < cura ∧ cura ≤ n
        /// variant   n - cura
        while (cura < n) {
            u64 ta = ws_run(&b, cura);
            if (ta >= n) {
                return 0;
            }
            if (b[ta] == 93) {
                return ta + 1;
            }
            if (b[ta] != 44) {
                return 0;
            }
            u64 e2va = json_value_end(&b, ta + 1);
            if (e2va == 0) {
                return 0;
            }
            cura = e2va;
        }
        return 0;
    }
    return 0;
}

// The capstone: `true` is a kernel-checked proof that the buffer is one
// JSON value surrounded by optional whitespace.

/// pre  b.len ≤ 4611686018427387904
fn json_valid(&[u8] b) -> bool {
    u64 e = json_value_end(&b, 0);
    if (e == 0) {
        return false;
    }
    u64 p = ws_run(&b, e);
    if (p >= b.len) {
        return true;
    }
    return false;
}

// ---------------- discharges carried from the M10 lexer ----------------

// ---------------------- the parser's own discharges ----------------------



/// pre  b.len ≤ 4611686018427387904
/// post result
fn expect_json(&[u8] b) -> bool {
    return json_valid(&b);
}

/// pre  b.len ≤ 4611686018427387904
/// post ¬result
fn expect_bad(&[u8] b) -> bool {
    return json_valid(&b);
}

fn test_valid_documents() {
    [u8] scalar = [52, 50];
    expect_json(&scalar);
    [u8] str1 = [34, 104, 101, 108, 108, 111, 34];
    expect_json(&str1);
    [u8] lit = [32, 32, 116, 114, 117, 101, 32, 32];
    expect_json(&lit);
    [u8] obj = [123, 34, 97, 34, 58, 32, 49, 44, 32, 34, 98, 34, 58, 32, 91, 116, 114, 117, 101, 44, 32, 110, 117, 108, 108, 44, 32, 45, 50, 46, 53, 101, 51, 93, 44, 32, 34, 99, 34, 58, 32, 123, 34, 100, 34, 58, 32, 34, 120, 34, 125, 125];
    expect_json(&obj);
    [u8] arr = [32, 91, 32, 49, 32, 44, 32, 91, 32, 50, 32, 44, 32, 91, 32, 51, 32, 93, 32, 93, 32, 44, 32, 123, 125, 32, 44, 32, 91, 93, 32, 93, 32];
    expect_json(&arr);
    [u8] deep = [123, 34, 107, 34, 32, 58, 32, 123, 32, 34, 108, 34, 32, 58, 32, 123, 32, 34, 109, 34, 32, 58, 32, 91, 32, 34, 100, 101, 101, 112, 34, 32, 44, 32, 48, 32, 93, 32, 125, 32, 125, 32, 125];
    expect_json(&deep);
}

fn test_invalid_documents() {
    [u8] empty = [];
    expect_bad(&empty);
    [u8] trail = [52, 50, 32, 120];
    expect_bad(&trail);
    [u8] unclosed = [123, 34, 97, 34, 58, 32, 49];
    expect_bad(&unclosed);
    [u8] noval = [123, 34, 97, 34, 58, 32, 125];
    expect_bad(&noval);
    [u8] nocolon = [123, 34, 97, 34, 32, 49, 125];
    expect_bad(&nocolon);
    [u8] barekey = [123, 97, 58, 32, 49, 125];
    expect_bad(&barekey);
    [u8] trailcomma = [91, 49, 44, 32, 50, 44, 93];
    expect_bad(&trailcomma);
    [u8] arrunclosed = [91, 49, 44, 32, 50];
    expect_bad(&arrunclosed);
    [u8] badlit = [116, 114, 117];
    expect_bad(&badlit);
    [u8] two = [49, 32, 50];
    expect_bad(&two);
}
