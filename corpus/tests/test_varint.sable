// Dynamic checking of the varint codec (design §9): every contract in
// varint.sable — the count-bound posts, the byte-range posts, the
// unrolled power-chain invariant, and the decode guards — is
// monitorable, so `sable test` checks them all on every call.

/// pre  out.len >= 10
/// post 1 <= result ∧ result <= 10
/// post ∀ k, 0 <= k → k < result - 1 → 128 <= out.get k ∧ out.get k < 256
/// post 0 <= out.get (result - 1) ∧ out.get (result - 1) < 128
/// post x < 128 → result = 1 ∧ out.get 0 = x
/// post 128 <= x → 2 <= result
fn varint_encode(&mut [u64] out, u64 x) -> u64 {
    u64 v = x;
    u64 i = 0;
    u64 more = 1;
    /// invariant more = 0 ∨ more = 1
    /// invariant i <= 10
    /// invariant more = 1 → ((i = 0 ∧ v = x) ∨ (i = 1 ∧ v <= 144115188075855871) ∨ (i = 2 ∧ v <= 1125899906842623) ∨ (i = 3 ∧ v <= 8796093022207) ∨ (i = 4 ∧ v <= 68719476735) ∨ (i = 5 ∧ v <= 536870911) ∨ (i = 6 ∧ v <= 4194303) ∨ (i = 7 ∧ v <= 32767) ∨ (i = 8 ∧ v <= 255) ∨ (i = 9 ∧ v <= 1))
    /// invariant more = 1 → ∀ k, 0 <= k → k < i → 128 <= out.get k ∧ out.get k < 256
    /// invariant more = 1 → 1 <= i → 128 <= x
    /// invariant more = 0 → 1 <= i ∧ (∀ k, 0 <= k → k < i - 1 → 128 <= out.get k ∧ out.get k < 256) ∧ 0 <= out.get (i - 1) ∧ out.get (i - 1) < 128
    /// invariant more = 0 → x < 128 → i = 1 ∧ out.get 0 = x
    /// invariant more = 0 → 128 <= x → 2 <= i
    /// variant   v + more
    while (more == 1) {
        if (v >= 128) {
            out[i] = v % 128 + 128;
            v = v / 128;
            i = i + 1;
        } else {
            out[i] = v;
            i = i + 1;
            more = 0;
        }
    }
    return i;
}

/// pre  n <= src.len
/// post n = 0 → result = none
/// post match result with
///      | some v => ∀ j, 0 <= j → j < n → src.get j < 256
///      | none   => True
/// post n = 1 → 0 <= src.get 0 → src.get 0 < 128 → result = some (src.get 0)
fn varint_decode(&[u64] src, u64 n) -> option<u64> {
    if (n == 0) { return none; }
    u64 value = 0;
    u64 k = n;
    /// invariant k <= n
    /// invariant ∀ j, k <= j → j < n → src.get j < 256
    /// invariant n = 1 → src.get 0 < 128 → ((k = 1 ∧ value = 0) ∨ (k = 0 ∧ value = src.get 0))
    /// variant   k
    while (k > 0) {
        k = k - 1;
        u64 b = src[k];
        if (b >= 256) { return none; }
        u64 d = b % 128;
        if (value > (18446744073709551615 - d) / 128) { return none; }
        value = value * 128 + d;
    }
    return some(value);
}

fn test_encode_small_values() {
    [u64] out = alloc_array<u64>(10, 0);
    u64 n0 = varint_encode(&mut out, 0);
    varint_decode(&out, n0);
    u64 n1 = varint_encode(&mut out, 127);
    varint_decode(&out, n1);
}

fn test_encode_boundaries() {
    [u64] buf = alloc_array<u64>(10, 0);
    u64 a = varint_encode(&mut buf, 128);
    varint_decode(&buf, a);
    u64 b = varint_encode(&mut buf, 16383);
    varint_decode(&buf, b);
    u64 c = varint_encode(&mut buf, 16384);
    varint_decode(&buf, c);
    u64 d = varint_encode(&mut buf, 18446744073709551615);
    varint_decode(&buf, d);
}

fn test_decode_edges() {
    [u64] src = alloc_array<u64>(3, 0);
    varint_decode(&src, 0);
    src[0] = 5;
    varint_decode(&src, 1);
    src[1] = 300;
    varint_decode(&src, 2);
}
