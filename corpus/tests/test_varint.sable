// Dynamic checking of the varint codec (design §9): every contract in
// varint.sable — the count-bound posts, the byte-range posts, the
// unrolled power-chain invariant, and the decode guards — is
// monitorable, so `sable test` checks them all on every call.

use varint;

fn test_encode_small_values() {
    [u64] out = alloc_array<u64>(10, 0);
    u64 n0 = varint_encode(&mut out, 0);
    varint_decode(&out, n0);
    u64 n1 = varint_encode(&mut out, 127);
    varint_decode(&out, n1);
}

fn test_encode_boundaries() {
    [u64] buf = alloc_array<u64>(10, 0);
    u64 a = varint_encode(&mut buf, 128);
    varint_decode(&buf, a);
    u64 b = varint_encode(&mut buf, 16383);
    varint_decode(&buf, b);
    u64 c = varint_encode(&mut buf, 16384);
    varint_decode(&buf, c);
    u64 d = varint_encode(&mut buf, 18446744073709551615);
    varint_decode(&buf, d);
}

fn test_decode_edges() {
    [u64] src = alloc_array<u64>(3, 0);
    varint_decode(&src, 0);
    src[0] = 5;
    varint_decode(&src, 1);
    src[1] = 300;
    varint_decode(&src, 2);
}
