// Dynamic checks over the UTF-8 codec: every clause — the ghost byte
// maps (ite + constant div/mod), the match posts, the roundtrip — is
// monitored at runtime, except the kernel-checked ∃-completeness and
// validFrom-suffix clauses (fenced below: monitoring them would
// enumerate every scalar value or every suffix); the reject wrappers
// carry `result = none` posts checked dynamically instead. Byte
// classes per RFC 3629.
// expect-skip: ∃ cp2, scalar cp2
// expect-skip: ∃ cp, scalar cp ∧ pos + utf8_len cp ≤ b.len ∧ utf8_len cp = result
// expect-skip: result → validFrom b 0
// expect-skip: validFrom b pos → validFrom b 0

use utf8;

/// pre  b.len ≤ MAX_BYTES
/// post result
fn expect_valid(&[u8] b) -> bool {
    return validate_utf8(&b);
}

/// pre  b.len ≤ MAX_BYTES
/// post ¬result
fn expect_invalid(&[u8] b) -> bool {
    return validate_utf8(&b);
}

fn test_validate() {
    [u8] empty = [];
    expect_valid(&empty);
    [u8] ascii = b"Hi!";
    expect_valid(&ascii);
    [u8] mixed = b"Aé€😀";
    expect_valid(&mixed);
    [u8] trunc_tail = b"AB\xe2\x82";
    expect_invalid(&trunc_tail);
    [u8] embedded_overlong = b"A\xc0\x80B";
    expect_invalid(&embedded_overlong);
    [u8] embedded_surrogate = b"\xed\xa0\x80A";
    expect_invalid(&embedded_surrogate);
    [u8] bare_continuation = b"A\x80B";
    expect_invalid(&bare_continuation);
}

// Contract-carrying wrappers: their posts are false in general and
// true for the specific inputs the tests feed them — the monitor checks
// each call. (Array literals live in test functions; wrappers borrow.)

/// pre  b.len ≥ 1
/// pre  b.len ≤ MAX_BYTES
/// post result = none
fn expect_reject(&[u8] b) -> option<u32> {
    return decode_utf8(&b, 0);
}

/// pre  b.len ≥ 1
/// pre  b.len ≤ MAX_BYTES
/// post result = some want
fn expect_cp(&[u8] b, u32 want) -> option<u32> {
    return decode_utf8(&b, 0);
}

fn test_roundtrips() {
    roundtrip(0);
    roundtrip(65);
    roundtrip(127);
    roundtrip(128);
    roundtrip(233);
    roundtrip(2047);
    roundtrip(2048);
    roundtrip(8364);
    roundtrip(55295);
    roundtrip(57344);
    roundtrip(65535);
    roundtrip(65536);
    roundtrip(128512);
    roundtrip(1114111);
}

fn test_rejects() {
    [u8] overlong2 = b"\xc0\x80";
    expect_reject(&overlong2);
    [u8] overlong3 = b"\xe0\x80\x80";
    expect_reject(&overlong3);
    [u8] surrogate = b"\xed\xa0\x80";
    expect_reject(&surrogate);
    [u8] truncated = b"\xe2\x82";
    expect_reject(&truncated);
    [u8] badcont = b"\xc3(";
    expect_reject(&badcont);
    [u8] toobig = b"\xf4\x90\x80\x80";
    expect_reject(&toobig);
    [u8] badlead = b"\xf8\x80\x80\x80";
    expect_reject(&badlead);
}

fn test_decode_valid() {
    [u8] euro = b"€";
    expect_cp(&euro, 8364);
    [u8] ascii = b"A";
    expect_cp(&ascii, 65);
    [u8] emoji = b"😀";
    expect_cp(&emoji, 128512);
}
