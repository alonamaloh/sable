// Dynamic checking of the sorting/searching contracts (design §9):
// `sable test` executes test_* functions with every monitorable
// contract checked — pres, posts (incl. the match post and the
// permutation claim), loop invariants, and variants — plus the trap
// checks (overflow, bounds, division) the verifier would emit VCs for.

/// post sorted a
/// post perm a (old a)
fn insertion_sort(&mut [i32] a) {
    u64 n = a.len;
    /// invariant ∀ p q, 0 ≤ p → p < q → q < i → a.get p ≤ a.get q
    /// invariant perm a (old a)
    for (u64 i : range(n)) {
        u64 j = i;
        /// invariant j ≤ i
        /// invariant ∀ p q, 0 ≤ p → p < q → q ≤ i → q ≠ j → a.get p ≤ a.get q
        /// invariant perm a (old a)
        /// variant   j
        while (j > 0 && a[j - 1] > a[j]) {
            i32 t = a[j - 1];
            a[j - 1] = a[j];
            a[j] = t;
            j = j - 1;
        }
    }
}

/// pre  sorted a
/// post match result with
///      | some i => 0 ≤ i ∧ i < a.len ∧ a.get i = key
///      | none   => ∀ k, 0 ≤ k → k < a.len → a.get k ≠ key
fn binary_search(&[i32] a, i32 key) -> option<u64> {
    u64 lo = 0;
    u64 hi = a.len;
    /// invariant hi ≤ a.len
    /// invariant ∀ k, 0 ≤ k → k < lo → a.get k < key
    /// invariant ∀ k, hi ≤ k → k < a.len → key < a.get k
    /// variant   hi - lo
    while (lo < hi) {
        u64 m = lo + (hi - lo) / 2;
        if (a[m] < key) {
            lo = m + 1;
        } else if (a[m] > key) {
            hi = m;
        } else {
            return some(m);
        }
    }
    return none;
}

fn test_sort_then_search() {
    [i32] a = [5, 3, 8, 1, 9, 2, 7];
    insertion_sort(&mut a);
    binary_search(&a, 8);
    binary_search(&a, 4);
}

fn test_sort_empty_and_single() {
    [i32] e = [];
    insertion_sort(&mut e);
    [i32] s = [42];
    insertion_sort(&mut s);
}

fn test_sort_already_sorted() {
    [i32] a = [1, 2, 3, 4];
    insertion_sort(&mut a);
    binary_search(&a, 1);
    binary_search(&a, 4);
}
