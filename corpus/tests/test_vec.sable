// Dynamic checks over the generic Vec: growth reallocation, the
// copy-loop frame, get/set, pop-to-empty, and a second instantiation.

use vec;

fn test_push_get_growth() {
    var v = Vec<i32>::with_capacity(2);
    v.push(10);
    v.push(20);
    v.push(30);
    v.push(40);
    v.push(50);
    v.get(0);
    v.get(4);
    v.size();
}

fn test_set_and_pop() {
    var v = Vec<i32>::with_capacity(1);
    v.push(7);
    v.push(8);
    v.set(0, 99);
    v.pop();
    v.pop();
    v.pop();
}

fn test_u8_instance() {
    var v = Vec<u8>::with_capacity(4);
    v.push(255);
    v.pop();
    v.pop();
}
