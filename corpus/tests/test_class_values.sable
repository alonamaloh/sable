// Dynamic checks over first-class class values (ADR 0010): borrowed
// arguments, field reads, class returns — contracts over `a.lo`/
// `result.hi` monitored per call; invariants checked at RAII drop as
// always.

use class_values;
use class_fields;

fn test_class_values() {
    var x = Range::make(1, 5);
    var y = Range::make(3, 10);
    var u = union_of(&x, &y);
    width(&x);
    width(&u);
    demo();
    var z = union_of(&x, &x);
    width(&z);
}

// Mutable class borrows (ADR 0023): the caller's value changes, and
// `old c` in the callee's post is monitored against the entry state.
fn test_class_mut_borrow() {
    var mut c = Counter::zero();
    bump_twice(&mut c);
    peek(&c);
    bump_then_read(&mut c);
    mutate_local();
    bump_in_loop();
    var mut d = Counter::zero();
    count_to_five(&mut d);
    peek(&d);
    drive_once();
}

// Class-valued fields, moves, and field borrows (ADR 0020).
fn test_class_fields() {
    var i = Inner::make(7);
    var o = Outer::wrap(i, 3);
    read_inner(&o.inner);
    o.inner_value();
    nest_and_read();
    nested_method();
    borrowed_array_field();
    move_on_returning_branch(0);
    move_on_returning_branch(1);
    move_between_locals();
    move_and_revive();
}
