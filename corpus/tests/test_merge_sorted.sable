// Dynamic checking of the merge kernel's contracts: sortedness of both
// inputs (pre), the size arithmetic (pre), sortedness of the output and
// the count-based multiset claim (posts), plus every loop invariant and
// variant along the way.
//
// The proof-only countUpto prefix invariants and the unbounded-∀
// multiset post are outside the monitorable fragment and fenced below;
// everything else is checked with zero skips.
// expect-skip: out.countUpto v (Int.toNat k)
// expect-skip: ∀ v, count out v = count xs v + count ys v

use merge_sorted;

fn test_merge_interleaved() {
    [i32] xs = [1, 3, 5, 7];
    [i32] ys = [2, 3, 6];
    [i32] out = alloc_array<i32>(7, 0);
    merge(&xs, &ys, &mut out);
}

fn test_merge_empty_sides() {
    [i32] e1 = [];
    [i32] ys = [4, 5];
    [i32] out1 = alloc_array<i32>(2, 0);
    merge(&e1, &ys, &mut out1);
    [i32] e2 = [];
    [i32] out2 = alloc_array<i32>(2, 0);
    merge(&ys, &e2, &mut out2);
    [i32] e3 = [];
    [i32] e4 = [];
    [i32] out3 = alloc_array<i32>(0, 0);
    merge(&e3, &e4, &mut out3);
}

fn test_merge_drain_and_duplicates() {
    [i32] xs = [10, 20, 30];
    [i32] ys = [1, 2, 3];
    [i32] out = alloc_array<i32>(6, 0);
    merge(&xs, &ys, &mut out);
    [i32] ds = [2, 2, 4];
    [i32] dt = [2, 4, 4];
    [i32] dout = alloc_array<i32>(6, 0);
    merge(&ds, &dt, &mut dout);
}
