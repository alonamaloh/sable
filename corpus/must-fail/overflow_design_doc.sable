// expect-error: div_round_up.overflow.a_b
// The design doc's §3 example, verbatim. Its precondition admits
// a + b = 2^32 (e.g. a = 1, b = u32.max), so the intermediate `a + b`
// overflows u32 even though a + b - 1 fits. Found by this compiler on
// 2026-08-08; the corrected version lives in corpus/verifies/.

/// pre  b > 0
/// pre  a + b - 1 <= u32.max
/// post result = (a + b - 1) / b
fn div_round_up(u32 a, u32 b) -> u32 {
    return (a + b - 1) / b;
}
