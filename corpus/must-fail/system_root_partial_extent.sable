// expect-error: partial.system_dealloc
// Release requires authority over the complete raw allocation, not one carved
// prefix. The unused tail being affine does not weaken the release token.

fn partial() {
    unsafe system_alloc(8) as (p, resource mem, resource release);
    resource RawSpan tail = split_off(&mut mem, 4);
    unsafe system_dealloc(p, mem, release);
}
