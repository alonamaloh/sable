// expect-error: any_fd.open_file
// The world says which descriptors it handed out, and `open_file` needs
// one of them. Whether a descriptor is really open is a *precondition* —
// the checker tracks tokens, not the state of the outside.


fn any_fd(i32 fd, resource &mut PosixWorld w) {
    resource OpenFile fh = open_file(&mut w, fd);
}