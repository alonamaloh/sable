// expect-error: type.member_param
// Options with a concrete value payload cross the member boundary; an
// option of a raw pointer does not — members have no nullable-pointer
// transport. The gate answers on the outer type, so the refusal names
// the option, not its payload.

record Rec #[layout(size := 8, align := 4)] {
    #[offset(0)] u32 a;
    #[offset(4)] u32 b;
}

pub class C {
    u64 v;

    init make(option<raw<Rec>> p) {
        self.v = 0;
    }
}
