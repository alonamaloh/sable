// expect-error: resource.branch_shape
// A `#[must_consume]` resource field is part of the branch's resource
// shape. Consuming it on one path and not the other leaves different
// authority live, so the mismatch is rejected at the branch itself.

fn eat(resource RawSpan s) {
}

class Guard {
    u64 n;
    #[must_consume] resource RawSpan span;

    /// pre  s.len ≥ 0
    init hold(u64 k, resource RawSpan s) {
        self.n = k;
        self.span = s;
    }

    deinit {
        if (self.n > 0) {
            eat(self.span);
        }
    }
}
