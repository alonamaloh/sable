// expect-error: mut.option_take_immutable
// An owning class option is declared `mut` or it is useless: `.take`
// leaves `none` behind, so the family requires mutability at the
// declaration, for a class payload exactly as for an array.

pub class Box {
    u64 v;

    /// post self.v = 0
    init make() {
        self.v = 0;
    }
}

fn immovable() -> u64 {
    option<Box> maybe = none;
    return 0;
}
