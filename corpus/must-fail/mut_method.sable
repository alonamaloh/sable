// expect-error: mut.method_immutable
// A `&mut` method mutates its receiver; the local must be `mut`.

class Counter {
    u64 n;

    /// post self.n = 0
    init zero() {
        self.n = 0;
    }

    /// pre  self.n < 1000
    /// post self.n = old self.n + 1
    fn bump(&mut self) {
        self.n = self.n + 1;
    }
}

fn test_f() {
    var c = Counter::zero();
    c.bump();
}
