// expect-error: resource.field_borrow_op
// `&mut self.<field>` is legal in a destructor (ADR 0029) as a *call*
// argument, where the fresh post-call state is written back into the
// object. A sealed operation keys its write-back by the borrow's root
// name instead, so a field borrow reaching one would overwrite the whole
// object with a view: the shape is refused by name (ADR 0074). Move the
// field into a local resource binding first — a destructor may move
// fields out.

pub class Arena {
    resource RawSpan mem;

    init grab(resource RawSpan m) {
        self.mem = m;
    }

    deinit {
        unsafe {
            resource RawSpan tail = split_off(&mut self.mem, 0);
        }
    }
}
