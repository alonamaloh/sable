// expect-error: resource.use_after_move
// The exposure resource is affine like any other: `join` consumes both
// halves, so naming one again afterwards is a use after move.

/// pre  a.len ≥ 2
fn consumed(&mut [u8] a) {
    unsafe expose &mut a as (p, resource m) {
        resource RawSpan tail = split_off(&mut m, 1);
        resource RawSpan whole = join(m, tail);
        resource RawSpan again = join(whole, tail);
        m = again;
    }
}
