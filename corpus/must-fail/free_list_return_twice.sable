// expect-error: resource.use_after_move
// The first public return consumes the mandatory lease authority. A second
// return of the same local is rejected by affinity at that exact use site.

use free_list_return;
use free_list_remove_head;

/// pre base.alloc = state.root.alloc ∧ base.off = 0
/// pre list.limit = state.root.len
/// pre Sable.AllocatorView.returnableIn
///       state list.limit list.head lease
/// pre lease.key = key
/// pre lease.span.len = size
/// pre Sable.freeHeaderBytes ≤ size ∧ key % u64.layout.align = 0
pub fn free_list_return_twice(
        raw<u8> base,
        &mut FreeListState list,
        resource &mut AllocatorState state,
        u64 key, u64 size,
        resource BlockLease lease) {
    free_list_return(base, &mut list, &mut state, key, size, lease);
    free_list_return(base, &mut list, &mut state, key, size, lease);
}
