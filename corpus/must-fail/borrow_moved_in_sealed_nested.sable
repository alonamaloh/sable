// expect-error: borrow.moved_in_call
// The sealed operation captures its first argument's resource-map loan before
// the nested second argument moves that same map. A fresh scalar result does
// not hide the checker-authored move from the pending-loan conflict rule.

fn sealed_move_map(
    resource ResourceMap<u64, PointsTo<u64>> cells
) -> u64 {
    return 0;
}

fn sealed_nested_move_bad(resource PointsTo<u64> cell) {
    mut resource ResourceMap<u64, PointsTo<u64>> cells = resource_map_empty();
    resource_map_put(&mut cells, sealed_move_map(cells), cell);
}
