// expect-error: expose.owner_frozen
// Reassigning the exposed array's whole name inside the body would replace
// the storage the loan still points at. The owner's name is frozen for the
// body (ADR 0073); the exposure ends before the name can change.

pub fn owner_reassigned() -> u64 {
    mut [u8] a = alloc_array<u8>(2, 0);
    unsafe expose &mut a as (p, resource m) {
        a = alloc_array<u8>(3, 1);
    }
    return 0;
}
