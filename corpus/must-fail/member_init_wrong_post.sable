// expect-error: Tank::fill.post.stored
// A false init post over an option parameter: the absent arm claims a
// value the body does not store. The dynamic twin is
// `corpus/test-fails/member_init_wrong_post.sable`.

pub class Tank {
    u64 v;

    /// post #[label(stored)] match s with
    ///      | some x => self.v = x
    ///      | none   => self.v = 1
    init fill(option<u64> s) {
        if (s.is_some) {
            self.v = s.value;
        } else {
            self.v = 0;
        }
    }
}
