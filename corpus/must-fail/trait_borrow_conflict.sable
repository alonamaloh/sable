// expect-error: type.trait_param_unsupported
// Retained trait contracts have an integer-only proof domain. Reject the
// borrowed signature itself, before any call-site alias question can arise.

trait SpanOps {
    fn both(resource &mut RawSpan a, resource &RawSpan b) -> u64;
}

fn generic_both<K: SpanOps>(resource &mut RawSpan span) -> u64 {
    return K::both(&mut span, &span);
}
