// expect-error: type.borrow_mutability
// The mutability of a borrow is written, not inferred from the callee's
// signature.

class Counter {
    u64 n;

    /// invariant n ≤ 100

    /// post self.n = 0
    init zero() {
        self.n = 0;
    }

    /// pre  self.n < 100
    /// post self.n = old self.n + 1
    fn bump(&mut self) {
        self.n = self.n + 1;
    }
}

/// pre  c.n < 100
fn poke(&mut Counter c) {
    c.bump();
}

fn caller() {
    var mut c = Counter::zero();
    poke(&c);
}
