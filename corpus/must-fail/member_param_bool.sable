// expect-error: type.member_param
// Init/method parameters admit integers, class values, resources, and
// (inits only) shared array borrows. Every other family is refused by
// this one named gate; these fences pin each family so widening the gate
// is a deliberate act that also supplies the member-call havoc and proof
// transport the wider type needs.

pub class C {
    u64 v;

    init make(bool b) {
        self.v = 0;
    }
}
