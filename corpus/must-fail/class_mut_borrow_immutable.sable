// expect-error: mut.borrow_immutable
// Handing out unique access to a class local is mutation, so the local
// must be `mut` — the same rule `&mut [T]` follows.

class Counter {
    u64 n;

    /// invariant n ≤ 100

    /// post self.n = 0
    init zero() {
        self.n = 0;
    }

    /// pre  self.n < 100
    /// post self.n = old self.n + 1
    fn bump(&mut self) {
        self.n = self.n + 1;
    }
}

/// pre  c.n < 100
fn poke(&mut Counter c) {
    c.bump();
}

fn caller() {
    var c = Counter::zero();
    poke(&mut c);
}
