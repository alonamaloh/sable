// expect-error: resource.use_after_move
/// pre a.len = 8
fn raw_after_conversion(&mut [u8] a) -> u8 {
    mut u8 out = 0;
    unsafe expose &mut a as (p, resource mem) {
        mut resource PointsTo<u64> cell = raw_into_cell_u64(p, mem);
        out = raw_load8(p, &mem);
        raw_cell_drop_u64(p, &mut cell);
        resource RawSpan bytes = raw_from_cell_u64(p, cell);
        mem = bytes;
    }
    return out;
}
