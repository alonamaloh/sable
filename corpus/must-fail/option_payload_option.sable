// expect-error: type.option_payload_unsupported
// Option nesting is the recursive copyable family: the payload of an
// admitted option is a concrete value or such an option itself. An
// abstract payload is neither — `option<option<T>>` has no transport
// for the inner case — so the nesting stays refused inside a template
// even when every instantiation would be concrete.

fn nested<T>(T x) -> u64 {
    option<option<T>> maybe = none;
    return 0;
}

/// post result = 0
pub fn use_nested() -> u64 {
    return nested<u64>(3);
}
