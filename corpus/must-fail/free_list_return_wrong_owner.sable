// expect-error: free_list_return_wrong_owner.call_pre.free_list_return.returnable
// A public return rejects a lease whose allocator identity differs from the
// target aggregate; the failure is at the return call, before any raw access.

use free_list_return;
use free_list_remove_head;

/// pre base.alloc = state.root.alloc ∧ base.off = 0
/// pre list.limit = state.root.len
/// pre Sable.AllocatorView.StoredChain state list.limit list.head
/// pre lease.allocator != state.allocator
/// pre lease.key = key
/// pre lease.span.len = size
/// pre Sable.freeHeaderBytes ≤ size ∧ key % u64.layout.align = 0
pub fn free_list_return_wrong_owner(
        raw<u8> base,
        &mut FreeListState list,
        resource &mut AllocatorState state,
        u64 key, u64 size,
        resource BlockLease lease) {
    free_list_return(base, &mut list, &mut state, key, size, lease);
}
