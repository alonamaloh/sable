// expect-error: type.record_array_field
// A record array is not a class field yet: field element reads, stores,
// and havoc must be enabled together.

record Pt #[layout(size := 8, align := 8)] {
    #[offset(0)] u64 x;
}

pub class Holder {
    [Pt] pts;

    init empty() {
        self.pts = alloc_array<Pt>(1, Pt(0));
    }
}
