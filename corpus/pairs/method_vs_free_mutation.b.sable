// pair: same-run
// See method_vs_free_mutation.a.sable: the same two increments routed
// through a free function that borrows the owner at the call.

pub class Counter {
    u64 n;

    /// invariant n ≤ 100

    /// post self.n = 0
    init zero() {
        self.n = 0;
    }

    /// pre  self.n < 100
    /// post self.n = old self.n + 1
    fn bump(&mut self) {
        self.n = self.n + 1;
    }

    /// post result = self.n
    fn get(&self) -> u64 {
        return self.n;
    }
}

/// pre  c.n < 99
/// post c.n = old c.n + 2
fn bump_twice(&mut Counter c) {
    c.bump();
    c.bump();
}

/// post result = 2
pub fn subject() -> u64 {
    mut var c = Counter::zero();
    bump_twice(&mut c);
    return c.get();
}
