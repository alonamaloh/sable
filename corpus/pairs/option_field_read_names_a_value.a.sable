// pair: same-lean
// A copyable option field is a value: binding the field to a local name
// before the someness-guarded access must change nothing about the
// emitted obligations — the someness VC and the payload's facts travel
// with the projected value, not with the spelling.

pub class Keep {
    option<u64> hit;

    /// post self.hit = some (v)
    init at(u64 v) {
        self.hit = some(v);
    }

    /// pre  self.hit.is_some
    /// post result = self.hit.value
    fn get(&self) -> u64 {
        return self.hit.value;
    }
}
