// Initialization is a state transition rather than an overwrite operation.

record Cell #[layout(size := 8, align := 8)] {
    #[offset(0)] u64 payload;
}

fn subj() -> u64 {
    mut [u8] bytes = alloc_array<u8>(8, 0);
    unsafe expose &mut bytes as (base, resource mem) {
        raw<Cell> p = raw_cast<Cell>(base);
        mut resource PointsTo<Cell> cell = raw_into_cell<Cell>(p, mem);
        Cell first = Cell(1);
        Cell second = Cell(2);
        raw_cell_init<Cell>(p, first, &mut cell);
        raw_cell_init<Cell>(p, second, &mut cell);
        raw_cell_drop<Cell>(p, &mut cell);
        resource RawSpan returned = raw_from_cell<Cell>(p, cell);
        mem = returned;
    }
    return 0;
}
