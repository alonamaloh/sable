// Guarded arithmetic, Euclidean division, and conversion subject.

/// post result = 42
fn arithmetic_entry() -> i32 {
    i8 signed_add = 20 + 22;
    u8 unsigned_sub = 50 - 8;
    i16 signed_mul = 6 * 7;
    u16 unsigned_div = 84 / 2;
    u32 unsigned_rem = 85 % 43;
    i32 euclid_q_pos = -7 / 3;
    i32 euclid_r_pos = -7 % 3;
    i32 euclid_q_neg = 7 / -3;
    i32 euclid_r_neg = 7 % -3;
    i64 negated = -42;
    i64 widened = widen<i64>(signed_mul);
    i32 narrowed = narrow<i32>(widened);

    // Keep every operation live in the verified result while preserving 42.
    return narrowed
        + widen<i32>(signed_add) - widen<i32>(unsigned_sub)
        + widen<i32>(unsigned_div) - narrow<i32>(unsigned_rem)
        + euclid_q_pos + euclid_r_pos - euclid_q_neg - euclid_r_neg
        + narrow<i32>(negated) + 42;
}
