// Native-admission wrapper for the exact verified merge kernel.

use merge_sorted;

fn perf_merge_entry() -> i32 {
    mut u64 iteration = 0;
    /// invariant iteration ≤ 262144
    /// variant 262144 - iteration
    while (iteration < 262144) {
        [i32] left = [1, 3, 5, 7];
        [i32] right = [2, 3, 6];
        mut [i32] output = alloc_array<i32>(7, 0);
        merge(&left, &right, &mut output);
        if (output[0] != 1 || output[1] != 2 || output[2] != 3 || output[3] != 3 || output[4] != 5 || output[5] != 6 || output[6] != 7) {
            return 1;
        }
        iteration = iteration + 1;
    }
    return 42;
}
