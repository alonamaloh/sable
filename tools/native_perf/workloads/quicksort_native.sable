// Native-admission wrapper for the exact verified quicksort workload.

use quicksort;

fn perf_quicksort_entry() -> i32 {
    mut u64 iteration = 0;
    /// invariant iteration ≤ 262144
    /// variant 262144 - iteration
    while (iteration < 262144) {
        mut [i32] values = [5, 3, 8, 1, 9, 2, 7, 3, 0, 6];
        quicksort(&mut values);
        if (values[0] != 0 || values[1] != 1 || values[2] != 2 || values[3] != 3 || values[4] != 3 || values[5] != 5 || values[6] != 6 || values[7] != 7 || values[8] != 8 || values[9] != 9) {
            return 1;
        }
        iteration = iteration + 1;
    }
    return 42;
}
