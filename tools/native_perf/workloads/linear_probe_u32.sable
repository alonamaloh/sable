// Native benchmark slice: fixed-capacity linear probing over local u32 arrays.
// This preserves the canonical hash map's probe/insert/overwrite/get algorithm
// but is not its generic class or full contract, which remain closure-only.

/// pre cap > 0
/// pre cap ≤ 4611686018427387904
/// pre cap = keys.len ∧ cap = values.len ∧ cap = occupied.len
fn perf_map_insert(&mut [u32] keys, &mut [u32] values, &mut [u32] occupied, u64 cap, u32 key, u32 value) -> u32 {
    u64 home = widen<u64>(key) % cap;
    mut u64 distance = 0;
    /// invariant distance ≤ cap
    /// invariant home < cap
    /// invariant cap = keys.len ∧ cap = values.len ∧ cap = occupied.len
    /// variant cap - distance
    while (distance < cap) {
        mut u64 position = home + distance;
        if (position >= cap) {
            position = position - cap;
        }
        if (occupied[position] == 0) {
            keys[position] = key;
            values[position] = value;
            occupied[position] = 1;
            return 2;
        }
        if (keys[position] == key) {
            values[position] = value;
            return 1;
        }
        distance = distance + 1;
    }
    return 0;
}

/// pre cap > 0
/// pre cap ≤ 4611686018427387904
/// pre cap = keys.len ∧ cap = values.len ∧ cap = occupied.len
fn perf_map_get(&[u32] keys, &[u32] values, &[u32] occupied, u64 cap, u32 key) -> u32 {
    u64 home = widen<u64>(key) % cap;
    mut u64 distance = 0;
    /// invariant distance ≤ cap
    /// invariant home < cap
    /// invariant cap = keys.len ∧ cap = values.len ∧ cap = occupied.len
    /// variant cap - distance
    while (distance < cap) {
        mut u64 position = home + distance;
        if (position >= cap) {
            position = position - cap;
        }
        if (occupied[position] == 0) {
            return 0;
        }
        if (keys[position] == key) {
            return values[position];
        }
        distance = distance + 1;
    }
    return 0;
}

fn perf_linear_probe_u32_entry() -> i32 {
    mut u64 iteration = 0;
    /// invariant iteration ≤ 262144
    /// variant 262144 - iteration
    while (iteration < 262144) {
        mut [u32] keys = alloc_array<u32>(8, 0);
        mut [u32] values = alloc_array<u32>(8, 0);
        mut [u32] occupied = alloc_array<u32>(8, 0);
        u32 first = perf_map_insert(&mut keys, &mut values, &mut occupied, 8, 1, 100);
        u32 second = perf_map_insert(&mut keys, &mut values, &mut occupied, 8, 9, 900);
        u32 third = perf_map_insert(&mut keys, &mut values, &mut occupied, 8, 17, 1700);
        u32 overwrite = perf_map_insert(&mut keys, &mut values, &mut occupied, 8, 9, 901);
        u32 found = perf_map_get(&keys, &values, &occupied, 8, 9);
        u32 collision = perf_map_get(&keys, &values, &occupied, 8, 17);
        u32 missing = perf_map_get(&keys, &values, &occupied, 8, 25);
        if (first != 2 || second != 2 || third != 2 || overwrite != 1 || found != 901 || collision != 1700 || missing != 0) {
            return 1;
        }
        iteration = iteration + 1;
    }
    return 42;
}
