// Native benchmark slice: the full verified-workload merge algorithm over the
// backend's admitted u32 array representation. The canonical i32 workload
// remains closure-only.

/// pre output.len = left.len + right.len
fn perf_merge_u32(&[u32] left, &[u32] right, &mut [u32] output) {
    u64 left_count = left.len;
    u64 right_count = right.len;
    mut u64 left_index = 0;
    mut u64 right_index = 0;
    mut u64 output_index = 0;
    /// invariant left_index ≤ left_count
    /// invariant right_index ≤ right_count
    /// invariant output_index = left_index + right_index
    /// invariant output.len = left_count + right_count
    /// variant (left_count - left_index) + (right_count - right_index)
    while (left_index < left_count && right_index < right_count) {
        if (left[left_index] <= right[right_index]) {
            output[output_index] = left[left_index];
            left_index = left_index + 1;
        } else {
            output[output_index] = right[right_index];
            right_index = right_index + 1;
        }
        output_index = output_index + 1;
    }
    /// invariant left_index ≤ left_count
    /// invariant left_index < left_count → right_index = right_count
    /// invariant output_index = left_index + right_index
    /// invariant output.len = left_count + right_count
    /// variant left_count - left_index
    while (left_index < left_count) {
        output[output_index] = left[left_index];
        left_index = left_index + 1;
        output_index = output_index + 1;
    }
    /// invariant right_index ≤ right_count
    /// invariant right_index < right_count → left_index = left_count
    /// invariant output_index = left_index + right_index
    /// invariant output.len = left_count + right_count
    /// variant right_count - right_index
    while (right_index < right_count) {
        output[output_index] = right[right_index];
        right_index = right_index + 1;
        output_index = output_index + 1;
    }
}

fn perf_merge_u32_entry() -> i32 {
    mut u64 iteration = 0;
    /// invariant iteration ≤ 262144
    /// variant 262144 - iteration
    while (iteration < 262144) {
        [u32] left = [1, 3, 5, 7];
        [u32] right = [2, 3, 6];
        mut [u32] output = alloc_array<u32>(7, 0);
        perf_merge_u32(&left, &right, &mut output);
        if (output[0] != 1 || output[1] != 2 || output[2] != 3 || output[3] != 3 || output[4] != 5 || output[5] != 6 || output[6] != 7) {
            return 1;
        }
        iteration = iteration + 1;
    }
    return 42;
}
